{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. 'Destroy not.' A Psalm of Asaph: a Song."]},{"type":"verse","number":1,"content":[{"text":"Unto thee we give thanks, O","poem":1},{"noteId":291},{"text":"God, we give thanks; and thy name is near: thy marvellous works declare it.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"When I shall receive the assembly, I will judge with equity.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The earth and all the inhabitants thereof are dissolved: I have established its pillars. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I said unto the boastful, Boast not; and to the wicked, Lift not up the horn:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lift not up your horn on high; speak not arrogantly with a [stiff] neck.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For not from the east nor from the west, nor yet from the south doth exaltation [come]:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For","poem":1},{"noteId":292},{"text":"God is the judge; he putteth down one and exalteth another.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For in the hand of Jehovah there is a cup, and it foameth with wine, it is full of mixture; and he poureth out of the same; yea, the dregs thereof shall all the wicked of the earth drain off, [and] drink.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But as for me, I will declare for ever; I will sing psalms to the","poem":1},{"noteId":293},{"text":"God of Jacob.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"And all the horns of the wicked will I cut off; [but] the horns of the righteous shall be exalted.","poem":1}]}],"footnotes":[{"noteId":291,"caller":"°","text":"75.1 Elohim","reference":{"chapter":75,"verse":1}},{"noteId":292,"caller":"°","text":"75.7 Elohim","reference":{"chapter":75,"verse":7}},{"noteId":293,"caller":"°","text":"75.9 Elohim","reference":{"chapter":75,"verse":9}}]},"thisChapterLink":"/api/eng_dby/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}