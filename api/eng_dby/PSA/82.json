{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["A Psalm of Asaph."]},{"type":"verse","number":1,"content":[{"noteId":337},{"text":"God standeth in the assembly of","poem":1},{"noteId":338},{"text":"God, he judgeth among the","poem":1},{"noteId":339},{"text":"gods.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will ye judge unrighteously, and accept the person of the wicked? Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judge the poor and the fatherless, do justice to the afflicted and the destitute;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescue the poor and needy, deliver them out of the hand of the wicked.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They know not, neither do they understand; they walk on in darkness: all the foundations of the earth are moved.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said, Ye are","poem":1},{"noteId":340},{"text":"gods, and all of you are children of the Most High;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But ye shall die like men, and fall like one of the princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O","poem":1},{"noteId":341},{"text":"God, judge the earth; for thou shalt inherit all the nations.","poem":1}]}],"footnotes":[{"noteId":337,"caller":"°","text":"82.1 Elohim|strong=\"H0430\"","reference":{"chapter":82,"verse":1}},{"noteId":338,"caller":"*","text":"82.1 El|strong=\"H0410\"","reference":{"chapter":82,"verse":1}},{"noteId":339,"caller":"°","text":"82.1 Elohim|strong=\"H0430\"","reference":{"chapter":82,"verse":1}},{"noteId":340,"caller":"°","text":"82.6 Elohim|strong=\"H0430\"","reference":{"chapter":82,"verse":6}},{"noteId":341,"caller":"°","text":"82.8 Elohim|strong=\"H0430\"","reference":{"chapter":82,"verse":8}}]},"thisChapterLink":"/api/eng_dby/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}