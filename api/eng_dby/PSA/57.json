{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. 'Destroy not.' Of David. Michtam; when he fled from Saul in the cave."]},{"type":"verse","number":1,"content":[{"text":"Be gracious unto me, O","poem":1},{"noteId":172},{"text":"God, be gracious unto me; for my soul taketh refuge in thee: yea, in the shadow of thy wings do I take refuge, until the calamities be overpast.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will call unto","poem":1},{"noteId":173},{"text":"God, the Most High; unto","poem":1},{"noteId":174},{"text":"God that performeth [all] for me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He will send from the heavens and save me; he hath covered with reproach him that would swallow me up. Selah.","poem":1},{"noteId":175},{"text":"God hath sent forth his loving-kindness and his truth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"My soul is in the midst of lions; I lie down [among] them that breathe out flames, the sons of men, whose teeth are spears and arrows, and their tongue a sharp sword.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be exalted above the heavens, O","poem":1},{"noteId":176},{"text":"God; let thy glory be above all the earth!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They have prepared a net for my steps; my soul was bowed down: they have digged a pit before me; they are fallen into the midst thereof. Selah.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"My heart is fixed, O","poem":1},{"noteId":177},{"text":"God, my heart is fixed: I will sing, yea, I will sing psalms.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Awake, my glory; awake, lute and harp: I will wake the dawn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will give thee thanks among the peoples, O Lord; of thee will I sing psalms among the nations:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For thy loving-kindness is great unto the heavens, and thy truth unto the clouds.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Be exalted above the heavens, O","poem":1},{"noteId":178},{"text":"God; let thy glory be above all the earth!","poem":1}]}],"footnotes":[{"noteId":172,"caller":"°","text":"57.1 Elohim","reference":{"chapter":57,"verse":1}},{"noteId":173,"caller":"°","text":"57.2 Elohim|strong=\"H0430\"","reference":{"chapter":57,"verse":2}},{"noteId":174,"caller":"*","text":"57.2 El","reference":{"chapter":57,"verse":2}},{"noteId":175,"caller":"°","text":"57.3 Elohim|strong=\"H0430\"","reference":{"chapter":57,"verse":3}},{"noteId":176,"caller":"°","text":"57.5 Elohim","reference":{"chapter":57,"verse":5}},{"noteId":177,"caller":"°","text":"57.7 Elohim","reference":{"chapter":57,"verse":7}},{"noteId":178,"caller":"°","text":"57.11 Elohim","reference":{"chapter":57,"verse":11}}]},"thisChapterLink":"/api/eng_dby/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}