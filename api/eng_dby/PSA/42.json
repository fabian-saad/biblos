{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. An instruction; of the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"As the hart panteth after the water-brooks, so panteth my soul after thee, O","poem":1},{"noteId":67},{"text":"God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My soul thirsteth for","poem":1},{"noteId":68},{"text":"God, for the living","poem":1},{"noteId":69},{"text":"God: when shall I come and appear before","poem":1},{"noteId":70},{"text":"God?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"My tears have been my bread day and night, while they say unto me all the day, Where is thy","poem":1},{"noteId":71},{"text":"God?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"These things I remember and have poured out my soul within me: how I passed along with the multitude, how I went on with them to the house of","poem":1},{"noteId":72},{"text":"God, with the voice of joy and praise, a festive multitude.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why art thou cast down, my soul, and art disquieted in me? hope in","poem":1},{"noteId":73},{"text":"God; for I shall yet praise him, [for] the health of his countenance.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My","poem":1},{"noteId":74},{"text":"God, my soul is cast down within me; therefore do I remember thee from the land of the Jordan, and the Hermons, from mount Mizar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Deep calleth unto deep at the noise of thy cataracts; all thy breakers and thy billows are gone over me.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"In the day-time will Jehovah command his loving-kindness, and in the night his song shall be with me, a prayer unto the","poem":1},{"noteId":75},{"text":"God of my life.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will say unto","poem":1},{"noteId":76},{"text":"God my rock, Why hast thou forgotten me? why go I mourning because of the oppression of the enemy?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"As with a crushing in my bones mine adversaries reproach me, while they say unto me all the day, Where is thy","poem":1},{"noteId":77},{"text":"God?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Why art thou cast down, my soul? and why art thou disquieted within me? hope in","poem":1},{"noteId":78},{"text":"God; for I shall yet praise him, [who is] the health of my countenance, and my","poem":1},{"noteId":79},{"text":"God.","poem":1}]}],"footnotes":[{"noteId":67,"caller":"°","text":"42.1 Elohim","reference":{"chapter":42,"verse":1}},{"noteId":68,"caller":"°","text":"42.2 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":2}},{"noteId":69,"caller":"*","text":"42.2 El","reference":{"chapter":42,"verse":2}},{"noteId":70,"caller":"°","text":"42.2 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":2}},{"noteId":71,"caller":"°","text":"42.3 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":3}},{"noteId":72,"caller":"°","text":"42.4 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":4}},{"noteId":73,"caller":"°","text":"42.5 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":5}},{"noteId":74,"caller":"°","text":"42.6 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":6}},{"noteId":75,"caller":"*","text":"42.8 El","reference":{"chapter":42,"verse":8}},{"noteId":76,"caller":"*","text":"42.9 El|strong=\"H0410\"","reference":{"chapter":42,"verse":9}},{"noteId":77,"caller":"°","text":"42.10 Elohim","reference":{"chapter":42,"verse":10}},{"noteId":78,"caller":"°","text":"42.11 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":11}},{"noteId":79,"caller":"°","text":"42.11 Elohim|strong=\"H0430\"","reference":{"chapter":42,"verse":11}}]},"thisChapterLink":"/api/eng_dby/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}