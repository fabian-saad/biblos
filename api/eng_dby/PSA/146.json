{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Hallelujah! Praise Jehovah, O my soul.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"As long as I live will I praise Jehovah; I will sing psalms unto my","poem":1},{"noteId":435},{"text":"God while I have my being.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Put not confidence in nobles, in a son of man, in whom there is no salvation.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His breath goeth forth, he returneth to his earth; in that very day his purposes perish.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is he who hath the","poem":1},{"noteId":436},{"text":"God of Jacob for his help, whose hope is in Jehovah his","poem":1},{"noteId":437},{"text":"God,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who made the heavens and the earth, the sea and all that is therein; who keepeth truth for ever;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Who executeth judgment for the oppressed, who giveth bread to the hungry. Jehovah looseth the prisoners;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jehovah openeth [the eyes of] the blind; Jehovah raiseth up them that are bowed down; Jehovah loveth the righteous;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jehovah preserveth the strangers; he lifteth up the fatherless and the widow; but the way of the wicked doth he subvert.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jehovah will reign for ever, [even] thy","poem":1},{"noteId":438},{"text":"God, O Zion, from generation to generation. Hallelujah!","poem":1}]}],"footnotes":[{"noteId":435,"caller":"°","text":"146.2 Elohim|strong=\"H0430\"","reference":{"chapter":146,"verse":2}},{"noteId":436,"caller":"*","text":"146.5 El|strong=\"H0410\"","reference":{"chapter":146,"verse":5}},{"noteId":437,"caller":"°","text":"146.5 Elohim|strong=\"H0430\"","reference":{"chapter":146,"verse":5}},{"noteId":438,"caller":"°","text":"146.10 Elohim|strong=\"H0430\"","reference":{"chapter":146,"verse":10}}]},"thisChapterLink":"/api/eng_dby/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}