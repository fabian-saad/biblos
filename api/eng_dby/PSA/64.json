{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Hear, O","poem":1},{"noteId":208},{"text":"God, my voice in my plaint; preserve my life from fear of the enemy:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hide me from the secret counsel of evil-doers, from the tumultuous crowd of the workers of iniquity,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who have sharpened their tongue like a sword, [and] have aimed their arrow, a bitter word;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"That they may shoot in secret at the perfect: suddenly do they shoot at him, and fear not.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They encourage themselves in an evil matter, they concert to hide snares; they say, Who will see them?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They devise iniquities: We have it ready, the plan is diligently sought out. And each one's inward [thought] and heart is deep.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But","poem":1},{"noteId":209},{"text":"God will shoot an arrow at them: suddenly are they wounded;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"By their own tongue they are made to fall over one another: all that see them shall flee away.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"And all men shall fear, and shall declare","poem":1},{"noteId":210},{"text":"God's doing; and they shall wisely consider his work.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The righteous shall rejoice in Jehovah, and trust in him; and all the upright in heart shall glory.","poem":1}]}],"footnotes":[{"noteId":208,"caller":"°","text":"64.1 Elohim","reference":{"chapter":64,"verse":1}},{"noteId":209,"caller":"°","text":"64.7 Elohim","reference":{"chapter":64,"verse":7}},{"noteId":210,"caller":"°","text":"64.9 Elohim","reference":{"chapter":64,"verse":9}}]},"thisChapterLink":"/api/eng_dby/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}