{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Hallelujah! Praise, ye servants of Jehovah, praise the name of Jehovah.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Blessed be the name of Jehovah, from this time forth and for evermore!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the rising of the sun unto the going down of the same, let Jehovah's name be praised.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jehovah is high above all nations, his glory above the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who is like unto Jehovah our","poem":1},{"noteId":410},{"text":"God, who hath placed his dwelling on high;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who humbleth himself to look on the heavens and on the earth?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He raiseth up the poor out of the dust; from the dung-hill he lifteth up the needy,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To set [him] among nobles, among the nobles of his people.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He maketh the barren woman to keep house, [as] a joyful mother of sons. Hallelujah!","poem":1}]}],"footnotes":[{"noteId":410,"caller":"°","text":"113.5 Elohim|strong=\"H0430\"","reference":{"chapter":113,"verse":5}}]},"thisChapterLink":"/api/eng_dby/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}