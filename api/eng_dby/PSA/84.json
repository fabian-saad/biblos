{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. Upon the Gittith. Of the sons of Korah. A Psalm."]},{"type":"verse","number":1,"content":[{"text":"How amiable are thy tabernacles, O Jehovah of hosts!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My soul longeth, yea, even fainteth for the courts of Jehovah; my heart and my flesh cry out for the living","poem":1},{"noteId":346},{"text":"God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yea, the sparrow hath found a house, and the swallow a nest for herself, where she layeth her young, thine altars, O Jehovah of hosts, my King and my","poem":1},{"noteId":347},{"text":"God.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Blessed are they that dwell in thy house: they will be constantly praising thee. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blessed is the man whose strength is in thee, — they, in whose heart are the highways.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Passing through the valley of Baca, they make it a well-spring; yea, the early rain covereth it with blessings.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"They go from strength to strength: [each one] will appear before","poem":1},{"noteId":348},{"text":"God in Zion.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jehovah,","poem":1},{"noteId":349},{"text":"God of hosts, hear my prayer; give ear, O","poem":1},{"noteId":350},{"text":"God of Jacob. Selah.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Behold, O","poem":1},{"noteId":351},{"text":"God our shield, and look upon the face of thine anointed.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For a day in thy courts is better than a thousand. I had rather stand at the threshold of the house of my","poem":1},{"noteId":352},{"text":"God, than dwell in the tents of wickedness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"For Jehovah Elohim is a sun and shield: Jehovah will give grace and glory; no good thing will he withhold from them that walk uprightly.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Jehovah of hosts, blessed is the man that confideth in thee!","poem":1}]}],"footnotes":[{"noteId":346,"caller":"*","text":"84.2 El","reference":{"chapter":84,"verse":2}},{"noteId":347,"caller":"°","text":"84.3 Elohim","reference":{"chapter":84,"verse":3}},{"noteId":348,"caller":"°","text":"84.7 Elohim","reference":{"chapter":84,"verse":7}},{"noteId":349,"caller":"°","text":"84.8 Elohim|strong=\"H0430\"","reference":{"chapter":84,"verse":8}},{"noteId":350,"caller":"°","text":"84.8 Elohim|strong=\"H0430\"","reference":{"chapter":84,"verse":8}},{"noteId":351,"caller":"°","text":"84.9 Elohim|strong=\"H0430\"","reference":{"chapter":84,"verse":9}},{"noteId":352,"caller":"°","text":"84.10 Elohim|strong=\"H0430\"","reference":{"chapter":84,"verse":10}}]},"thisChapterLink":"/api/eng_dby/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}