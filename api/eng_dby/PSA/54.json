,{"text":"He will requite evil to mine enemies: in thy truth cut them off.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will freely sacrifice unto thee; I will praise thy name, O Jehovah, because it is good.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he hath delivered me out of all trouble; and mine eye hath seen [its desire] upon mine enemies.","poem":1}]}],"footnotes":[{"noteId":153,"caller":"°","text":"54.1 Elohim","reference":{"chapter":54,"verse":1}},{"noteId":154,"caller":"°","text":"54.2 Elohim","reference":{"chapter":54,"verse":2}},{"noteId":155,"caller":"°","text":"54.3 Elohim|strong=\"H0430\"","reference":{"chapter":54,"verse":3}},{"noteId":156,"caller":"°","text":"54.4 Elohim|strong=\"H0430\"","reference":{"chapter":54,"verse":4}}]},"thisChapterLink":"/api/eng_dby/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}