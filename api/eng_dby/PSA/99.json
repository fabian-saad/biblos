{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Jehovah reigneth: let the peoples tremble. He sitteth [between the] cherubim: let the earth be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jehovah is great in Zion, and he is high above all the peoples.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"They shall praise thy great and terrible name, — it is holy! —","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And the strength of the king that loveth justice. Thou hast established equity: it is thou that executest judgment and righteousness in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt Jehovah our","poem":1},{"noteId":386},{"text":"God, and worship at his footstool. He is holy!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moses and Aaron among his priests, and Samuel among them that call upon his name: they called unto Jehovah, and he answered them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spoke unto them in the pillar of cloud: they kept his testimonies, and the statute that he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jehovah, our","poem":1},{"noteId":387},{"text":"God, thou answeredst them: a forgiving","poem":1},{"noteId":388},{"text":"God wast thou unto them, though thou tookest vengeance of their doings.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt Jehovah our","poem":1},{"noteId":389},{"text":"God, and worship at the hill of his holiness; for holy is Jehovah our","poem":1},{"noteId":390},{"text":"God.","poem":1}]}],"footnotes":[{"noteId":386,"caller":"°","text":"99.5 Elohim|strong=\"H0430\"","reference":{"chapter":99,"verse":5}},{"noteId":387,"caller":"°","text":"99.8 Elohim|strong=\"H0430\"","reference":{"chapter":99,"verse":8}},{"noteId":388,"caller":"*","text":"99.8 El|strong=\"H0410\"","reference":{"chapter":99,"verse":8}},{"noteId":389,"caller":"°","text":"99.9 Elohim|strong=\"H0430\"","reference":{"chapter":99,"verse":9}},{"noteId":390,"caller":"°","text":"99.9 Elohim|strong=\"H0430\"","reference":{"chapter":99,"verse":9}}]},"thisChapterLink":"/api/eng_dby/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}