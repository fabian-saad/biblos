{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. On Mahalath: an instruction. Of David."]},{"type":"verse","number":1,"content":[{"text":"The fool hath said in his heart, There is no","poem":1},{"noteId":146},{"text":"God! They have corrupted themselves, and have done abominable iniquity: there is none that doeth good.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"noteId":147},{"text":"God looked down from the heavens upon the children of men, to see if there were any that did understand, that did seek","poem":1},{"noteId":148},{"text":"God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Every one of them is gone back, they are together become corrupt: there is none that doeth good, not even one.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Have the workers of iniquity no knowledge, eating up my people [as] they eat bread? they call not upon","poem":1},{"noteId":149},{"text":"God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"There were they in great fear, where no fear was; for","poem":1},{"noteId":150},{"text":"God scattereth the bones of him that encampeth against thee. Thou hast put [them] to shame, for","poem":1},{"noteId":151},{"text":"God hath despised them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oh that the salvation of Israel were come out of Zion! When","poem":1},{"noteId":152},{"text":"God turneth again the captivity of his people, Jacob shall be glad, Israel shall rejoice.","poem":1}]}],"footnotes":[{"noteId":146,"caller":"°","text":"53.1 Elohim","reference":{"chapter":53,"verse":1}},{"noteId":147,"caller":"°","text":"53.2 Elohim|strong=\"H0430\"","reference":{"chapter":53,"verse":2}},{"noteId":148,"caller":"°","text":"53.2 Elohim|strong=\"H0430\"","reference":{"chapter":53,"verse":2}},{"noteId":149,"caller":"°","text":"53.4 Elohim","reference":{"chapter":53,"verse":4}},{"noteId":150,"caller":"°","text":"53.5 Elohim|strong=\"H0430\"","reference":{"chapter":53,"verse":5}},{"noteId":151,"caller":"°","text":"53.5 Elohim|strong=\"H0430\"","reference":{"chapter":53,"verse":5}},{"noteId":152,"caller":"°","text":"53.6 Elohim|strong=\"H0430\"","reference":{"chapter":53,"verse":6}}]},"thisChapterLink":"/api/eng_dby/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}