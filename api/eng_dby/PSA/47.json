{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. Of the sons of Korah. A Psalm."]},{"type":"verse","number":1,"content":[{"text":"All ye peoples, clap your hands; shout unto","poem":1},{"noteId":105},{"text":"God with the voice of triumph!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For Jehovah, the Most High, is terrible, a great king over all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He subdueth the peoples under us, and the nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He hath chosen our inheritance for us, the excellency of Jacob whom he loved. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"noteId":106},{"text":"God is gone up amid shouting, Jehovah amid the sound of the trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing psalms of","poem":1},{"noteId":107},{"text":"God, sing psalms; sing psalms unto our King, sing psalms!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For","poem":1},{"noteId":108},{"text":"God is the King of all the earth; sing psalms with understanding.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"noteId":109},{"text":"God reigneth over the nations;","poem":1},{"noteId":110},{"text":"God sitteth upon the throne of his holiness.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The willing-hearted of the peoples have gathered together, [with] the people of the","poem":1},{"noteId":111},{"text":"God of Abraham. For unto","poem":1},{"noteId":112},{"text":"God [belong] the shields of the earth: he is greatly exalted.","poem":1}]}],"footnotes":[{"noteId":105,"caller":"°","text":"47.1 Elohim","reference":{"chapter":47,"verse":1}},{"noteId":106,"caller":"°","text":"47.5 Elohim","reference":{"chapter":47,"verse":5}},{"noteId":107,"caller":"°","text":"47.6 Elohim|strong=\"H0430\"","reference":{"chapter":47,"verse":6}},{"noteId":108,"caller":"°","text":"47.7 Elohim|strong=\"H0430\"","reference":{"chapter":47,"verse":7}},{"noteId":109,"caller":"°","text":"47.8 Elohim|strong=\"H0430\"","reference":{"chapter":47,"verse":8}},{"noteId":110,"caller":"°","text":"47.8 Elohim|strong=\"H0430\"","reference":{"chapter":47,"verse":8}},{"noteId":111,"caller":"°","text":"47.9 Elohim|strong=\"H0430\"","reference":{"chapter":47,"verse":9}},{"noteId":112,"caller":"°","text":"47.9 Elohim|strong=\"H0430\"","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/eng_dby/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}