o me, O","poem":1},{"noteId":269},{"text":"God. Thou art my help and my deliverer: O Jehovah, make no delay.","poem":1}]}],"footnotes":[{"noteId":267,"caller":"°","text":"70.1 Elohim","reference":{"chapter":70,"verse":1}},{"noteId":268,"caller":"°","text":"70.4 Elohim","reference":{"chapter":70,"verse":4}},{"noteId":269,"caller":"°","text":"70.5 Elohim|strong=\"H0430\"","reference":{"chapter":70,"verse":5}}]},"thisChapterLink":"/api/eng_dby/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}