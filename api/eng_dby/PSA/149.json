{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Hallelujah! Sing unto Jehovah a new song; [sing] his praise in the congregation of the","poem":1},{"noteId":442},{"text":"godly.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in his Maker; let the sons of Zion be joyful in their King.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in the dance; let them sing psalms unto him with the tambour and harp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For Jehovah taketh pleasure in his people; he beautifieth the meek with salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the","poem":1},{"noteId":443},{"text":"godly exult in glory; let them shout for joy upon their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let the high praises of","poem":1},{"noteId":444},{"text":"God be in their mouth, and a two-edged sword in their hand:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance against the nations, [and] punishment among the peoples;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their kings with chains, and their nobles with fetters of iron;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute upon them the judgment written. This honour have all his saints. Hallelujah!","poem":1}]}],"footnotes":[{"noteId":442,"caller":"°","text":"149.1 Elohim","reference":{"chapter":149,"verse":1}},{"noteId":443,"caller":"°","text":"149.5 Elohim","reference":{"chapter":149,"verse":5}},{"noteId":444,"caller":"*","text":"149.6 El|strong=\"H0410\"","reference":{"chapter":149,"verse":6}}]},"thisChapterLink":"/api/eng_dby/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}