{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David; when he was in the wilderness of Judah."]},{"type":"verse","number":1,"content":[{"text":"O","poem":1},{"noteId":205},{"text":"God, thou art my","poem":1},{"noteId":206},{"text":"God; early will I seek thee. My soul thirsteth for thee, my flesh languisheth for thee, in a dry and weary land without water:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"To see thy power and thy glory, as I have beheld thee in the sanctuary;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thy loving-kindness is better than life: my lips shall praise thee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"So will I bless thee while I live; I will lift up my hands in thy name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My soul is satisfied as with marrow and fatness, and my mouth shall praise [thee] with joyful lips.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"When I remember thee upon my bed, I meditate on thee in the night-watches:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For thou hast been my help, and in the shadow of thy wings will I sing for joy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My soul followeth hard after thee: thy right hand upholdeth me.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But those that seek my soul, to destroy [it], shall go into the lower parts of the earth;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"They shall be given over to the power of the sword; they shall be the portion of foxes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But the king shall rejoice in","poem":1},{"noteId":207},{"text":"God; every one that sweareth by him shall glory: for the mouth of them that speak lies shall be stopped.","poem":1}]}],"footnotes":[{"noteId":205,"caller":"°","text":"63.1 Elohim","reference":{"chapter":63,"verse":1}},{"noteId":206,"caller":"*","text":"63.1 El","reference":{"chapter":63,"verse":1}},{"noteId":207,"caller":"°","text":"63.11 Elohim","reference":{"chapter":63,"verse":11}}]},"thisChapterLink":"/api/eng_dby/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}