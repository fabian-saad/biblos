{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Jehovah said unto my Lord, Sit at my right hand, until I put thine enemies [as] footstool of thy feet.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jehovah shall send the sceptre of thy might out of Zion: rule in the midst of thine enemies.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy people shall be willing in the day of thy power, in holy splendour: from the womb of the morning [shall come] to thee the dew of thy youth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jehovah hath sworn, and will not repent, Thou art priest for ever after the order of Melchisedek.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord at thy right hand will smite through kings in the day of his anger.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He shall judge among the nations; he shall fill [all places] with dead bodies; he shall smite through the head over a great country.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall drink of the brook in the way; therefore shall he lift up the head.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dby/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}