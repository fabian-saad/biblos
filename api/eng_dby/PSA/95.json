{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Come, let us sing aloud to Jehovah, let us shout for joy to the rock of our salvation;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let us come before his face with thanksgiving; let us shout aloud unto him with psalms.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For Jehovah is a great","poem":1},{"noteId":378},{"text":"God, and a great king above all","poem":1},{"noteId":379},{"text":"gods.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In his hand are the deep places of the earth; the heights of the mountains are his also:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The sea is his, and he made it, and his hands formed the dry [land].","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Come, let us worship and bow down; let us kneel before Jehovah our Maker.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he is our","poem":1},{"noteId":380},{"text":"God; and we are the people of his pasture and the sheep of his hand. To-day if ye hear his voice,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Harden not your heart, as at Meribah, as [in] the day of Massah, in the wilderness;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"When your fathers tempted me, proved me, and saw my work.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Forty years was I grieved with the generation, and said, It is a people that do err in their heart, and they have not known my ways;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"So that I swore in mine anger, that they should not enter into my rest.","poem":1}]}],"footnotes":[{"noteId":378,"caller":"*","text":"95.3 El|strong=\"H0410\"","reference":{"chapter":95,"verse":3}},{"noteId":379,"caller":"°","text":"95.3 Elohim|strong=\"H0430\"","reference":{"chapter":95,"verse":3}},{"noteId":380,"caller":"°","text":"95.7 Elohim|strong=\"H0430\"","reference":{"chapter":95,"verse":7}}]},"thisChapterLink":"/api/eng_dby/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}