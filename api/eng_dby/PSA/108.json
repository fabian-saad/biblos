{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["A Song, a Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"My heart is fixed, O","poem":1},{"noteId":402},{"text":"God: I will sing, yea, I will sing psalms, even [with] my glory.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Awake, lute and harp: I will wake the dawn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will give thee thanks among the peoples, O Jehovah; of thee will I sing psalms among the nations:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For thy loving-kindness is great above the heavens, and thy truth is unto the clouds.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be thou exalted above the heavens, O","poem":1},{"noteId":403},{"text":"God, and thy glory above all the earth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"That thy beloved ones may be delivered: save with thy right hand, and answer me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"noteId":404},{"text":"God hath spoken in his holiness: I will exult, I will divide Shechem, and mete out the valley of Succoth.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gilead is mine, Manasseh is mine, and Ephraim is the strength of my head; Judah is my law-giver;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moab is my wash-pot; upon Edom will I cast my sandal; over Philistia will I shout aloud.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who will bring me into the strong city? who will lead me unto Edom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"[Wilt] not [thou], O","poem":1},{"noteId":405},{"text":"God, who didst cast us off? and didst not go forth, O","poem":1},{"noteId":406},{"text":"God, with our armies?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Give us help from trouble; for vain is man's deliverance.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Through","poem":1},{"noteId":407},{"text":"God we shall do valiantly; and he it is that will tread down our adversaries.","poem":1}]}],"footnotes":[{"noteId":402,"caller":"°","text":"108.1 Elohim","reference":{"chapter":108,"verse":1}},{"noteId":403,"caller":"°","text":"108.5 Elohim","reference":{"chapter":108,"verse":5}},{"noteId":404,"caller":"°","text":"108.7 Elohim","reference":{"chapter":108,"verse":7}},{"noteId":405,"caller":"°","text":"108.11 Elohim","reference":{"chapter":108,"verse":11}},{"noteId":406,"caller":"°","text":"108.11 Elohim","reference":{"chapter":108,"verse":11}},{"noteId":407,"caller":"°","text":"108.13 Elohim","reference":{"chapter":108,"verse":13}}]},"thisChapterLink":"/api/eng_dby/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}