{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. [A Psalm] of David."]},{"type":"verse","number":1,"content":[{"text":"The fool hath said in his heart, There is no","poem":1},{"noteId":19},{"text":"God. They have corrupted themselves, they have done abominable works: there is none that doeth good.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jehovah looked down from the heavens upon the children of men, to see if there were any that did understand, that did seek","poem":1},{"noteId":20},{"text":"God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"They have all gone aside, they are together become corrupt: there is none that doeth good, not even one.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Have all the workers of iniquity no knowledge, eating up my people [as] they eat bread? They call not upon Jehovah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"There were they in great fear; for","poem":1},{"noteId":21},{"text":"God is in the generation of the righteous.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye have shamed the counsel of the afflicted, because Jehovah [was] his refuge.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oh that the salvation of Israel were come out of Zion! When Jehovah turneth again the captivity of his people, Jacob shall be glad, Israel shall rejoice.","poem":1}]}],"footnotes":[{"noteId":19,"caller":"°","text":"14.1 Elohim|strong=\"H0430\"","reference":{"chapter":14,"verse":1}},{"noteId":20,"caller":"°","text":"14.2 Elohim|strong=\"H0430\"","reference":{"chapter":14,"verse":2}},{"noteId":21,"caller":"°","text":"14.5 Elohim|strong=\"H0430\"","reference":{"chapter":14,"verse":5}}]},"thisChapterLink":"/api/eng_dby/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}