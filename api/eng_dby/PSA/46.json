{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. Of the sons of Korah. On Alamoth. A song."]},{"type":"verse","number":1,"content":[{"noteId":98},{"text":"God is our refuge and strength, a help in distresses, very readily found.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Therefore will we not fear though the earth be removed, and though the mountains be carried into the heart of the seas;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Though the waters thereof roar [and] foam, though the mountains shake with the swelling thereof. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"There is a river the streams whereof make glad the city of","poem":1},{"noteId":99},{"text":"God, the sanctuary of the habitations of the Most High.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"noteId":100},{"text":"God is in the midst of her; she shall not be moved:","poem":1},{"noteId":101},{"text":"God shall help her at the dawn of the morning.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The nations raged, the kingdoms were moved; he uttered his voice, the earth melted.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jehovah of hosts is with us; the","poem":1},{"noteId":102},{"text":"God of Jacob is our high fortress. Selah.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Come, behold the works of Jehovah, what desolations he hath made in the earth:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He hath made wars to cease unto the end of the earth; he breaketh the bow, and cutteth the spear in sunder; he burneth the chariots in the fire.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Be still, and know that I am","poem":1},{"noteId":103},{"text":"God: I will be exalted among the nations, I will be exalted in the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jehovah of hosts is with us; the","poem":1},{"noteId":104},{"text":"God of Jacob is our high fortress. Selah.","poem":1}]}],"footnotes":[{"noteId":98,"caller":"°","text":"46.1 Elohim","reference":{"chapter":46,"verse":1}},{"noteId":99,"caller":"°","text":"46.4 Elohim","reference":{"chapter":46,"verse":4}},{"noteId":100,"caller":"°","text":"46.5 Elohim|strong=\"H0430\"","reference":{"chapter":46,"verse":5}},{"noteId":101,"caller":"°","text":"46.5 Elohim|strong=\"H0430\"","reference":{"chapter":46,"verse":5}},{"noteId":102,"caller":"°","text":"46.7 Elohim","reference":{"chapter":46,"verse":7}},{"noteId":103,"caller":"°","text":"46.10 Elohim","reference":{"chapter":46,"verse":10}},{"noteId":104,"caller":"°","text":"46.11 Elohim|strong=\"H0430\"","reference":{"chapter":46,"verse":11}}]},"thisChapterLink":"/api/eng_dby/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}