{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["A Song; a Psalm. Of the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"Great is Jehovah, and greatly to be praised in the city of our","poem":1},{"noteId":113},{"text":"God, in the hill of his holiness.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beautiful in elevation, the joy of the whole earth, is mount Zion, [on] the sides of the north, the city of the great King.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"noteId":114},{"text":"God is known in her palaces as a high fortress.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For behold, the kings assembled themselves, they passed by together;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They saw, — so they marvelled; they were troubled, they fled in consternation:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Trembling took hold upon them there; anguish, as of a woman in travail.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"With an east wind thou hast broken the ships of Tarshish.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"As we have heard, so have we seen, in the city of Jehovah of hosts, in the city of our","poem":1},{"noteId":115},{"text":"God:","poem":1},{"noteId":116},{"text":"God doth establish it for ever. Selah.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"We have thought, O","poem":1},{"noteId":117},{"text":"God, of thy loving-kindness, in the midst of thy temple.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"According to thy name, O","poem":1},{"noteId":118},{"text":"God, so is thy praise unto the ends of the earth: thy right hand is full of righteousness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let mount Zion rejoice, let the daughters of Judah be glad, because of thy judgments.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Walk about Zion, and go round about her: count the towers thereof;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mark ye well her bulwarks, consider her palaces: that ye may tell it to the generation following.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"For this","poem":1},{"noteId":119},{"text":"God is our","poem":1},{"noteId":120},{"text":"God for ever and ever; he will be our guide until death.","poem":1}]}],"footnotes":[{"noteId":113,"caller":"°","text":"48.1 Elohim","reference":{"chapter":48,"verse":1}},{"noteId":114,"caller":"°","text":"48.3 Elohim","reference":{"chapter":48,"verse":3}},{"noteId":115,"caller":"°","text":"48.8 Elohim","reference":{"chapter":48,"verse":8}},{"noteId":116,"caller":"°","text":"48.8 Elohim","reference":{"chapter":48,"verse":8}},{"noteId":117,"caller":"°","text":"48.9 Elohim|strong=\"H0430\"","reference":{"chapter":48,"verse":9}},{"noteId":118,"caller":"°","text":"48.10 Elohim|strong=\"H0430\"","reference":{"chapter":48,"verse":10}},{"noteId":119,"caller":"°","text":"48.14 Elohim","reference":{"chapter":48,"verse":14}},{"noteId":120,"caller":"°","text":"48.14 Elohim","reference":{"chapter":48,"verse":14}}]},"thisChapterLink":"/api/eng_dby/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}