{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Blessed is every one that feareth Jehovah, that walketh in his ways.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For thou shalt eat the labour of thy hands; happy shalt thou be, and it shall be well with thee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy wife shall be as a fruitful vine in the inner part of thy house; thy children like olive-plants round about thy table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Behold, thus shall the man be blessed that feareth Jehovah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jehovah will bless thee out of Zion; and mayest thou see the good of Jerusalem all the days of thy life,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"And see thy children's children. Peace