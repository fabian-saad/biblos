{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Jehovah, who shall sojourn in thy tent? who shall dwell in the hill of thy holiness?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He that walketh uprightly, and worketh righteousness, and speaketh the truth from his heart.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"[He that] slandereth not with his tongue, doeth not evil to his companion, nor taketh up a reproach against his neighbour;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In whose eyes the depraved person is contemned, and who honoureth them that fear Jehovah; who, if he have sworn to his own hurt, changeth it not;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"[He that] putteth not out his money to usury, nor taketh reward against the innocent. He that doeth these [things] shall never be moved.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dby/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}