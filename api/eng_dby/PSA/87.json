{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Of the sons of Korah. A Psalm. A Song."]},{"type":"verse","number":1,"content":[{"text":"His foundation is in the mountains of holiness.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jehovah loveth the gates of Zion more than all the habitations of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glorious things are spoken of thee, O city of","poem":1},{"noteId":363},{"text":"God. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will make mention of Rahab and Babylon among them that know me; behold Philistia, and Tyre, with Ethiopia: this [man] was born there.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"And of Zion it shall be said, This one and that one was born in her; and the Most High himself shall establish her.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jehovah will count, when he inscribeth the peoples, This [man] was born there. Selah.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"As well the singers as the dancers [shall say], All my springs are in thee.","poem":1}]}],"footnotes":[{"noteId":363,"caller":"°","text":"87.3 Elohim|strong=\"H0430\"","reference":{"chapter":87,"verse":3}}]},"thisChapterLink":"/api/eng_dby/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}