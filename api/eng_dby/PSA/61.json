{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician. On a stringed instrument. [A Psalm] of David."]},{"type":"verse","number":1,"content":[{"text":"Hear, O","poem":1},{"noteId":195},{"text":"God, my cry; attend unto my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"From the end of the earth will I call unto thee, when my heart is overwhelmed: thou wilt lead me on to a rock which is too high for me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thou hast been a refuge for me, a strong tower from before the enemy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will sojourn in thy tent for ever; I will take refuge in the covert of thy wings. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For thou, O","poem":1},{"noteId":196},{"text":"God, hast heard my vows; thou hast given [me] the inheritance of those that fear thy name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou wilt add days to the days of the king: his years shall be as many generations.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall abide before","poem":1},{"noteId":197},{"text":"God for ever: bestow loving-kindness and truth, that they may preserve him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"So will I sing forth thy name for ever, performing my vows from day to day.","poem":1}]}],"footnotes":[{"noteId":195,"caller":"°","text":"61.1 Elohim","reference":{"chapter":61,"verse":1}},{"noteId":196,"caller":"°","text":"61.5 Elohim","reference":{"chapter":61,"verse":5}},{"noteId":197,"caller":"°","text":"61.7 Elohim","reference":{"chapter":61,"verse":7}}]},"thisChapterLink":"/api/eng_dby/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}