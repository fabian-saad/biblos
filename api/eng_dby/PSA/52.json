{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician: an instruction. Of David; when Doeg the Edomite came and told Saul, and said unto him, David came to the house of Ahimelech."]},{"type":"verse","number":1,"content":[{"text":"Why boastest thou thyself in evil, thou mighty man? The loving-kindness of","poem":1},{"noteId":140},{"text":"God [abideth] continually.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thy tongue deviseth mischievous things, like a sharp razor, practising deceit.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thou hast loved evil rather than good, lying rather than to speak righteousness. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Thou hast loved all devouring words, O deceitful tongue!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"noteId":141},{"text":"God shall likewise destroy thee for ever; he shall take thee away, and pluck thee out of [thy] tent, and root thee out of the land of the living. Selah.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The righteous also shall see, and fear, and shall laugh at him, [saying,]","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Behold the man that made not","poem":1},{"noteId":142},{"text":"God his strength, but put confidence in the abundance of his riches, [and] strengthened himself in his avarice.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"But as for me, I am like a green olive-tree in the house of","poem":1},{"noteId":143},{"text":"God: I will confide in the loving-kindness of","poem":1},{"noteId":144},{"text":"God for ever and ever.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will praise thee for ever, because thou hast done [it]; and I will wait on thy name, before thy","poem":1},{"noteId":145},{"text":"godly ones, for it is good.","poem":1}]}],"footnotes":[{"noteId":140,"caller":"*","text":"52.1 El","reference":{"chapter":52,"verse":1}},{"noteId":141,"caller":"*","text":"52.5 El","reference":{"chapter":52,"verse":5}},{"noteId":142,"caller":"°","text":"52.7 Elohim","reference":{"chapter":52,"verse":7}},{"noteId":143,"caller":"°","text":"52.8 Elohim","reference":{"chapter":52,"verse":8}},{"noteId":144,"caller":"°","text":"52.8 Elohim","reference":{"chapter":52,"verse":8}},{"noteId":145,"caller":"°","text":"52.9 Elohim|strong=\"H0430\"","reference":{"chapter":52,"verse":9}}]},"thisChapterLink":"/api/eng_dby/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}