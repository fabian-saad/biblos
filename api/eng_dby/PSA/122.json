{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees. Of David."]},{"type":"verse","number":1,"content":[{"text":"I rejoiced when they said unto me, Let us go into the house of Jehovah.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet shall stand within thy gates, O Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem, which art built as a city that is compact together,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Whither the tribes go up, the tribes of Jah, a testimony to Israel, to give thanks unto the name of Jehovah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For there are set thrones for judgment, the thrones of the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pray for the peace of Jerusalem: they shall prosper that love thee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Peace be within thy bulwarks, prosperity within thy palaces.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For my brethren and companions' sakes I will say, Peace be within thee!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Because of the house of Jehovah our","poem":1},{"noteId":419},{"text":"God I will seek thy good.","poem":1}]}],"footnotes":[{"noteId":419,"caller":"°","text":"122.9 Elohim|strong=\"H0430\"","reference":{"chapter":122,"verse":9}}]},"thisChapterLink":"/api/eng_dby/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}