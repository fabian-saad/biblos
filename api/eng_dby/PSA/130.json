{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Out of the depths do I call upon thee, Jehovah.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, hear my voice; let thine ears be attentive to the voice of my supplication.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If thou, Jah, shouldest mark iniquities, Lord, who shall stand?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But there is forgiveness with thee, that thou mayest be feared.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I wait for Jehovah; my soul doth wait, and in his word do I hope.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul [waiteth] for the Lord more than the watchers [wait] for the morning, [more than] the watchers for the morning.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let Israel hope in Jehovah, because with Jehovah there is loving-kindness, and with him is plenteous redemption;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And he will redeem Israel from all his iniquities.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dby/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}