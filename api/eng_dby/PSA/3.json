{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"Jehovah, how many are they that trouble me, many they that rise up against me!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many say of my soul, There is no salvation for him in","poem":1},{"noteId":0},{"text":"God. Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But thou, Jehovah, art a shield about me; my glory, and the lifter up of my head.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"With my voice will I call to Jehovah, and he will answer me from the hill of his holiness. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I laid me down and slept; I awaked, for Jehovah sustaineth me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will not fear for myriads of the people that have set themselves against me round about.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arise, Jehovah; save me, my","poem":1},{"noteId":1},{"text":"God! For thou hast smitten all mine enemies upon the cheekbone, thou hast broken the teeth of the wicked.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Salvation is of Jehovah; thy blessing is upon thy people. Selah.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"°","text":"3.2 Elohim","reference":{"chapter":3,"verse":2}},{"noteId":1,"caller":"°","text":"3.7 Elohim","reference":{"chapter":3,"verse":7}}]},"thisChapterLink":"/api/eng_dby/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}