{"translation":{"id":"eng_dby","name":"Darby Translation","website":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engDBY","licenseNotes":null,"shortName":"DBY","englishName":"Darby Translation","language":"eng","textDirection":"ltr","sha256":"4ed2f894f02c06b40bae7cc6bf97c4c05f871c859eba60f40fcdd7a07b28f812","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_dby/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_dby","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"cf6ac40503fd9a0a67cec7ef8afde8551aebb44c12de9d7226bbc056929c8ad2","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_dby/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_dby/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"Many a time have they afflicted me from my youth — oh let Israel say —","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many a time have they afflicted me from my youth; yet they have not prevailed against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The ploughers ploughed upon my back; they made long their furrows.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jehovah is righteous: he hath cut asunder the cords of the wicked.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let them be ashamed and turned backward, all that hate Zion;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as the grass upon the house-tops, which withereth before it is plucked up,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wherewith the mower filleth not his hand, nor he that bindeth sheaves his bosom;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neither do the passers-by say, The blessing of Jehovah be upon you; we bless you in the name of Jehovah!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_dby/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_dby/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_dby/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}