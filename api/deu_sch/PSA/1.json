ks":{},"nextChapterApiLink":"/api/deu_sch/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}