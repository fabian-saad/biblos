{"translation":{"id":"deu_sch","name":"Die Schlachter-Bibel 1951","website":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseNotes":null,"shortName":"SCH","englishName":"German Schlachter Bible 1951","language":"deu","textDirection":"ltr","sha256":"ea3d7f727d83f2d95bb3889747635a603339f569106db9743bb9e70d42148c3c","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_sch/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_sch","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"01123cc0fd02a41980f8e32eb5a1eea6cefff316f6c4922edd3ace2c65738771","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_sch/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_sch/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":["Ein Wallfahrtslied. Von David. Wenn der HERR nicht für uns gewesen wäre (so sage Israel),"]},{"type":"verse","number":2,"content":["wenn der HERR nicht für uns gewesen wäre, als die Menschen wider uns auftraten,"]},{"type":"verse","number":3,"content":["so hätten sie uns lebendig verschlungen, als ihr Zorn gegen uns entbrannte;"]},{"type":"verse","number":4,"content":["dann hätten die Wasser uns überschwemmt, ein Strom wäre über unsre Seele gegangen;"]},{"type":"verse","number":5,"content":["dann hätten die stolzen Wasser unsre Seele überflutet!"]},{"type":"verse","number":6,"content":["Gepriesen sei der HERR, der uns ihren Zähnen nicht zur Beute gab!"]},{"type":"verse","number":7,"content":["Unsre Seele ist entronnen wie ein Vögelein der Schlinge des Vogelstellers; die Schlinge ist zerrissen, und wir sind entronnen!"]},{"type":"verse","number":8,"content":["Unsre Hilfe steht im Namen des HERRN, der Himmel und Erde gemacht hat."]}],"footnotes":[]},"thisChapterLink":"/api/deu_sch/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_sch/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}