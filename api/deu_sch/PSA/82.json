{"translation":{"id":"deu_sch","name":"Die Schlachter-Bibel 1951","website":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseNotes":null,"shortName":"SCH","englishName":"German Schlachter Bible 1951","language":"deu","textDirection":"ltr","sha256":"ea3d7f727d83f2d95bb3889747635a603339f569106db9743bb9e70d42148c3c","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_sch/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_sch","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"01123cc0fd02a41980f8e32eb5a1eea6cefff316f6c4922edd3ace2c65738771","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_sch/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_sch/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":["Ein Psalm Asaphs. Gott steht in der Gottesversammlung, inmitten der Götter richtet er:"]},{"type":"verse","number":2,"content":["«Wie lange wollt ihr ungerecht richten und die Person des Schuldigen ansehen? (Pause.)"]},{"type":"verse","number":3,"content":["Schafft dem Geringen und Verwaisten Recht, rechtfertigt den Elenden und Armen!"]},{"type":"verse","number":4,"content":["Lasset den Geringen und Dürftigen frei, errettet ihn aus der Hand der Gottlosen!»"]},{"type":"verse","number":5,"content":["Aber sie wollen nichts merken und nichts verstehen, sondern wandeln in der Finsternis; es wanken alle Stützen des Landes!"]},{"type":"verse","number":6,"content":["Ich habe gesagt: «Ihr seid Götter und allzumal Kinder des Höchsten;"]},{"type":"verse","number":7,"content":["dennoch sollt ihr sterben wie Menschen und fallen wie einer der Fürsten!»"]},{"type":"verse","number":8,"content":["Mache dich auf, o Gott, richte die Erde; denn du bist Erbherr über alle Nationen!"]}],"footnotes":[]},"thisChapterLink":"/api/deu_sch/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_sch/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}