67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_sch/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}