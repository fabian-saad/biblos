{"translation":{"id":"deu_sch","name":"Die Schlachter-Bibel 1951","website":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseNotes":null,"shortName":"SCH","englishName":"German Schlachter Bible 1951","language":"deu","textDirection":"ltr","sha256":"ea3d7f727d83f2d95bb3889747635a603339f569106db9743bb9e70d42148c3c","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_sch/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_sch","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"01123cc0fd02a41980f8e32eb5a1eea6cefff316f6c4922edd3ace2c65738771","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_sch/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_sch/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":["Ein Wallfahrtslied. Von David. Ich freue mich an denen, die zu mir sagen: Lasset uns zum Hause des HERRN gehen!"]},{"type":"verse","number":2,"content":["Unsre Füße stehen in deinen Toren, Jerusalem!"]},{"type":"verse","number":3,"content":["Jerusalem, du bist gebaut als eine Stadt, die fest in sich geschlossen ist,"]},{"type":"verse","number":4,"content":["wohin die Stämme hinaufziehen, die Stämme des HERRN (ein Zeugnis für Israel), zu preisen den Namen des HERRN!"]},{"type":"verse","number":5,"content":["Denn dort sind Stühle gesetzt zum Gericht, die Stühle des Hauses David."]},{"type":"verse","number":6,"content":["Bittet für den Frieden Jerusalems! Es gehe wohl denen, die dich lieben!"]},{"type":"verse","number":7,"content":["Friede sei in deinen Mauern und Glück in deinen Palästen!"]},{"type":"verse","number":8,"content":["Um meiner Brüder und Freunde willen sage ich: Friede sei in dir!"]},{"type":"verse","number":9,"content":["Um des Hauses des HERRN, unsres Gottes, willen will ich dein Bestes suchen!"]}],"footnotes":[]},"thisChapterLink":"/api/deu_sch/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_sch/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}