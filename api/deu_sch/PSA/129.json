! Wir segnen euch im Namen des HERRN!»"]}],"footnotes":[]},"thisChapterLink":"/api/deu_sch/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_sch/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}