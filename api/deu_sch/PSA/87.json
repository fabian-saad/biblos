{"translation":{"id":"deu_sch","name":"Die Schlachter-Bibel 1951","website":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1951","licenseNotes":null,"shortName":"SCH","englishName":"German Schlachter Bible 1951","language":"deu","textDirection":"ltr","sha256":"ea3d7f727d83f2d95bb3889747635a603339f569106db9743bb9e70d42148c3c","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_sch/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_sch","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"01123cc0fd02a41980f8e32eb5a1eea6cefff316f6c4922edd3ace2c65738771","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_sch/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_sch/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":["Von den Kindern Korahs. Ein Psalmlied. Er hat sie fest gegründet auf heiligen Bergen;"]},{"type":"verse","number":2,"content":["der HERR liebt die Tore Zions mehr als alle Wohnungen Jakobs."]},{"type":"verse","number":3,"content":["Herrliche Dinge sind von dir zu melden, du Stadt Gottes! (Pause.)"]},{"type":"verse","number":4,"content":["Ich nenne Rahab und Babel denen, die mich kennen; siehe, Philistäa und Tyrus und das Mohrenland: «Dieser ist dort geboren!»"]},{"type":"verse","number":5,"content":["Aber von Zion wird man sagen: «Mann für Mann ist in ihr geboren, und der Höchste selbst wird sie befestigen!»"]},{"type":"verse","number":6,"content":["Der HERR wird zählen, wenn er die Völker verzeichnet: «Dieser ist dort geboren.» (Pause.)"]},{"type":"verse","number":7,"content":["Und man singt und spielt: Alle meine Quellen sind in dir!"]}],"footnotes":[]},"thisChapterLink":"/api/deu_sch/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_sch/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_sch/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}