{"translation":{"id":"deu_tkw","name":"Textbibel von Kautzsch und Weizsäcker","website":"https://ebible.org/Scriptures/details.php?id=deutkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deutkw","licenseNotes":null,"shortName":"TKW","englishName":"German Textbibel","language":"deu","textDirection":"ltr","sha256":"d988589396fd30389c9043beeeb7399c1d74d1c165920441f64ef5ffcaed3293","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_tkw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31157,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_tkw","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"d6cda3e919d6a2ac214c66119d84885814e04a5695fac2fb75bbb2b1cdc2117c","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_tkw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_tkw/PSA/150.json","totalNumberOfVerses":2529},"chapter":{"number":23,"content":[{"type":"heading","content":["Jahwe, der gute Hirte."]},{"type":"verse","number":1,"content":["Ein Psalm Davids. Jahwe ist mein Hirte, mir wird nichts mangeln."]},{"type":"verse","number":2,"content":["Auf grasigen Auen läßt er mich lagern, zu Wassern, da ich ruhen kann, leitet er mich."]},{"type":"verse","number":3,"content":["Er erquickt meine Seele, er führt mich auf rechten Pfaden um seines Namens willen."]},{"type":"verse","number":4,"content":["Auch wenn ich in dunklem Thale wandern muß, fürchte ich kein Unglück; denn du bist bei mir: dein Stecken und dein Stab - die trösten mich!"]},{"type":"verse","number":5,"content":["Du bereitest vor mir einen Tisch im Angesichte meiner Bedränger. Du hast mein Haupt mit Öl gesalbt, mein Becher hat Überfluß."]},{"type":"verse","number":6,"content":["Nur Glück und Huld werden mir alle meine Lebenstage auf dem Fuße folgen, und im Hause Jahwes werde ich bleiben lebenslang."]}],"footnotes":[]},"thisChapterLink":"/api/deu_tkw/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_tkw/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_tkw/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}