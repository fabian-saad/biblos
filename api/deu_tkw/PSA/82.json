pe":"verse","number":8,"content":["Auf, o Gott, richte die Erde; denn du bist Erbherr über alle Heiden!"]}],"footnotes":[]},"thisChapterLink":"/api/deu_tkw/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_tkw/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_tkw/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}