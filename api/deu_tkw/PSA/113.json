:9,"content":["der die Unfruchtbare, die ohne Familie dastand, als Mutter der Kinder fröhlich wohnen läßt. Rühmet Jah!"]}],"footnotes":[]},"thisChapterLink":"/api/deu_tkw/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_tkw/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_tkw/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}