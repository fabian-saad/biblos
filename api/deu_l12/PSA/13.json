{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids, vorzusingen. HERR, wie lange willst du mein so gar vergessen? Wie lange verbirgst du dein Antlitz vor mir?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wie lange soll ich sorgen in meiner Seele und mich ängsten in meinem Herzen täglich? Wie lange soll sich mein Feind über mich erheben?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Schaue doch und erhöre mich, HERR, mein Gott! Erleuchte meine Augen, daß ich nicht dem Tode entschlafe,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"daß nicht mein Feind rühme, er sei mein mächtig geworden, und meine Widersacher sich nicht freuen, daß ich niederlage.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ich hoffe aber darauf, daß du so gnädig bist; mein Herz freut sich, daß du so gerne hilfst.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ich will dem HERRN singen, daß er so wohl an mir tut.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}