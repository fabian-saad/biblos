{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied Davids im höhern Chor. HERR, mein Herz ist nicht hoffärtig, und meine Augen sind nicht stolz; ich wandle nicht in großen Dingen, die mir zu hoch sind.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ja, ich habe meine Seele gesetzt und gestillt; so ist meine Seele in mir wie ein entwöhntes Kind bei seiner Mutter.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israel, hoffe auf den HERRN von nun an bis in Ewigkeit!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}