{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Asaphs. Gott steht in der Gemeinde Gottes und ist Richter unter den Göttern.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wie lange wollt ihr unrecht richten und die Person der Gottlosen vorziehen? (Sela.)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Schaffet Recht dem Armen und dem Waisen und helfet dem Elenden und Dürftigen zum Recht.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Errettet den Geringen und Armen und erlöset ihn aus der Gottlosen Gewalt.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aber sie lassen sich nicht sagen und achten's nicht; sie gehen immer hin im Finstern; darum müssen alle Grundfesten des Landes wanken.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ich habe wohl gesagt: “Ihr seid Götter und allzumal Kinder des Höchsten”;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"aber ihr werdet sterben wie Menschen und wie ein Tyrann zugrunde gehen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gott, mache dich auf und richte den Erdboden; denn du bist Erbherr über alle Heiden!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}