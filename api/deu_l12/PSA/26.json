{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids. HERR, schaffe mir Recht; denn ich bin unschuldig! Ich hoffe auf den HERRN; darum werde ich nicht fallen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Prüfe mich, HERR, und versuche mich; läutere meine Nieren und mein Herz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Denn deine Güte ist vor meinen Augen, und ich wandle in deiner Wahrheit.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ich sitze nicht bei den eitlen Leuten und habe nicht Gemeinschaft mit den Falschen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ich hasse die Versammlung der Boshaften und sitze nicht bei den Gottlosen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ich wasche meine Hände in Unschuld und halte mich, HERR, zu deinem Altar,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"da man hört die Stimme des Dankens, und da man predigt alle deine Wunder.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"HERR, ich habe lieb die Stätte deines Hauses und den Ort, da deine Ehre wohnt.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Raffe meine Seele nicht hin mit den Sündern noch mein Leben mit den Blutdürstigen,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"welche mit böser Tücke umgehen und nehmen gern Geschenke.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ich aber wandle unschuldig. Erlöse mich und sei mir gnädig!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mein Fuß geht richtig. Ich will dich loben, HERR, in den Versammlungen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}