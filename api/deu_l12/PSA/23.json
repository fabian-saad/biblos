{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids. Der HERR ist mein Hirte; mir wird nichts mangeln.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Er weidet mich auf grüner Aue und führet mich zum frischen Wasser.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Er erquicket meine Seele; er führet mich auf rechter Straße um seines Namens willen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Und ob ich schon wanderte im finstern Tal, fürchte ich kein Unglück; denn du bist bei mir, dein Stecken und dein Stab trösten mich.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Du bereitest vor mir einen Tisch im Angesicht meiner Feinde. Du salbest mein Haupt mit Öl und schenkest mir voll ein.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gutes und Barmherzigkeit werden mir folgen mein Leben lang, und ich werde bleiben im Hause des HERRN immerdar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}