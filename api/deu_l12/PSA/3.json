{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids, da er floh vor seinem Sohn Absalom. Ach HERR, wie sind meiner Feinde so viel und setzen sich so viele wider mich!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Viele sagen von meiner Seele: Sie hat keine Hilfe bei Gott. (Sela.)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aber du, HERR, bist der Schild für mich und der mich zu Ehren setzt und mein Haupt aufrichtet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ich rufe an mit meiner Stimme den HERRN; so erhört er mich von seinem heiligen Berge. (Sela.)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ich liege und schlafe und erwache; denn der HERR hält mich.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ich fürchte mich nicht vor viel Tausenden, die sich umher gegen mich legen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Auf, HERR, hilf mir, mein Gott! denn du schlägst alle meine Feinde auf den Backen und zerschmetterst der Gottlosen Zähne.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bei dem HERRN findet man Hilfe. Dein Segen komme über dein Volk! (Sela.)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}