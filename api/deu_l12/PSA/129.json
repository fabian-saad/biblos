{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied im höhern Chor. Sie haben mich oft gedrängt von meiner Jugend auf, so sage Israel,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"sie haben mich oft gedrängt von meiner Jugend auf; aber sie haben mich nicht übermocht.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Die Pflüger haben auf meinen Rücken geackert und ihre Furchen lang gezogen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Der HERR, der gerecht ist, hat der Gottlosen Seile abgehauen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ach daß müßten zu Schanden werden und zurückkehren alle, die Zion gram sind!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ach daß sie müßten sein wie das Gras auf den Dächern, welches verdorrt, ehe man es ausrauft,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"von welchem der Schnitter seine Hand nicht füllt noch der Garbenbinder seinen Arm","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"und die vorübergehen nicht sprechen: “Der Segen des HERRN sei über euch! wir segnen euch im Namen des HERRN”!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}