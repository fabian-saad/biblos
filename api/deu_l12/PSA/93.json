{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Der HERR ist König und herrlich geschmückt; der HERR ist geschmückt und hat ein Reich angefangen, soweit die Welt ist, und zugerichtet, daß es bleiben soll.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Von Anbeginn steht dein Stuhl fest; du bist ewig.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"HERR, die Wasserströme erheben sich, die Wasserströme erheben ihr Brausen, die Wasserströme heben empor die Wellen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Die Wasserwogen im Meer sind groß und brausen mächtig; der HERR aber ist noch größer in der Höhe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dein Wort ist eine rechte Lehre. Heiligkeit ist die Zierde deines Hauses, o HERR, ewiglich.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}