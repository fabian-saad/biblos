{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Halleluja! Lobet im Himmel den HERRN; lobet ihn in der Höhe!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lobet ihn, alle seine Engel; lobet ihn, all sein Heer!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lobet ihn, Sonne und Mond; lobet ihn, alle leuchtenden Sterne!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lobet ihn, ihr Himmel allenthalben und die Wasser, die oben am Himmel sind!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Die sollen loben den Namen des HERRN; denn er gebot, da wurden sie geschaffen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Er hält sie immer und ewiglich; er ordnet sie, daß sie nicht anders gehen dürfen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lobet den HERRN auf Erden, ihr Walfische und alle Tiefen;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Feuer, Hagel, Schnee und Dampf, Strumwinde, die sein Wort ausrichten;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Berge und alle Hügel, fruchtbare Bäume und alle Zedern;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tiere und alles Vieh, Gewürm und Vögel;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ihr Könige auf Erden und alle Völker, Fürsten und alle Richter auf Erden;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Jünglinge und Jungfrauen, Alte mit den Jungen!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Die sollen loben den Namen des HERRN; denn sein Name allein ist hoch, sein Lob geht, soweit Himmel und Erde ist.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Und erhöht das Horn seines Volkes. Alle Heiligen sollen loben, die Kinder Israel, das Volk, das ihm dient. Halleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}