{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids, vorzusingen, auf Saitenspiel. Höre, Gott, mein Schreien und merke auf mein Gebet!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hienieden auf Erden rufe ich zu dir, wenn mein Herz in Angst ist, du wollest mich führen auf einen hohen Felsen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Denn du bist meine Zuversicht, ein starker Turm vor meinen Feinden.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Laß mich wohnen in deiner Hütte ewiglich und Zuflucht haben unter deinen Fittichen. (Sela.)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Denn du, Gott, hörst mein Gelübde; du belohnst die wohl, die deinen Namen fürchten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Du wollest dem König langes Leben geben, daß seine Jahre währen immer für und für,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"daß er immer bleibe vor Gott. Erzeige ihm Güte und Treue, die ihn behüten.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"So will ich deinem Namen lobsingen ewiglich, daß ich meine Gelübde bezahle täglich.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}