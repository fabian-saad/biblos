{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Halleluja! Lobet, ihr Knechte des HERRN, lobet den Namen des HERRN!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gelobet sei des HERRN Name von nun an bis in Ewigkeit!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vom Aufgang der Sonne bis zu ihrem Niedergang sei gelobet der Name des HERRN!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Der HERR ist hoch über alle Heiden; seine Ehre geht, soweit der Himmel ist.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wer ist wie der HERR, unser Gott? der sich so hoch gesetzt hat","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"und auf das Niedrige sieht im Himmel und auf Erden;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"der den Geringen aufrichtet aus dem Staube und erhöht den Armen aus dem Kot,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"daß er ihn setze neben die Fürsten, neben die Fürsten seines Volkes;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"der die Unfruchtbare im Hause wohnen macht, daß sie eine fröhliche Kindermutter wird. Halleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}