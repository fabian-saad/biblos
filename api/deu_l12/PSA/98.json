{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm. Singet dem HERRN ein neues Lied; denn er tut Wunder. Er siegt mit seiner Rechten und mit seinem heiligen Arm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Der HERR läßt sein Heil verkündigen; vor den Völkern läßt er seine Gerechtigkeit offenbaren.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Er gedenkt an seine Gnade und Wahrheit dem Hause Israel; aller Welt Enden sehen das Heil unsers Gottes.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jauchzet dem HERRN, alle Welt; singet, rühmet und lobet!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lobet den HERRN mit Harfen, mit Harfen und Psalmen!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mit Drommeten und Posaunen jauchzet vor dem HERRN, dem König!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Das Meer brause und was darinnen ist, der Erdboden und die darauf wohnen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Die Wasserströme frohlocken, und alle Berge seien fröhlich","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"vor dem HERRN; denn er kommt das Erdreich zu richten. Er wird den Erdboden richten mit Gerechtigkeit und die Völker mit Recht.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}