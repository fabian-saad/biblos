{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied im höhern Chor. Ich rufe zu dem HERRN in meiner Not, und er erhört mich.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"HERR, errette meine Seele von den Lügenmäulern, von den falschen Zungen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Was kann mir die falsche Zunge tun, was kann sie ausrichten?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sie ist wie scharfe Pfeile eines Starken, wie Feuer in Wachholdern.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wehe mir, daß ich ein Fremdling bin unter Mesech; ich muß wohnen unter den Hütten Kedars.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Es wird meiner Seele lang, zu wohnen bei denen, die den Frieden hassen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ich halte Frieden; aber wenn ich rede, so fangen sie Krieg an.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}