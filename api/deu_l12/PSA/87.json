{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalmlied der Kinder Korah. Sie ist fest gegründet auf den heiligen Bergen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Der HERR liebt die Tore Zions über alle Wohnungen Jakobs.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Herrliche Dinge werden in dir gepredigt, du Stadt Gottes. (Sela.)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ich will predigen lassen Rahab und Babel, daß sie mich kennen sollen. Siehe, die Philister und Tyrer samt den Mohren werden daselbst geboren.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Man wird zu Zion sagen, daß allerlei Leute darin geboren werden und daß er, der Höchste, sie baue.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Der HERR wird zählen, wenn er aufschreibt die Völker: “Diese sind daselbst geboren.” (Sela.)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Und die Sänger wie die im Reigen werden alle in dir singen, eins ums andere.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}