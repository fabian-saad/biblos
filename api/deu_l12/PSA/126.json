{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied im Höhern Chor. Wenn der HERR die Gefangenen Zions erlösen wird, so werden wir sein wie die Träumenden.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dann wird unser Mund voll Lachens und unsere Zunge voll Rühmens sein. Da wird man sagen unter den Heiden: Der HERR hat Großes an ihnen getan!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Der HERR hat Großes an uns getan; des sind wir fröhlich.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"HERR, bringe wieder unsere Gefangenen, wie du die Bäche wiederbringst im Mittagslande.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Die mit Tränen säen, werden mit Freuden ernten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sie gehen hin und weinen und tragen edlen Samen und kommen mit Freuden und bringen ihre Garben.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}