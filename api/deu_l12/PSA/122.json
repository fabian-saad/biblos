{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied Davids im höhern Chor. Ich freute mich über die, so mir sagten: Laßt uns ins Haus des HERRN gehen!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unsre Füße stehen in deinen Toren, Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem ist gebaut, daß es eine Stadt sei, da man zusammenkommen soll,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"da die Stämme hinaufgehen, die Stämme des HERRN, wie geboten ist dem Volk Israel, zu danken dem Namen des Herrn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Denn daselbst sind Stühle zum Gericht, die Stühle des Hauses David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wünschet Jerusalem Glück! Es möge wohl gehen denen, die dich lieben!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Es möge Friede sein in deinen Mauern und Glück in deinen Palästen!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Um meiner Brüder und Freunde willen will ich dir Frieden wünschen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Um des Hauses willen des HERRN, unsers Gottes, will ich dein Bestes suchen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}