{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Halleluja! Singet dem HERRN ein neues Lied; die Gemeinde der Heiligen soll ihn loben.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel freue sich des, der es gemacht hat; die Kinder Zions seien fröhlich über ihren König.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sie sollen loben seinen Namen im Reigen; mit Pauken und Harfen sollen sie ihm spielen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Denn der HERR hat Wohlgefallen an seinem Volk; er hilft den Elenden herrlich.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Die Heiligen sollen fröhlich sein und preisen und rühmen auf ihren Lagern.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ihr Mund soll Gott erheben, und sie sollen scharfe Schwerter in ihren Händen haben,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"daß sie Rache üben unter den Heiden, Strafe unter den Völkern;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ihre Könige zu binden mit Ketten und ihre Edlen mit eisernen Fesseln;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"daß sie ihnen tun das Recht, davon geschrieben ist. Solche Ehre werden alle seine Heiligen haben. Halleluja!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}