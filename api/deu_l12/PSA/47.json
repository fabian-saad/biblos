{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm der Kinder Korah, vorzusingen. Frohlocket mit Händen, alle Völker, und jauchzet Gott mit fröhlichem Schall!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Denn der HERR, der Allerhöchste, ist erschrecklich, ein großer König auf dem ganzen Erdboden.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Er zwingt die Völker unter uns und die Leute unter unsre Füße.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Er erwählt uns unser Erbteil, die Herrlichkeit Jakobs, den er liebt. (Sela.)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gott fährt auf mit Jauchzen und der HERR mit heller Posaune.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lobsinget, lobsinget Gott; lobsinget, lobsinget unserm König!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Denn Gott ist König auf dem ganzen Erdboden; lobsinget ihm klüglich!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gott ist König über die Heiden; Gott sitzt auf seinem heiligen Stuhl.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Die Fürsten unter den Völkern sind versammelt zu einem Volk des Gottes Abrahams; denn Gottes sind die Schilde auf Erden, er hat sie erhöht.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}