{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids, vorzusingen, zum Gedächtnis. Eile, Gott, mich zu erretten, HERR, mir zu helfen!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Es müssen sich schämen und zu Schanden werden, die nach meiner Seele stehen; sie müssen zurückkehren und gehöhnt werden, die mir Übles wünschen,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"daß sie müssen wiederum zu Schanden werden, die da über mich schreien: “Da, da!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sich freuen und fröhlich müssen sein an dir, die nach dir fragen, und die dein Heil lieben, immer sagen: Hoch gelobt sei Gott!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ich aber bin elend und arm. Gott, eile zu mir, denn du bist mein Helfer und Erretter; mein Gott verziehe nicht!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}