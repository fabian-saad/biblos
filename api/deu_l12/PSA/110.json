{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids. Der HERR sprach zu meinem Herrn: “Setze dich zu meiner Rechten, bis ich deine Feinde zum Schemel deiner Füße lege.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Der HERR wird das Zepter deines Reiches senden aus Zion: “Herrsche unter deinen Feinden!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nach deinem Sieg wird dir dein Volk willig opfern in heiligem Schmuck. Deine Kinder werden dir geboren wie der Tau aus der Morgenröte.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Der HERR hat geschworen, und es wird ihn nicht gereuen: “Du ist ein Priester ewiglich nach der Weise Melchisedeks.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Der Herr zu deiner Rechten wird zerschmettern die Könige am Tage seines Zorns;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"er wird richten unter den Heiden; er wird ein großes Schlagen unter ihnen tun; er wird zerschmettern das Haupt über große Lande.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Er wird trinken vom Bach auf dem Wege; darum wird er das Haupt emporheben.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}