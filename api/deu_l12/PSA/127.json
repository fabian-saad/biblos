{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied Salomos im Höhern Chor. Wo der HERR nicht das Haus baut, so arbeiten umsonst, die daran bauen. Wo der HERR nicht die Stadt behütet, so wacht der Wächter umsonst.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Es ist umsonst, daß ihr früh aufstehet und hernach lange sitzet und esset euer Brot mit Sorgen; denn seinen Freunden gibt er's schlafend.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siehe, Kinder sind eine Gabe des HERRN, und Leibesfrucht ist ein Geschenk.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wie die Pfeile in der Hand des Starken, also geraten die jungen Knaben.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wohl dem, der seinen Köcher derselben voll hat! Die werden nicht zu Schanden, wenn sie mit ihren Feinden handeln im Tor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}