{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Wohl dem, der nicht wandelt im Rat der Gottlosen noch tritt auf den Weg Sünder noch sitzt, da die Spötter sitzen,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"sondern hat Lust zum Gesetz des HERRN und redet von seinem Gesetz Tag und Nacht!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Der ist wie ein Baum, gepflanzt an den Wasserbächen, der seine Frucht bringt zu seiner Zeit, und seine Blätter verwelken nicht; und was er macht, das gerät wohl.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aber so sind die Gottlosen nicht, sondern wie Spreu, die der Wind verstreut.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Darum bleiben die Gottlosen nicht im Gericht noch die Sünder in der Gemeinde der Gerechten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Denn der HERR kennt den Weg der Gerechten; aber der Gottlosen Weg vergeht.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}