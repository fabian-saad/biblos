{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids. Von Gnade und Recht will ich singen und dir, HERR, lobsagen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ich handle vorsichtig und redlich bei denen, die mir zugehören, und wandle treulich in meinem Hause.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ich nehme mir keine böse Sache vor; ich hasse den Übeltäter und lasse ihn nicht bei mir bleiben.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ein verkehrtes Herz muß von mir weichen; den Bösen leide ich nicht.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Der seinen Nächsten heimlich verleumdet, den vertilge ich; ich mag den nicht, der stolze Gebärde und hohen Mut hat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meine Augen sehen nach den Treuen im Lande, daß sie bei mir wohnen; und habe gerne fromme Diener.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Falsche Leute halte ich nicht in meinem Hause; die Lügner gedeihen bei mir nicht.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jeden Morgen will ich vertilgen alle Gottlosen im Lande, daß ich alle Übeltäter ausrotte aus der Stadt des HERRN.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}