{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied im höhern Chor. Ich hebe meine Augen auf zu den Bergen von welchen mir Hilfe kommt.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Meine Hilfe kommt von dem HERRN, der Himmel und Erde gemacht hat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Er wird deinen Fuß nicht gleiten lassen; und der dich behütet schläft nicht.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siehe, der Hüter Israels schläft noch schlummert nicht.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Der HERR behütet dich; der HERR ist dein Schatten über deiner rechten Hand,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"daß dich des Tages die Sonne nicht steche noch der Mond des Nachts.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Der HERR behüte dich vor allem Übel, er behüte deine Seele;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"der HERR behüte deinen Ausgang und Eingang von nun an bis in Ewigkeit.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}