{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Psalm Davids, vorzusingen. Ich traue auf den HERRN. Wie sagt ihr denn zu meiner Seele: Fliehet wie ein Vogel auf eure Berge?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Denn siehe, die Gottlosen spannen den Bogen und legen ihre Pfeile auf die Sehnen, damit heimlich zu schießen die Frommen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Denn sie reißen den Grund um; was sollte der Gerechte ausrichten?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Der HERR ist in seinem heiligen Tempel, des HERRN Stuhl ist im Himmel; seine Augen sehen darauf, seine Augenlider prüfen die Menschenkinder.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Der HERR prüft den Gerechten; seine Seele haßt den Gottlosen und die gerne freveln.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Er wird regnen lassen über die Gottlosen Blitze, Feuer und Schwefel und wird ihnen ein Wetter zum Lohn geben.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Der HERR ist gerecht und hat Gerechtigkeit lieb; die Frommen werden schauen sein Angesicht.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}