{"translation":{"id":"deu_l12","name":"Lutherbibel 1912","website":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deu1912","licenseNotes":null,"shortName":"L12","englishName":"German Luther Bible 1912","language":"deu","textDirection":"ltr","sha256":"c37943923929f9d47f5299e633d5ee935792894e7e3db2bcce52e717d645458e","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_l12/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_l12","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"fec3ad12d0d95047286c01c2d39f8eb0a40702c64def30b525e8759548401bce","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_l12/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_l12/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Ein Lied im höhern Chor. Aus der Tiefe rufe ich, HERR, zu dir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Herr, höre auf meine Stimme, laß deine Ohren merken auf die Stimme meines Flehens!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"So du willst, HERR, Sünden zurechnen, Herr, wer wird bestehen?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Denn bei dir ist die Vergebung, daß man dich fürchte.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ich harre des HERRN; meine Seele harret, und ich hoffe auf sein Wort.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meine Seele wartet auf den Herrn von einer Morgenwache bis zur andern.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel, hoffe auf den HERRN! denn bei dem HERRN ist die Gnade und viel Erlösung bei ihm,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"und er wird Israel erlösen aus allen seinen Sünden.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/deu_l12/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_l12/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_l12/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}