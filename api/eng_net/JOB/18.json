{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"JOB","translationId":"eng_net","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"202d349bee1b03cbacfc2d5e5df9f766ffe0df07cb5dc34e1900bbb84fbd2e81","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_net/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Then Bildad the Shuhite answered:"]},{"type":"verse","number":2,"content":[{"text":"“How long until you make an end of words?","poem":1},{"lineBreak":true},{"text":"You must consider, and then we can talk.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Why should we be regarded as beasts,","poem":1},{"lineBreak":true},{"text":"and considered stupid in your sight?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"You who tear yourself to pieces in your anger,","poem":1},{"lineBreak":true},{"text":"will the earth be abandoned for your sake?","poem":1},{"lineBreak":true},{"text":"Or will a rock be moved from its place?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Yes, the lamp of the wicked is extinguished;","poem":1},{"lineBreak":true},{"text":"his flame of fire does not shine.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The light in his tent grows dark;","poem":1},{"lineBreak":true},{"text":"his lamp above him is extinguished.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"His vigorous steps are restricted,","poem":1},{"lineBreak":true},{"text":"and his own counsel throws him down.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For he has been thrown into a net by his feet","poem":1},{"lineBreak":true},{"text":"and he wanders into a mesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A trap seizes him by the heel;","poem":1},{"lineBreak":true},{"text":"a snare grips him.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A rope is hidden for him on the ground","poem":1},{"lineBreak":true},{"text":"and a trap for him lies on the path.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Terrors frighten him on all sides","poem":1},{"lineBreak":true},{"text":"and dog his every step.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Calamity is hungry for him,","poem":1},{"lineBreak":true},{"text":"and misfortune is ready at his side.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"It eats away parts of his skin;","poem":1},{"lineBreak":true},{"text":"the most terrible death devours his limbs.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"He is dragged from the security of his tent,","poem":1},{"lineBreak":true},{"text":"and marched off to the king of terrors.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fire resides in his tent;","poem":1},{"lineBreak":true},{"text":"over his residence burning sulfur is scattered.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Below his roots dry up,","poem":1},{"lineBreak":true},{"text":"and his branches wither above.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"His memory perishes from the earth,","poem":1},{"lineBreak":true},{"text":"he has no name in the land.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"He is driven from light into darkness","poem":1},{"lineBreak":true},{"text":"and is banished from the world.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"He has neither children nor descendants among his people,","poem":1},{"lineBreak":true},{"text":"no survivor in those places he once stayed.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"People of the west are appalled at his fate;","poem":1},{"lineBreak":true},{"text":"people of the east are seized with horror, saying,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"‘Surely such is the residence of an evil man;","poem":1},{"lineBreak":true},{"text":"and this is the place of one who has not known God.’”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}