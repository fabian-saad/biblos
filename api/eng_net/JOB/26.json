{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"JOB","translationId":"eng_net","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"202d349bee1b03cbacfc2d5e5df9f766ffe0df07cb5dc34e1900bbb84fbd2e81","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_net/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Then Job replied:"]},{"type":"verse","number":2,"content":[{"text":"“How you have helped the powerless!","poem":1},{"lineBreak":true},{"text":"How you have saved the person who has no strength!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"How you have advised the one without wisdom,","poem":1},{"lineBreak":true},{"text":"and abundantly revealed your insight!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To whom did you utter these words?","poem":1},{"lineBreak":true},{"text":"And whose spirit has come forth from your mouth?","poem":1}]},{"type":"heading","content":["A Better Description of God’s Greatness"]},{"type":"verse","number":5,"content":[{"text":"“The dead tremble –","poem":1},{"lineBreak":true},{"text":"those beneath the waters","poem":1},{"lineBreak":true},{"text":"and all that live in them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The underworld is naked before God;","poem":1},{"lineBreak":true},{"text":"the place of destruction lies uncovered.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spreads out the northern skies over empty space;","poem":1},{"lineBreak":true},{"text":"he suspends the earth on nothing.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He locks the waters in his clouds,","poem":1},{"lineBreak":true},{"text":"and the clouds do not burst with the weight of them.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He conceals the face of the full moon,","poem":1},{"lineBreak":true},{"text":"shrouding it with his clouds.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He marks out the horizon on the surface of the waters","poem":1},{"lineBreak":true},{"text":"as a boundary between light and darkness.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The pillars of the heavens tremble","poem":1},{"lineBreak":true},{"text":"and are amazed at his rebuke.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"By his power he stills the sea;","poem":1},{"lineBreak":true},{"text":"by his wisdom he cut Rahab the great sea monster to pieces.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"By his breath the skies became fair;","poem":1},{"lineBreak":true},{"text":"his hand pierced the fleeing serpent.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Indeed, these are but the outer fringes of his ways!","poem":1},{"lineBreak":true},{"text":"How faint is the whisper we hear of him!","poem":1},{"lineBreak":true},{"text":"But who can understand the thunder of his power?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}