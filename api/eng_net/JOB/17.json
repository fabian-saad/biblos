{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"JOB","translationId":"eng_net","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"202d349bee1b03cbacfc2d5e5df9f766ffe0df07cb5dc34e1900bbb84fbd2e81","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_net/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"My spirit is broken,","poem":1},{"lineBreak":true},{"text":"my days have faded out,","poem":1},{"lineBreak":true},{"text":"the grave awaits me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Surely mockery is with me;","poem":1},{"lineBreak":true},{"text":"my eyes must dwell on their hostility.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Make then my pledge with you.","poem":1},{"lineBreak":true},{"text":"Who else will put up security for me?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Because you have closed their minds to understanding,","poem":1},{"lineBreak":true},{"text":"therefore you will not exalt them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If a man denounces his friends for personal gain,","poem":1},{"lineBreak":true},{"text":"the eyes of his children will fail.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He has made me a byword to people,","poem":1},{"lineBreak":true},{"text":"I am the one in whose face they spit.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"My eyes have grown dim with grief;","poem":1},{"lineBreak":true},{"text":"my whole frame is but a shadow.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Upright men are appalled at this;","poem":1},{"lineBreak":true},{"text":"the innocent man is troubled with the godless.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But the righteous man holds to his way,","poem":1},{"lineBreak":true},{"text":"and the one with clean hands grows stronger.","poem":1}]},{"type":"heading","content":["Anticipation of Death"]},{"type":"verse","number":10,"content":[{"text":"“But turn, all of you, and come now!","poem":1},{"lineBreak":true},{"text":"I will not find a wise man among you.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"My days have passed, my plans are shattered,","poem":1},{"lineBreak":true},{"text":"even the desires of my heart.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"These men change night into day;","poem":1},{"lineBreak":true},{"text":"they say, ‘The light is near","poem":1},{"lineBreak":true},{"text":"in the face of darkness.’","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"If I hope for the grave to be my home,","poem":1},{"lineBreak":true},{"text":"if I spread out my bed in darkness,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"If I cry to corruption, ‘You are my father,’","poem":1},{"lineBreak":true},{"text":"and to the worm, ‘My Mother,’ or ‘My sister,’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"where then is my hope?","poem":1},{"lineBreak":true},{"text":"And my hope, who sees it?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Will it go down to the barred gates of death?","poem":1},{"lineBreak":true},{"text":"Will we descend together into the dust?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}