{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"JOB","translationId":"eng_net","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"202d349bee1b03cbacfc2d5e5df9f766ffe0df07cb5dc34e1900bbb84fbd2e81","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/eng_net/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Then Elihu answered:"]},{"type":"verse","number":2,"content":[{"text":"“Do you think this to be just:","poem":1},{"lineBreak":true},{"text":"when you say, ‘My right before God.’","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But you say, ‘What will it profit you,’","poem":1},{"lineBreak":true},{"text":"and, ‘What do I gain by not sinning?’","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will reply to you,","poem":1},{"lineBreak":true},{"text":"and to your friends with you.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaze at the heavens and see;","poem":1},{"lineBreak":true},{"text":"consider the clouds, which are higher than you!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"If you sin, how does it affect God?","poem":1},{"lineBreak":true},{"text":"If your transgressions are many,","poem":1},{"lineBreak":true},{"text":"what does it do to him?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"If you are righteous, what do you give to God,","poem":1},{"lineBreak":true},{"text":"or what does he receive from your hand?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Your wickedness affects only a person like yourself,","poem":1},{"lineBreak":true},{"text":"and your righteousness only other people.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“People cry out","poem":1},{"lineBreak":true},{"text":"because of the excess of oppression;","poem":1},{"lineBreak":true},{"text":"they cry out for help","poem":1},{"lineBreak":true},{"text":"because of the power of the mighty.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"But no one says, ‘Where is God, my Creator,","poem":1},{"lineBreak":true},{"text":"who gives songs in the night,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"who teaches us more than the wild animals of the earth,","poem":1},{"lineBreak":true},{"text":"and makes us wiser than the birds of the sky?’","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Then they cry out – but he does not answer –","poem":1},{"lineBreak":true},{"text":"because of the arrogance of the wicked.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Surely it is an empty cry – God does not hear it;","poem":1},{"lineBreak":true},{"text":"the Almighty does not take notice of it.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"How much less, then,","poem":1},{"lineBreak":true},{"text":"when you say that you do not perceive him,","poem":1},{"lineBreak":true},{"text":"that the case is before him","poem":1},{"lineBreak":true},{"text":"and you are waiting for him!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"And further, when you say","poem":1},{"lineBreak":true},{"text":"that his anger does not punish,","poem":1},{"lineBreak":true},{"text":"and that he does not know transgression!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"So Job opens his mouth to no purpose;","poem":1},{"lineBreak":true},{"text":"without knowledge he multiplies words.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}