{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"LAM","translationId":"eng_net","name":"Lamentations","commonName":"Lamentations","title":"Lamentations","order":25,"numberOfChapters":5,"sha256":"52c8d0db59e90159a6b888e5a417f6ce668abff815bb78ade97eb10e993cfbd4","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/eng_net/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["The Prophet Speaks:"]},{"type":"heading","content":["א (Alef)"]},{"type":"verse","number":1,"content":[{"text":"Alas! The city once full of people","poem":1},{"lineBreak":true},{"text":"now sits all alone!","poem":1},{"lineBreak":true},{"text":"The prominent lady among the nations","poem":1},{"lineBreak":true},{"text":"has become a widow!","poem":1},{"lineBreak":true},{"text":"The princess who once ruled the provinces","poem":1},{"lineBreak":true},{"text":"has become a forced laborer!","poem":1}]},{"type":"heading","content":["ב (Bet)"]},{"type":"verse","number":2,"content":[{"text":"She weeps bitterly at night;","poem":1},{"lineBreak":true},{"text":"tears stream down her cheeks.","poem":1},{"lineBreak":true},{"text":"She has no one to comfort her","poem":1},{"lineBreak":true},{"text":"among all her lovers.","poem":1},{"lineBreak":true},{"text":"All her friends have betrayed her;","poem":1},{"lineBreak":true},{"text":"they have become her enemies.","poem":1}]},{"type":"heading","content":["ג (Gimel)"]},{"type":"verse","number":3,"content":[{"text":"Judah has departed into exile","poem":1},{"lineBreak":true},{"text":"under affliction and harsh oppression.","poem":1},{"lineBreak":true},{"text":"She lives among the nations;","poem":1},{"lineBreak":true},{"text":"she has found no resting place.","poem":1},{"lineBreak":true},{"text":"All who pursued her overtook her","poem":1},{"lineBreak":true},{"text":"in narrow straits.","poem":1}]},{"type":"heading","content":["ד (Dalet)"]},{"type":"verse","number":4,"content":[{"text":"The roads to Zion mourn","poem":1},{"lineBreak":true},{"text":"because no one travels to the festivals.","poem":1},{"lineBreak":true},{"text":"All her city gates are deserted;","poem":1},{"lineBreak":true},{"text":"her priests groan.","poem":1},{"lineBreak":true},{"text":"Her virgins grieve;","poem":1},{"lineBreak":true},{"text":"she is in bitter anguish!","poem":1}]},{"type":"heading","content":["ה (He)"]},{"type":"verse","number":5,"content":[{"text":"Her foes subjugated her;","poem":1},{"lineBreak":true},{"text":"her enemies are at ease.","poem":1},{"lineBreak":true},{"text":"For the Lord afflicted her","poem":1},{"lineBreak":true},{"text":"because of her many acts of rebellion.","poem":1},{"lineBreak":true},{"text":"Her children went away","poem":1},{"lineBreak":true},{"text":"captive before the enemy.","poem":1}]},{"type":"heading","content":["ו (Vav)"]},{"type":"verse","number":6,"content":[{"text":"All of Daughter Zion’s splendor","poem":1},{"lineBreak":true},{"text":"has departed.","poem":1},{"lineBreak":true},{"text":"Her leaders became like deer;","poem":1},{"lineBreak":true},{"text":"they found no pasture,","poem":1},{"lineBreak":true},{"text":"so they were too exhausted to escape","poem":1},{"lineBreak":true},{"text":"from the hunter.","poem":1}]},{"type":"heading","content":["ז (Zayin)"]},{"type":"verse","number":7,"content":[{"text":"Jerusalem remembers,","poem":1},{"lineBreak":true},{"text":"when she became a poor homeless person,","poem":1},{"lineBreak":true},{"text":"all her treasures","poem":1},{"lineBreak":true},{"text":"that she owned in days of old.","poem":1},{"lineBreak":true},{"text":"When her people fell into an enemy’s grip,","poem":1},{"lineBreak":true},{"text":"none of her allies came to her rescue.","poem":1},{"lineBreak":true},{"text":"Her enemies gloated over her;","poem":1},{"lineBreak":true},{"text":"they sneered at her downfall.","poem":1}]},{"type":"heading","content":["ח (Khet)"]},{"type":"verse","number":8,"content":[{"text":"Jerusalem committed terrible sin;","poem":1},{"lineBreak":true},{"text":"therefore she became an object of scorn.","poem":1},{"lineBreak":true},{"text":"All who admired her have despised her","poem":1},{"lineBreak":true},{"text":"because they have seen her nakedness.","poem":1},{"lineBreak":true},{"text":"She groans aloud","poem":1},{"lineBreak":true},{"text":"and turns away in shame.","poem":1}]},{"type":"heading","content":["ט (Tet)"]},{"type":"verse","number":9,"content":[{"text":"Her menstrual flow has soiled her clothing;","poem":1},{"lineBreak":true},{"text":"she did not consider the consequences of her sin.","poem":1},{"lineBreak":true},{"text":"Her demise was astonishing,","poem":1},{"lineBreak":true},{"text":"and there was no one to comfort her.","poem":1},{"lineBreak":true},{"text":"She cried, “Look, O Lord, on my affliction","poem":1},{"lineBreak":true},{"text":"because my enemy boasts!”","poem":1}]},{"type":"heading","content":["י (Yod)"]},{"type":"verse","number":10,"content":[{"text":"An enemy grabbed","poem":1},{"lineBreak":true},{"text":"all her valuables.","poem":1},{"lineBreak":true},{"text":"Indeed she watched in horror as Gentiles","poem":1},{"lineBreak":true},{"text":"invaded her holy temple –","poem":1},{"lineBreak":true},{"text":"those whom you had commanded:","poem":1},{"lineBreak":true},{"text":"“They must not enter your assembly place.”","poem":1}]},{"type":"heading","content":["כ (Kaf)"]},{"type":"verse","number":11,"content":[{"text":"All her people groaned","poem":1},{"lineBreak":true},{"text":"as they searched for a morsel of bread.","poem":1},{"lineBreak":true},{"text":"They exchanged their valuables","poem":1},{"lineBreak":true},{"text":"for just enough food","poem":1},{"lineBreak":true},{"text":"to stay alive.","poem":1},"Jerusalem Speaks:",{"text":"“Look, O Lord! Consider","poem":1},{"lineBreak":true},{"text":"that I have become worthless!”","poem":1}]},{"type":"heading","content":["ל (Lamed)"]},{"type":"verse","number":12,"content":[{"text":"Is it nothing to you, all you who pass by on the road?","poem":1},{"lineBreak":true},{"text":"Look and see!","poem":1},{"lineBreak":true},{"text":"Is there any pain like mine?","poem":1},{"lineBreak":true},{"text":"The Lord has afflicted me,","poem":1},{"lineBreak":true},{"text":"he has inflicted it on me","poem":1},{"lineBreak":true},{"text":"when he burned with anger.","poem":1}]},{"type":"heading","content":["מ (Mem)"]},{"type":"verse","number":13,"content":[{"text":"He sent down fire","poem":1},{"lineBreak":true},{"text":"into my bones, and it overcame them.","poem":1},{"lineBreak":true},{"text":"He spread out a trapper’s net for my feet;","poem":1},{"lineBreak":true},{"text":"he made me turn back.","poem":1},{"lineBreak":true},{"text":"He has made me desolate;","poem":1},{"lineBreak":true},{"text":"I am faint all day long.","poem":1}]},{"type":"heading","content":["נ (Nun)"]},{"type":"verse","number":14,"content":[{"text":"My sins are bound around my neck like a yoke;","poem":1},{"lineBreak":true},{"text":"they are fastened together by his hand.","poem":1},{"lineBreak":true},{"text":"He has placed his yoke on my neck;","poem":1},{"lineBreak":true},{"text":"he has sapped my strength.","poem":1},{"lineBreak":true},{"text":"The Lord has handed me over","poem":1},{"lineBreak":true},{"text":"to those whom I cannot resist.","poem":1}]},{"type":"heading","content":["ס (Samek)"]},{"type":"verse","number":15,"content":[{"text":"He rounded up all my mighty ones;","poem":1},{"lineBreak":true},{"text":"The Lord did this in my midst.","poem":1},{"lineBreak":true},{"text":"He summoned an assembly against me","poem":1},{"lineBreak":true},{"text":"to shatter my young men.","poem":1},{"lineBreak":true},{"text":"The Lord has stomped like grapes","poem":1},{"lineBreak":true},{"text":"the virgin daughter, Judah.","poem":1}]},{"type":"heading","content":["ע (Ayin)"]},{"type":"verse","number":16,"content":[{"text":"I weep because of these things;","poem":1},{"lineBreak":true},{"text":"my eyes flow with tears.","poem":1},{"lineBreak":true},{"text":"For there is no one in sight who can comfort me","poem":1},{"lineBreak":true},{"text":"or encourage me.","poem":1},{"lineBreak":true},{"text":"My children are desolated","poem":1},{"lineBreak":true},{"text":"because an enemy has prevailed.","poem":1}]},{"type":"heading","content":["The Prophet Speaks:"]},{"type":"heading","content":["פ (Pe)"]},{"type":"verse","number":17,"content":[{"text":"Zion spread out her hands,","poem":1},{"lineBreak":true},{"text":"but there is no one to comfort her.","poem":1},{"lineBreak":true},{"text":"The Lord has issued a decree against Jacob;","poem":1},{"lineBreak":true},{"text":"his neighbors have become his enemies.","poem":1},{"lineBreak":true},{"text":"Jerusalem has become","poem":1},{"lineBreak":true},{"text":"like filthy garbage in their midst.","poem":1}]},{"type":"heading","content":["Jerusalem Speaks:"]},{"type":"heading","content":["צ (Tsade)"]},{"type":"verse","number":18,"content":[{"text":"The Lord is right to judge me!","poem":1},{"lineBreak":true},{"text":"Yes, I rebelled against his commands.","poem":1},{"lineBreak":true},{"text":"Please listen, all you nations,","poem":1},{"lineBreak":true},{"text":"and look at my suffering!","poem":1},{"lineBreak":true},{"text":"My young women and men","poem":1},{"lineBreak":true},{"text":"have gone into exile.","poem":1}]},{"type":"heading","content":["ק (Qof)"]},{"type":"verse","number":19,"content":[{"text":"I called for my lovers,","poem":1},{"lineBreak":true},{"text":"but they had deceived me.","poem":1},{"lineBreak":true},{"text":"My priests and my elders","poem":1},{"lineBreak":true},{"text":"perished in the city.","poem":1},{"lineBreak":true},{"text":"Truly they had searched for food","poem":1},{"lineBreak":true},{"text":"to keep themselves alive.","poem":1}]},{"type":"heading","content":["ר (Resh)"]},{"type":"verse","number":20,"content":[{"text":"Look, O Lord! I am distressed;","poem":1},{"lineBreak":true},{"text":"my stomach is in knots!","poem":1},{"lineBreak":true},{"text":"My heart is pounding inside me.","poem":1},{"lineBreak":true},{"text":"Yes, I was terribly rebellious!","poem":1},{"lineBreak":true},{"text":"Out in the street the sword bereaves a mother of her children;","poem":1},{"lineBreak":true},{"text":"Inside the house death is present.","poem":1}]},{"type":"heading","content":["ש (Sin/Shin)"]},{"type":"verse","number":21,"content":[{"text":"They have heard that I groan,","poem":1},{"lineBreak":true},{"text":"yet there is no one to comfort me.","poem":1},{"lineBreak":true},{"text":"All my enemies have heard of my trouble;","poem":1},{"lineBreak":true},{"text":"they are glad that you have brought it about.","poem":1},{"lineBreak":true},{"text":"Bring about the day of judgment that you promised","poem":1},{"lineBreak":true},{"text":"so that they may end up like me!","poem":1}]},{"type":"heading","content":["ת (Tav)"]},{"type":"verse","number":22,"content":[{"text":"Let all their wickedness come before you;","poem":1},{"lineBreak":true},{"text":"afflict them","poem":1},{"lineBreak":true},{"text":"just as you have afflicted me","poem":1},{"lineBreak":true},{"text":"because of all my acts of rebellion.","poem":1},{"lineBreak":true},{"text":"For my groans are many,","poem":1},{"lineBreak":true},{"text":"and my heart is sick with sorrow.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}