{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"ISA","translationId":"eng_net","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"numberOfChapters":66,"sha256":"ea4e251615388925463825ef0d2a7d79724a53ac239e1a3426d833f517208113","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_net/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Seven women will grab hold of","poem":1},{"lineBreak":true},{"text":"one man at that time.","poem":1},{"lineBreak":true},{"text":"They will say, “We will provide our own food,","poem":1},{"lineBreak":true},{"text":"we will provide our own clothes;","poem":1},{"lineBreak":true},{"text":"but let us belong to you –","poem":1},{"lineBreak":true},{"text":"take away our shame!”","poem":1}]},{"type":"heading","content":["The Branch of the Lord"]},{"type":"verse","number":2,"content":[{"text":"At that time","poem":1},{"lineBreak":true},{"text":"the crops given by the Lord will bring admiration and honor;","poem":1},{"lineBreak":true},{"text":"the produce of the land will be a source of pride and delight","poem":1},{"lineBreak":true},{"text":"to those who remain in Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Those remaining in Zion, those left in Jerusalem,","poem":1},{"lineBreak":true},{"text":"will be called “holy,”","poem":1},{"lineBreak":true},{"text":"all in Jerusalem who are destined to live.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"At that time the sovereign master will wash the excrement from Zion’s women,","poem":1},{"lineBreak":true},{"text":"he will rinse the bloodstains from Jerusalem’s midst,","poem":1},{"lineBreak":true},{"text":"as he comes to judge","poem":1},{"lineBreak":true},{"text":"and to bring devastation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then the Lord will create","poem":1},{"lineBreak":true},{"text":"over all of Mount Zion","poem":1},{"lineBreak":true},{"text":"and over its convocations","poem":1},{"lineBreak":true},{"text":"a cloud and smoke by day","poem":1},{"lineBreak":true},{"text":"and a bright flame of fire by night;","poem":1},{"lineBreak":true},{"text":"indeed a canopy will accompany the Lord’s glorious presence.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"By day it will be a shelter to provide shade from the heat,","poem":1},{"lineBreak":true},{"text":"as well as safety and protection from the heavy downpour.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}