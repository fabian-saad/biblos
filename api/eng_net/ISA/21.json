{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"ISA","translationId":"eng_net","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"numberOfChapters":66,"sha256":"ea4e251615388925463825ef0d2a7d79724a53ac239e1a3426d833f517208113","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_net/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Here is a message about the Desert by the Sea:","poem":1},{"lineBreak":true},{"text":"Like strong winds blowing in the south,","poem":1},{"lineBreak":true},{"text":"one invades from the desert,","poem":1},{"lineBreak":true},{"text":"from a land that is feared.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I have received a distressing message:","poem":1},{"lineBreak":true},{"text":"“The deceiver deceives,","poem":1},{"lineBreak":true},{"text":"the destroyer destroys.","poem":1},{"lineBreak":true},{"text":"Attack, you Elamites!","poem":1},{"lineBreak":true},{"text":"Lay siege, you Medes!","poem":1},{"lineBreak":true},{"text":"I will put an end to all the groaning!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For this reason my stomach churns;","poem":1},{"lineBreak":true},{"text":"cramps overwhelm me","poem":1},{"lineBreak":true},{"text":"like the contractions of a woman in labor.","poem":1},{"lineBreak":true},{"text":"I am disturbed by what I hear,","poem":1},{"lineBreak":true},{"text":"horrified by what I see.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"My heart palpitates,","poem":1},{"lineBreak":true},{"text":"I shake in fear;","poem":1},{"lineBreak":true},{"text":"the twilight I desired","poem":1},{"lineBreak":true},{"text":"has brought me terror.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Arrange the table,","poem":1},{"lineBreak":true},{"text":"lay out the carpet,","poem":1},{"lineBreak":true},{"text":"eat and drink!","poem":1},{"lineBreak":true},{"text":"Get up, you officers,","poem":1},{"lineBreak":true},{"text":"smear oil on the shields!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For this is what the sovereign master has told me:","poem":1},{"lineBreak":true},{"text":"“Go, post a guard!","poem":1},{"lineBreak":true},{"text":"He must report what he sees.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"When he sees chariots,","poem":1},{"lineBreak":true},{"text":"teams of horses,","poem":1},{"lineBreak":true},{"text":"riders on donkeys,","poem":1},{"lineBreak":true},{"text":"riders on camels,","poem":1},{"lineBreak":true},{"text":"he must be alert,","poem":1},{"lineBreak":true},{"text":"very alert.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Then the guard cries out:","poem":1},{"lineBreak":true},{"text":"“On the watchtower, O sovereign master,","poem":1},{"lineBreak":true},{"text":"I stand all day long;","poem":1},{"lineBreak":true},{"text":"at my post","poem":1},{"lineBreak":true},{"text":"I am stationed every night.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Look what’s coming!","poem":1},{"lineBreak":true},{"text":"A charioteer,","poem":1},{"lineBreak":true},{"text":"a team of horses.”","poem":1},{"lineBreak":true},{"text":"When questioned, he replies,","poem":1},{"lineBreak":true},{"text":"“Babylon has fallen, fallen!","poem":1},{"lineBreak":true},{"text":"All the idols of her gods lie shattered on the ground!”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O my downtrodden people, crushed like stalks on the threshing floor,","poem":1},{"lineBreak":true},{"text":"what I have heard","poem":1},{"lineBreak":true},{"text":"from the Lord who commands armies,","poem":1},{"lineBreak":true},{"text":"the God of Israel,","poem":1},{"lineBreak":true},{"text":"I have reported to you.","poem":1}]},{"type":"heading","content":["Bad News for Seir"]},{"type":"verse","number":11,"content":[{"text":"Here is a message about Dumah:","poem":1},{"lineBreak":true},{"text":"Someone calls to me from Seir,","poem":1},{"lineBreak":true},{"text":"“Watchman, what is left of the night?","poem":1},{"lineBreak":true},{"text":"Watchman, what is left of the night?”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"The watchman replies,","poem":1},{"lineBreak":true},{"text":"“Morning is coming, but then night.","poem":1},{"lineBreak":true},{"text":"If you want to ask, ask;","poem":1},{"lineBreak":true},{"text":"come back again.”","poem":1}]},{"type":"heading","content":["The Lord Will Judge Arabia"]},{"type":"verse","number":13,"content":[{"text":"Here is a message about Arabia:","poem":1},{"lineBreak":true},{"text":"In the thicket of Arabia you spend the night,","poem":1},{"lineBreak":true},{"text":"you Dedanite caravans.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bring out some water for the thirsty.","poem":1},{"lineBreak":true},{"text":"You who live in the land of Tema,","poem":1},{"lineBreak":true},{"text":"bring some food for the fugitives.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"For they flee from the swords –","poem":1},{"lineBreak":true},{"text":"from the drawn sword","poem":1},{"lineBreak":true},{"text":"and from the battle-ready bow","poem":1},{"lineBreak":true},{"text":"and from the severity of the battle.","poem":1}]},{"type":"verse","number":16,"content":["For this is what the sovereign master has told me: “Within exactly one year all the splendor of Kedar will come to an end."]},{"type":"verse","number":17,"content":["Just a handful of archers, the warriors of Kedar, will be left.” Indeed, the Lord God of Israel has spoken."]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}