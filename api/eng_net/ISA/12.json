{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"ISA","translationId":"eng_net","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"numberOfChapters":66,"sha256":"ea4e251615388925463825ef0d2a7d79724a53ac239e1a3426d833f517208113","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_net/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"At that time you will say:","poem":1},{"lineBreak":true},{"text":"“I praise you, O Lord,","poem":1},{"lineBreak":true},{"text":"for even though you were angry with me,","poem":1},{"lineBreak":true},{"text":"your anger subsided, and you consoled me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Look, God is my deliverer!","poem":1},{"lineBreak":true},{"text":"I will trust in him and not fear.","poem":1},{"lineBreak":true},{"text":"For the Lord gives me strength and protects me;","poem":1},{"lineBreak":true},{"text":"he has become my deliverer.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Joyfully you will draw water","poem":1},{"lineBreak":true},{"text":"from the springs of deliverance.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"At that time you will say:","poem":1},{"lineBreak":true},{"text":"“Praise the Lord!","poem":1},{"lineBreak":true},{"text":"Ask him for help!","poem":1},{"lineBreak":true},{"text":"Publicize his mighty acts among the nations!","poem":1},{"lineBreak":true},{"text":"Make it known that he is unique!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing to the Lord, for he has done magnificent things,","poem":1},{"lineBreak":true},{"text":"let this be known throughout the earth!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cry out and shout for joy, O citizens of Zion,","poem":1},{"lineBreak":true},{"text":"for the Holy One of Israel acts mightily among you!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}