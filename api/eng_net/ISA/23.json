{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"ISA","translationId":"eng_net","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"numberOfChapters":66,"sha256":"ea4e251615388925463825ef0d2a7d79724a53ac239e1a3426d833f517208113","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_net/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Here is a message about Tyre:","poem":1},{"lineBreak":true},{"text":"Wail, you large ships,","poem":1},{"lineBreak":true},{"text":"for the port is too devastated to enter!","poem":1},{"lineBreak":true},{"text":"From the land of Cyprus this news is announced to them.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lament, you residents of the coast,","poem":1},{"lineBreak":true},{"text":"you merchants of Sidon who travel over the sea,","poem":1},{"lineBreak":true},{"text":"whose agents sail over","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"the deep waters!","poem":1},{"lineBreak":true},{"text":"Grain from the Shihor region,","poem":1},{"lineBreak":true},{"text":"crops grown near the Nile she receives;","poem":1},{"lineBreak":true},{"text":"she is the trade center of the nations.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Be ashamed, O Sidon,","poem":1},{"lineBreak":true},{"text":"for the sea says this, O fortress of the sea:","poem":1},{"lineBreak":true},{"text":"“I have not gone into labor","poem":1},{"lineBreak":true},{"text":"or given birth;","poem":1},{"lineBreak":true},{"text":"I have not raised young men","poem":1},{"lineBreak":true},{"text":"or brought up young women.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"When the news reaches Egypt,","poem":1},{"lineBreak":true},{"text":"they will be shaken by what has happened to Tyre.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Travel to Tarshish!","poem":1},{"lineBreak":true},{"text":"Wail, you residents of the coast!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Is this really your boisterous city","poem":1},{"lineBreak":true},{"text":"whose origins are in the distant past,","poem":1},{"lineBreak":true},{"text":"and whose feet led her to a distant land to reside?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who planned this for royal Tyre,","poem":1},{"lineBreak":true},{"text":"whose merchants are princes,","poem":1},{"lineBreak":true},{"text":"whose traders are the dignitaries of the earth?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord who commands armies planned it –","poem":1},{"lineBreak":true},{"text":"to dishonor the pride that comes from all her beauty,","poem":1},{"lineBreak":true},{"text":"to humiliate all the dignitaries of the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Daughter Tarshish, travel back to your land, as one crosses the Nile;","poem":1},{"lineBreak":true},{"text":"there is no longer any marketplace in Tyre.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord stretched out his hand over the sea,","poem":1},{"lineBreak":true},{"text":"he shook kingdoms;","poem":1},{"lineBreak":true},{"text":"he gave the order","poem":1},{"lineBreak":true},{"text":"to destroy Canaan’s fortresses.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He said,","poem":1},{"lineBreak":true},{"text":"“You will no longer celebrate,","poem":1},{"lineBreak":true},{"text":"oppressed virgin daughter Sidon!","poem":1},{"lineBreak":true},{"text":"Get up, travel to Cyprus,","poem":1},{"lineBreak":true},{"text":"but you will find no relief there.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Look at the land of the Chaldeans,","poem":1},{"lineBreak":true},{"text":"these people who have lost their identity!","poem":1},{"lineBreak":true},{"text":"The Assyrians have made it a home for wild animals.","poem":1},{"lineBreak":true},{"text":"They erected their siege towers,","poem":1},{"lineBreak":true},{"text":"demolished its fortresses,","poem":1},{"lineBreak":true},{"text":"and turned it into a heap of ruins.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wail, you large ships,","poem":1},{"lineBreak":true},{"text":"for your fortress is destroyed!","poem":1}]},{"type":"verse","number":15,"content":["At that time Tyre will be forgotten for seventy years, the typical life span of a king. At the end of seventy years Tyre will try to attract attention again, like the prostitute in the popular song:"]},{"type":"verse","number":16,"content":[{"text":"“Take the harp,","poem":1},{"lineBreak":true},{"text":"go through the city,","poem":1},{"lineBreak":true},{"text":"forgotten prostitute!","poem":1},{"lineBreak":true},{"text":"Play it well,","poem":1},{"lineBreak":true},{"text":"play lots of songs,","poem":1},{"lineBreak":true},{"text":"so you’ll be noticed!”","poem":1}]},{"type":"verse","number":17,"content":["At the end of seventy years the Lord will revive Tyre. She will start making money again by selling her services to all the earth’s kingdoms."]},{"type":"verse","number":18,"content":["Her profits and earnings will be set apart for the Lord. They will not be stored up or accumulated, for her profits will be given to those who live in the Lord’s presence and will be used to purchase large quantities of food and beautiful clothes."]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}