You prepare a feast before me","poem":1},{"lineBreak":true},{"text":"in plain sight of my enemies.","poem":1},{"lineBreak":true},{"text":"You refresh my head with oil;","poem":1},{"lineBreak":true},{"text":"my cup is completely full.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Surely your goodness and faithfulness will pursue me all my days,","poem":1},{"lineBreak":true},{"text":"and I will live in the Lord’s house for the rest of my life.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}