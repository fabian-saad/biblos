{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["A song of ascents."]},{"type":"verse","number":1,"content":[{"text":"O Lord, for David’s sake remember","poem":1},{"lineBreak":true},{"text":"all his strenuous effort,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"and how he made a vow to the Lord,","poem":1},{"lineBreak":true},{"text":"and swore an oath to the powerful ruler of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He said, “I will not enter my own home,","poem":1},{"lineBreak":true},{"text":"or get into my bed.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will not allow my eyes to sleep,","poem":1},{"lineBreak":true},{"text":"or my eyelids to slumber,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"until I find a place for the Lord,","poem":1},{"lineBreak":true},{"text":"a fine dwelling place for the powerful ruler of Jacob.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Look, we heard about it in Ephrathah,","poem":1},{"lineBreak":true},{"text":"we found it in the territory of Jaar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let us go to his dwelling place!","poem":1},{"lineBreak":true},{"text":"Let us worship before his footstool!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ascend, O Lord, to your resting place,","poem":1},{"lineBreak":true},{"text":"you and the ark of your strength!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"May your priests be clothed with integrity!","poem":1},{"lineBreak":true},{"text":"May your loyal followers shout for joy!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For the sake of David, your servant,","poem":1},{"lineBreak":true},{"text":"do not reject your chosen king!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord made a reliable promise to David;","poem":1},{"lineBreak":true},{"text":"he will not go back on his word.","poem":1},{"lineBreak":true},{"text":"He said, “I will place one of your descendants on your throne.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"If your sons keep my covenant","poem":1},{"lineBreak":true},{"text":"and the rules I teach them,","poem":1},{"lineBreak":true},{"text":"their sons will also sit on your throne forever.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Certainly the Lord has chosen Zion;","poem":1},{"lineBreak":true},{"text":"he decided to make it his home.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"He said, “This will be my resting place forever;","poem":1},{"lineBreak":true},{"text":"I will live here, for I have chosen it.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I will abundantly supply what she needs;","poem":1},{"lineBreak":true},{"text":"I will give her poor all the food they need.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I will protect her priests,","poem":1},{"lineBreak":true},{"text":"and her godly people will shout exuberantly.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"There I will make David strong;","poem":1},{"lineBreak":true},{"text":"I have determined that my chosen king’s dynasty will continue.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I will humiliate his enemies,","poem":1},{"lineBreak":true},{"text":"and his crown will shine.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}