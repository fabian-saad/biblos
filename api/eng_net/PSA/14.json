{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["For the music director; by David."]},{"type":"verse","number":1,"content":[{"text":"Fools say to themselves, “There is no God.”","poem":1},{"lineBreak":true},{"text":"They sin and commit evil deeds;","poem":1},{"lineBreak":true},{"text":"none of them does what is right.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord looks down from heaven at the human race,","poem":1},{"lineBreak":true},{"text":"to see if there is anyone who is wise and seeks God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Everyone rejects God;","poem":1},{"lineBreak":true},{"text":"they are all morally corrupt.","poem":1},{"lineBreak":true},{"text":"None of them does what is right,","poem":1},{"lineBreak":true},{"text":"not even one!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"All those who behave wickedly do not understand –","poem":1},{"lineBreak":true},{"text":"those who devour my people as if they were eating bread,","poem":1},{"lineBreak":true},{"text":"and do not call out to the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They are absolutely terrified,","poem":1},{"lineBreak":true},{"text":"for God defends the godly.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"You want to humiliate the oppressed,","poem":1},{"lineBreak":true},{"text":"even though the Lord is their shelter.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I wish the deliverance of Israel would come from Zion!","poem":1},{"lineBreak":true},{"text":"When the Lord restores the well-being of his people,","poem":1},{"lineBreak":true},{"text":"may Jacob rejoice,","poem":1},{"lineBreak":true},{"text":"may Israel be happy!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}