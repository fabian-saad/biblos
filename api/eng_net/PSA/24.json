{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord owns the earth and all it contains,","poem":1},{"lineBreak":true},{"text":"the world and all who live in it.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For he set its foundation upon the seas,","poem":1},{"lineBreak":true},{"text":"and established it upon the ocean currents.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Who is allowed to ascend the mountain of the Lord?","poem":1},{"lineBreak":true},{"text":"Who may go up to his holy dwelling place?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The one whose deeds are blameless","poem":1},{"lineBreak":true},{"text":"and whose motives are pure,","poem":1},{"lineBreak":true},{"text":"who does not lie,","poem":1},{"lineBreak":true},{"text":"or make promises with no intention of keeping them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Such godly people are rewarded by the Lord,","poem":1},{"lineBreak":true},{"text":"and vindicated by the God who delivers them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Such purity characterizes the people who seek his favor,","poem":1},{"lineBreak":true},{"text":"Jacob’s descendants, who pray to him. (Selah)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Look up, you gates!","poem":1},{"lineBreak":true},{"text":"Rise up, you eternal doors!","poem":1},{"lineBreak":true},{"text":"Then the majestic king will enter!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who is this majestic king?","poem":1},{"lineBreak":true},{"text":"The Lord who is strong and mighty!","poem":1},{"lineBreak":true},{"text":"The Lord who is mighty in battle!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Look up, you gates!","poem":1},{"lineBreak":true},{"text":"Rise up, you eternal doors!","poem":1},{"lineBreak":true},{"text":"Then the majestic king will enter!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who is this majestic king?","poem":1},{"lineBreak":true},{"text":"The Lord who commands armies!","poem":1},{"lineBreak":true},{"text":"He is the majestic king! (Selah)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}