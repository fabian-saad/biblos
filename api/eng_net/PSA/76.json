{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["For the music director; to be accompanied by stringed instruments; a psalm of Asaph, a song."]},{"type":"verse","number":1,"content":[{"text":"God has revealed himself in Judah;","poem":1},{"lineBreak":true},{"text":"in Israel his reputation is great.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He lives in Salem;","poem":1},{"lineBreak":true},{"text":"he dwells in Zion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"There he shattered the arrows,","poem":1},{"lineBreak":true},{"text":"the shield, the sword, and the rest of the weapons of war. (Selah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"You shine brightly and reveal your majesty,","poem":1},{"lineBreak":true},{"text":"as you descend from the hills where you killed your prey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The bravehearted were plundered;","poem":1},{"lineBreak":true},{"text":"they “fell asleep.”","poem":1},{"lineBreak":true},{"text":"All the warriors were helpless.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"At the sound of your battle cry, O God of Jacob,","poem":1},{"lineBreak":true},{"text":"both rider and horse “fell asleep.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"You are awesome! Yes, you!","poem":1},{"lineBreak":true},{"text":"Who can withstand your intense anger?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"From heaven you announced what their punishment would be.","poem":1},{"lineBreak":true},{"text":"The earth was afraid and silent","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"when God arose to execute judgment,","poem":1},{"lineBreak":true},{"text":"and to deliver all the oppressed of the earth. (Selah)","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Certainly your angry judgment upon men will bring you praise;","poem":1},{"lineBreak":true},{"text":"you reveal your anger in full measure.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Make vows to the Lord your God and repay them!","poem":1},{"lineBreak":true},{"text":"Let all those who surround him bring tribute to the awesome one!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He humbles princes;","poem":1},{"lineBreak":true},{"text":"the kings of the earth regard him as awesome.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}