{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"Praise the Lord, O my soul!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will praise the Lord as long as I live!","poem":1},{"lineBreak":true},{"text":"I will sing praises to my God as long as I exist!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Do not trust in princes,","poem":1},{"lineBreak":true},{"text":"or in human beings, who cannot deliver!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their life’s breath departs, they return to the ground;","poem":1},{"lineBreak":true},{"text":"on that day their plans die.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"How blessed is the one whose helper is the God of Jacob,","poem":1},{"lineBreak":true},{"text":"whose hope is in the Lord his God,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"the one who made heaven and earth,","poem":1},{"lineBreak":true},{"text":"the sea, and all that is in them,","poem":1},{"lineBreak":true},{"text":"who remains forever faithful,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"vindicates the oppressed,","poem":1},{"lineBreak":true},{"text":"and gives food to the hungry.","poem":1},{"lineBreak":true},{"text":"The Lord releases the imprisoned.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord gives sight to the blind.","poem":1},{"lineBreak":true},{"text":"The Lord lifts up all who are bent over.","poem":1},{"lineBreak":true},{"text":"The Lord loves the godly.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord protects those residing outside their native land;","poem":1},{"lineBreak":true},{"text":"he lifts up the fatherless and the widow,","poem":1},{"lineBreak":true},{"text":"but he opposes the wicked.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord rules forever,","poem":1},{"lineBreak":true},{"text":"your God, O Zion, throughout the generations to come!","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}