[{"lineBreak":true},{"text":"May the Lord bless you from Zion,","poem":1},{"lineBreak":true},{"text":"that you might see Jerusalem prosper","poem":1},{"lineBreak":true},{"text":"all the days of your life,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"and that you might see your grandchildren.","poem":1},{"lineBreak":true},{"text":"May Israel experience peace!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}