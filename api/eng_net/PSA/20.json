{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["For the music director; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"May the Lord answer you when you are in trouble;","poem":1},{"lineBreak":true},{"text":"may the God of Jacob make you secure!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"May he send you help from his temple;","poem":1},{"lineBreak":true},{"text":"from Zion may he give you support!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May he take notice of your offerings;","poem":1},{"lineBreak":true},{"text":"may he accept your burnt sacrifice! (Selah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"May he grant your heart’s desire;","poem":1},{"lineBreak":true},{"text":"may he bring all your plans to pass!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then we will shout for joy over your victory;","poem":1},{"lineBreak":true},{"text":"we will rejoice in the name of our God!","poem":1},{"lineBreak":true},{"text":"May the Lord grant all your requests!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Now I am sure that the Lord will deliver his chosen king;","poem":1},{"lineBreak":true},{"text":"he will intervene for him from his holy heavenly temple,","poem":1},{"lineBreak":true},{"text":"and display his mighty ability to deliver.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Some trust in chariots and others in horses,","poem":1},{"lineBreak":true},{"text":"but we depend on the Lord our God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They will fall down,","poem":1},{"lineBreak":true},{"text":"but we will stand firm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord will deliver the king;","poem":1},{"lineBreak":true},{"text":"he will answer us when we call to him for help!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}