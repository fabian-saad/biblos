{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["A psalm of David, written when he was in the Judean wilderness."]},{"type":"verse","number":1,"content":[{"text":"O God, you are my God! I long for you!","poem":1},{"lineBreak":true},{"text":"My soul thirsts for you,","poem":1},{"lineBreak":true},{"text":"my flesh yearns for you,","poem":1},{"lineBreak":true},{"text":"in a dry and parched land where there is no water.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yes, in the sanctuary I have seen you,","poem":1},{"lineBreak":true},{"text":"and witnessed your power and splendor.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Because experiencing your loyal love is better than life itself,","poem":1},{"lineBreak":true},{"text":"my lips will praise you.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For this reason I will praise you while I live;","poem":1},{"lineBreak":true},{"text":"in your name I will lift up my hands.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As if with choice meat you satisfy my soul.","poem":1},{"lineBreak":true},{"text":"My mouth joyfully praises you,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"whenever I remember you on my bed,","poem":1},{"lineBreak":true},{"text":"and think about you during the nighttime hours.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For you are my deliverer;","poem":1},{"lineBreak":true},{"text":"under your wings I rejoice.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My soul pursues you;","poem":1},{"lineBreak":true},{"text":"your right hand upholds me.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Enemies seek to destroy my life,","poem":1},{"lineBreak":true},{"text":"but they will descend into the depths of the earth.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Each one will be handed over to the sword;","poem":1},{"lineBreak":true},{"text":"their corpses will be eaten by jackals.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But the king will rejoice in God;","poem":1},{"lineBreak":true},{"text":"everyone who takes oaths in his name will boast,","poem":1},{"lineBreak":true},{"text":"for the mouths of those who speak lies will be shut up.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}