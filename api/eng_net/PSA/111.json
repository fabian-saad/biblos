{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"I will give thanks to the Lord with my whole heart,","poem":1},{"lineBreak":true},{"text":"in the assembly of the godly and the congregation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord’s deeds are great,","poem":1},{"lineBreak":true},{"text":"eagerly awaited by all who desire them.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"His work is majestic and glorious,","poem":1},{"lineBreak":true},{"text":"and his faithfulness endures forever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He does amazing things that will be remembered;","poem":1},{"lineBreak":true},{"text":"the Lord is merciful and compassionate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He gives food to his faithful followers;","poem":1},{"lineBreak":true},{"text":"he always remembers his covenant.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He announced that he would do mighty deeds for his people,","poem":1},{"lineBreak":true},{"text":"giving them a land that belonged to other nations.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"His acts are characterized by faithfulness and justice;","poem":1},{"lineBreak":true},{"text":"all his precepts are reliable.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They are forever firm,","poem":1},{"lineBreak":true},{"text":"and should be faithfully and properly carried out.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He delivered his people;","poem":1},{"lineBreak":true},{"text":"he ordained that his covenant be observed forever.","poem":1},{"lineBreak":true},{"text":"His name is holy and awesome.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"To obey the Lord is the fundamental principle for wise living;","poem":1},{"lineBreak":true},{"text":"all who carry out his precepts acquire good moral insight.","poem":1},{"lineBreak":true},{"text":"He will receive praise forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}