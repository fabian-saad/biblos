{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Lord, who may be a guest in your home?","poem":1},{"lineBreak":true},{"text":"Who may live on your holy hill?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Whoever lives a blameless life,","poem":1},{"lineBreak":true},{"text":"does what is right,","poem":1},{"lineBreak":true},{"text":"and speaks honestly.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He does not slander,","poem":1},{"lineBreak":true},{"text":"or do harm to others,","poem":1},{"lineBreak":true},{"text":"or insult his neighbor.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He despises a reprobate,","poem":1},{"lineBreak":true},{"text":"but honors the Lord’s loyal followers.","poem":1},{"lineBreak":true},{"text":"He makes firm commitments and does not renege on his promise.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He does not charge interest when he lends his money.","poem":1},{"lineBreak":true},{"text":"He does not take bribes to testify against the innocent.","poem":1},{"lineBreak":true},{"text":"The one who lives like this will never be upended.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}