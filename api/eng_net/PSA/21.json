{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["For the music director; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, the king rejoices in the strength you give;","poem":1},{"lineBreak":true},{"text":"he takes great delight in the deliverance you provide.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"You grant him his heart’s desire;","poem":1},{"lineBreak":true},{"text":"you do not refuse his request. (Selah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For you bring him rich blessings;","poem":1},{"lineBreak":true},{"text":"you place a golden crown on his head.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He asked you to sustain his life,","poem":1},{"lineBreak":true},{"text":"and you have granted him long life and an enduring dynasty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Your deliverance brings him great honor;","poem":1},{"lineBreak":true},{"text":"you give him majestic splendor.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For you grant him lasting blessings;","poem":1},{"lineBreak":true},{"text":"you give him great joy by allowing him into your presence.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For the king trusts in the Lord,","poem":1},{"lineBreak":true},{"text":"and because of the sovereign Lord’s faithfulness he is not upended.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"You prevail over all your enemies;","poem":1},{"lineBreak":true},{"text":"your power is too great for those who hate you.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"You burn them up like a fiery furnace when you appear;","poem":1},{"lineBreak":true},{"text":"the Lord angrily devours them;","poem":1},{"lineBreak":true},{"text":"the fire consumes them.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"You destroy their offspring from the earth,","poem":1},{"lineBreak":true},{"text":"their descendants from among the human race.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yes, they intend to do you harm;","poem":1},{"lineBreak":true},{"text":"they dream up a scheme, but they do not succeed.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"For you make them retreat","poem":1},{"lineBreak":true},{"text":"when you shoot your arrows at them.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rise up, O Lord, in strength!","poem":1},{"lineBreak":true},{"text":"We will sing and praise your power!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}