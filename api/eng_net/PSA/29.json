{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Acknowledge the Lord, you heavenly beings,","poem":1},{"lineBreak":true},{"text":"acknowledge the Lord’s majesty and power!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Acknowledge the majesty of the Lord’s reputation!","poem":1},{"lineBreak":true},{"text":"Worship the Lord in holy attire!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord’s shout is heard over the water;","poem":1},{"lineBreak":true},{"text":"the majestic God thunders,","poem":1},{"lineBreak":true},{"text":"the Lord appears over the surging water.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord’s shout is powerful,","poem":1},{"lineBreak":true},{"text":"the Lord’s shout is majestic.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord’s shout breaks the cedars,","poem":1},{"lineBreak":true},{"text":"the Lord shatters the cedars of Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He makes Lebanon skip like a calf","poem":1},{"lineBreak":true},{"text":"and Sirion like a young ox.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord’s shout strikes with flaming fire.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord’s shout shakes the wilderness,","poem":1},{"lineBreak":true},{"text":"the Lord shakes the wilderness of Kadesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord’s shout bends the large trees","poem":1},{"lineBreak":true},{"text":"and strips the leaves from the forests.","poem":1},{"lineBreak":true},{"text":"Everyone in his temple says, “Majestic!”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The Lord sits enthroned over the engulfing waters,","poem":1},{"lineBreak":true},{"text":"the Lord sits enthroned as the eternal king.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The Lord gives his people strength;","poem":1},{"lineBreak":true},{"text":"the Lord grants his people security.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}