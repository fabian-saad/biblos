{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Come! Let’s sing for joy to the Lord!","poem":1},{"lineBreak":true},{"text":"Let’s shout out praises to our protector who delivers us!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let’s enter his presence with thanksgiving!","poem":1},{"lineBreak":true},{"text":"Let’s shout out to him in celebration!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the Lord is a great God,","poem":1},{"lineBreak":true},{"text":"a great king who is superior to all gods.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The depths of the earth are in his hand,","poem":1},{"lineBreak":true},{"text":"and the mountain peaks belong to him.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The sea is his, for he made it.","poem":1},{"lineBreak":true},{"text":"His hands formed the dry land.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Come! Let’s bow down and worship!","poem":1},{"lineBreak":true},{"text":"Let’s kneel before the Lord, our creator!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he is our God;","poem":1},{"lineBreak":true},{"text":"we are the people of his pasture,","poem":1},{"lineBreak":true},{"text":"the sheep he owns.","poem":1},{"lineBreak":true},{"text":"Today, if only you would obey him!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He says, “Do not be stubborn like they were at Meribah,","poem":1},{"lineBreak":true},{"text":"like they were that day at Massah in the wilderness,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"where your ancestors challenged my authority,","poem":1},{"lineBreak":true},{"text":"and tried my patience, even though they had seen my work.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For forty years I was continually disgusted with that generation,","poem":1},{"lineBreak":true},{"text":"and I said, ‘These people desire to go astray;","poem":1},{"lineBreak":true},{"text":"they do not obey my commands.’","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"So I made a vow in my anger,","poem":1},{"lineBreak":true},{"text":"‘They will never enter into the resting place I had set aside for them.’”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}