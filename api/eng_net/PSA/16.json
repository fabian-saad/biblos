{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["A prayer of David."]},{"type":"verse","number":1,"content":[{"text":"Protect me, O God, for I have taken shelter in you.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I say to the Lord, “You are the Lord,","poem":1},{"lineBreak":true},{"text":"my only source of well-being.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"As for God’s chosen people who are in the land,","poem":1},{"lineBreak":true},{"text":"and the leading officials I admired so much –","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"their troubles multiply,","poem":1},{"lineBreak":true},{"text":"they desire other gods.","poem":1},{"lineBreak":true},{"text":"I will not pour out drink offerings of blood to their gods,","poem":1},{"lineBreak":true},{"text":"nor will I make vows in the name of their gods.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lord, you give me stability and prosperity;","poem":1},{"lineBreak":true},{"text":"you make my future secure.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"It is as if I have been given fertile fields","poem":1},{"lineBreak":true},{"text":"or received a beautiful tract of land.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will praise the Lord who guides me;","poem":1},{"lineBreak":true},{"text":"yes, during the night I reflect and learn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I constantly trust in the Lord;","poem":1},{"lineBreak":true},{"text":"because he is at my right hand, I will not be upended.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"So my heart rejoices","poem":1},{"lineBreak":true},{"text":"and I am happy;","poem":1},{"lineBreak":true},{"text":"My life is safe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"You will not abandon me to Sheol;","poem":1},{"lineBreak":true},{"text":"you will not allow your faithful follower to see the Pit.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"You lead me in the path of life;","poem":1},{"lineBreak":true},{"text":"I experience absolute joy in your presence;","poem":1},{"lineBreak":true},{"text":"you always give me sheer delight.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}