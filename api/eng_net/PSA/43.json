{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Vindicate me, O God!","poem":1},{"lineBreak":true},{"text":"Fight for me against an ungodly nation!","poem":1},{"lineBreak":true},{"text":"Deliver me from deceitful and evil men!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For you are the God who shelters me.","poem":1},{"lineBreak":true},{"text":"Why do you reject me?","poem":1},{"lineBreak":true},{"text":"Why must I walk around mourning","poem":1},{"lineBreak":true},{"text":"because my enemies oppress me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Reveal your light and your faithfulness!","poem":1},{"lineBreak":true},{"text":"They will lead me,","poem":1},{"lineBreak":true},{"text":"they will escort me back to your holy hill,","poem":1},{"lineBreak":true},{"text":"and to the place where you live.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then I will go to the altar of God,","poem":1},{"lineBreak":true},{"text":"to the God who gives me ecstatic joy,","poem":1},{"lineBreak":true},{"text":"so that I express my thanks to you, O God, my God, with a harp.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why are you depressed, O my soul?","poem":1},{"lineBreak":true},{"text":"Why are you upset?","poem":1},{"lineBreak":true},{"text":"Wait for God!","poem":1},{"lineBreak":true},{"text":"For I will again give thanks","poem":1},{"lineBreak":true},{"text":"to my God for his saving intervention.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}