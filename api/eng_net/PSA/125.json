{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["A song of ascents."]},{"type":"verse","number":1,"content":[{"text":"Those who trust in the Lord are like Mount Zion;","poem":1},{"lineBreak":true},{"text":"it cannot be upended and will endure forever.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"As the mountains surround Jerusalem,","poem":1},{"lineBreak":true},{"text":"so the Lord surrounds his people,","poem":1},{"lineBreak":true},{"text":"now and forevermore.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Indeed, the scepter of a wicked king will not settle","poem":1},{"lineBreak":true},{"text":"upon the allotted land of the godly.","poem":1},{"lineBreak":true},{"text":"Otherwise the godly might","poem":1},{"lineBreak":true},{"text":"do what is wrong.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Do good, O Lord, to those who are good,","poem":1},{"lineBreak":true},{"text":"to the morally upright!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As for those who are bent on traveling a sinful path,","poem":1},{"lineBreak":true},{"text":"may the Lord remove them, along with those who behave wickedly!","poem":1},{"lineBreak":true},{"text":"May Israel experience peace!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}