{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A song of ascents."]},{"type":"verse","number":1,"content":[{"text":"From the deep water I cry out to you, O Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Lord, listen to me!","poem":1},{"lineBreak":true},{"text":"Pay attention to my plea for mercy!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If you, O Lord, were to keep track of sins,","poem":1},{"lineBreak":true},{"text":"O Lord, who could stand before you?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But you are willing to forgive,","poem":1},{"lineBreak":true},{"text":"so that you might be honored.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I rely on the Lord,","poem":1},{"lineBreak":true},{"text":"I rely on him with my whole being;","poem":1},{"lineBreak":true},{"text":"I wait for his assuring word.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I yearn for the Lord,","poem":1},{"lineBreak":true},{"text":"more than watchmen do for the morning,","poem":1},{"lineBreak":true},{"text":"yes, more than watchmen do for the morning.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Israel, hope in the Lord,","poem":1},{"lineBreak":true},{"text":"for the Lord exhibits loyal love,","poem":1},{"lineBreak":true},{"text":"and is more than willing to deliver.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He will deliver Israel","poem":1},{"lineBreak":true},{"text":"from all the consequences of their sins.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}