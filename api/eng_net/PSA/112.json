{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"How blessed is the one who obeys the Lord,","poem":1},{"lineBreak":true},{"text":"who takes great delight in keeping his commands.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"His descendants will be powerful on the earth;","poem":1},{"lineBreak":true},{"text":"the godly will be blessed.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"His house contains wealth and riches;","poem":1},{"lineBreak":true},{"text":"his integrity endures.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In the darkness a light shines for the godly,","poem":1},{"lineBreak":true},{"text":"for each one who is merciful, compassionate, and just.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"It goes well for the one who generously lends money,","poem":1},{"lineBreak":true},{"text":"and conducts his business honestly.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For he will never be upended;","poem":1},{"lineBreak":true},{"text":"others will always remember one who is just.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He does not fear bad news.","poem":1},{"lineBreak":true},{"text":"He is confident; he trusts in the Lord.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"His resolve is firm; he will not succumb to fear","poem":1},{"lineBreak":true},{"text":"before he looks in triumph on his enemies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He generously gives to the needy;","poem":1},{"lineBreak":true},{"text":"his integrity endures.","poem":1},{"lineBreak":true},{"text":"He will be vindicated and honored.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"When the wicked see this, they will worry;","poem":1},{"lineBreak":true},{"text":"they will grind their teeth in frustration and melt away;","poem":1},{"lineBreak":true},{"text":"the desire of the wicked will perish.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}