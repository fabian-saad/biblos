{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Not to us, O Lord, not to us!","poem":1},{"lineBreak":true},{"text":"But to your name bring honor,","poem":1},{"lineBreak":true},{"text":"for the sake of your loyal love and faithfulness.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Why should the nations say,","poem":1},{"lineBreak":true},{"text":"“Where is their God?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Our God is in heaven!","poem":1},{"lineBreak":true},{"text":"He does whatever he pleases!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their idols are made of silver and gold –","poem":1},{"lineBreak":true},{"text":"they are man-made.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They have mouths, but cannot speak,","poem":1},{"lineBreak":true},{"text":"eyes, but cannot see,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ears, but cannot hear,","poem":1},{"lineBreak":true},{"text":"noses, but cannot smell,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"hands, but cannot touch,","poem":1},{"lineBreak":true},{"text":"feet, but cannot walk.","poem":1},{"lineBreak":true},{"text":"They cannot even clear their throats.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Those who make them will end up like them,","poem":1},{"lineBreak":true},{"text":"as will everyone who trusts in them.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Israel, trust in the Lord!","poem":1},{"lineBreak":true},{"text":"He is their deliverer and protector.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O family of Aaron, trust in the Lord!","poem":1},{"lineBreak":true},{"text":"He is their deliverer and protector.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"You loyal followers of the Lord, trust in the Lord!","poem":1},{"lineBreak":true},{"text":"He is their deliverer and protector.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"The Lord takes notice of us, he will bless –","poem":1},{"lineBreak":true},{"text":"he will bless the family of Israel,","poem":1},{"lineBreak":true},{"text":"he will bless the family of Aaron.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"He will bless his loyal followers,","poem":1},{"lineBreak":true},{"text":"both young and old.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"May he increase your numbers,","poem":1},{"lineBreak":true},{"text":"yours and your children’s!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"May you be blessed by the Lord,","poem":1},{"lineBreak":true},{"text":"the creator of heaven and earth!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"The heavens belong to the Lord,","poem":1},{"lineBreak":true},{"text":"but the earth he has given to mankind.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"The dead do not praise the Lord,","poem":1},{"lineBreak":true},{"text":"nor do any of those who descend into the silence of death.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"But we will praise the Lord","poem":1},{"lineBreak":true},{"text":"now and forevermore.","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}