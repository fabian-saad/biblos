{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["A psalm."]},{"type":"verse","number":1,"content":[{"text":"Sing to the Lord a new song,","poem":1},{"lineBreak":true},{"text":"for he performs amazing deeds!","poem":1},{"lineBreak":true},{"text":"His right hand and his mighty arm","poem":1},{"lineBreak":true},{"text":"accomplish deliverance.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord demonstrates his power to deliver;","poem":1},{"lineBreak":true},{"text":"in the sight of the nations he reveals his justice.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He remains loyal and faithful to the family of Israel.","poem":1},{"lineBreak":true},{"text":"All the ends of the earth see our God deliver us.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Shout out praises to the Lord, all the earth!","poem":1},{"lineBreak":true},{"text":"Break out in a joyful shout and sing!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing to the Lord accompanied by a harp,","poem":1},{"lineBreak":true},{"text":"accompanied by a harp and the sound of music!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"With trumpets and the blaring of the ram’s horn,","poem":1},{"lineBreak":true},{"text":"shout out praises before the king, the Lord!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let the sea and everything in it shout,","poem":1},{"lineBreak":true},{"text":"along with the world and those who live in it!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Let the rivers clap their hands!","poem":1},{"lineBreak":true},{"text":"Let the mountains sing in unison","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"before the Lord!","poem":1},{"lineBreak":true},{"text":"For he comes to judge the earth!","poem":1},{"lineBreak":true},{"text":"He judges the world fairly,","poem":1},{"lineBreak":true},{"text":"and the nations in a just manner.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}