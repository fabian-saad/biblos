{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["For the music director; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, rescue me from wicked men!","poem":1},{"lineBreak":true},{"text":"Protect me from violent men,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"who plan ways to harm me.","poem":1},{"lineBreak":true},{"text":"All day long they stir up conflict.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Their tongues wound like a serpent;","poem":1},{"lineBreak":true},{"text":"a viper’s venom is behind their lips. (Selah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O Lord, shelter me from the power of the wicked!","poem":1},{"lineBreak":true},{"text":"Protect me from violent men,","poem":1},{"lineBreak":true},{"text":"who plan to knock me over.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Proud men hide a snare for me;","poem":1},{"lineBreak":true},{"text":"evil men spread a net by the path;","poem":1},{"lineBreak":true},{"text":"they set traps for me. (Selah)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I say to the Lord, “You are my God.”","poem":1},{"lineBreak":true},{"text":"O Lord, pay attention to my plea for mercy!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O sovereign Lord, my strong deliverer,","poem":1},{"lineBreak":true},{"text":"you shield my head in the day of battle.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord, do not let the wicked have their way!","poem":1},{"lineBreak":true},{"text":"Do not allow their plan to succeed when they attack! (Selah)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"As for the heads of those who surround me –","poem":1},{"lineBreak":true},{"text":"may the harm done by their lips overwhelm them!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"May he rain down fiery coals upon them!","poem":1},{"lineBreak":true},{"text":"May he throw them into the fire!","poem":1},{"lineBreak":true},{"text":"From bottomless pits they will not escape.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A slanderer will not endure on the earth;","poem":1},{"lineBreak":true},{"text":"calamity will hunt down a violent man and strike him down.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I know that the Lord defends the cause of the oppressed","poem":1},{"lineBreak":true},{"text":"and vindicates the poor.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Certainly the godly will give thanks to your name;","poem":1},{"lineBreak":true},{"text":"the morally upright will live in your presence.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}