{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["A song, a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I am determined, O God!","poem":1},{"lineBreak":true},{"text":"I will sing and praise you with my whole heart.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Awake, O stringed instrument and harp!","poem":1},{"lineBreak":true},{"text":"I will wake up at dawn!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will give you thanks before the nations, O Lord!","poem":1},{"lineBreak":true},{"text":"I will sing praises to you before foreigners!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For your loyal love extends beyond the sky,","poem":1},{"lineBreak":true},{"text":"and your faithfulness reaches the clouds.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rise up above the sky, O God!","poem":1},{"lineBreak":true},{"text":"May your splendor cover the whole earth!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Deliver by your power and answer me,","poem":1},{"lineBreak":true},{"text":"so that the ones you love may be safe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God has spoken in his sanctuary:","poem":1},{"lineBreak":true},{"text":"“I will triumph! I will parcel out Shechem,","poem":1},{"lineBreak":true},{"text":"the valley of Succoth I will measure off.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gilead belongs to me,","poem":1},{"lineBreak":true},{"text":"as does Manasseh!","poem":1},{"lineBreak":true},{"text":"Ephraim is my helmet,","poem":1},{"lineBreak":true},{"text":"Judah my royal scepter.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moab is my wash basin.","poem":1},{"lineBreak":true},{"text":"I will make Edom serve me.","poem":1},{"lineBreak":true},{"text":"I will shout in triumph over Philistia.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Who will lead me into the fortified city?","poem":1},{"lineBreak":true},{"text":"Who will bring me to Edom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Have you not rejected us, O God?","poem":1},{"lineBreak":true},{"text":"O God, you do not go into battle with our armies.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Give us help against the enemy,","poem":1},{"lineBreak":true},{"text":"for any help men might offer is futile.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"By God’s power we will conquer;","poem":1},{"lineBreak":true},{"text":"he will trample down our enemies.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}