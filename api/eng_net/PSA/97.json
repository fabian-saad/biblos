{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord reigns!","poem":1},{"lineBreak":true},{"text":"Let the earth be happy!","poem":1},{"lineBreak":true},{"text":"Let the many coastlands rejoice!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dark clouds surround him;","poem":1},{"lineBreak":true},{"text":"equity and justice are the foundation of his throne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fire goes before him;","poem":1},{"lineBreak":true},{"text":"on every side it burns up his enemies.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"His lightning bolts light up the world;","poem":1},{"lineBreak":true},{"text":"the earth sees and trembles.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The mountains melt like wax before the Lord,","poem":1},{"lineBreak":true},{"text":"before the Lord of the whole earth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The sky declares his justice,","poem":1},{"lineBreak":true},{"text":"and all the nations see his splendor.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"All who worship idols are ashamed,","poem":1},{"lineBreak":true},{"text":"those who boast about worthless idols.","poem":1},{"lineBreak":true},{"text":"All the gods bow down before him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zion hears and rejoices,","poem":1},{"lineBreak":true},{"text":"the towns of Judah are happy,","poem":1},{"lineBreak":true},{"text":"because of your judgments, O Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For you, O Lord, are the sovereign king over the whole earth;","poem":1},{"lineBreak":true},{"text":"you are elevated high above all gods.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"You who love the Lord, hate evil!","poem":1},{"lineBreak":true},{"text":"He protects the lives of his faithful followers;","poem":1},{"lineBreak":true},{"text":"he delivers them from the power of the wicked.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"The godly bask in the light;","poem":1},{"lineBreak":true},{"text":"the morally upright experience joy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"You godly ones, rejoice in the Lord!","poem":1},{"lineBreak":true},{"text":"Give thanks to his holy name.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}