{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon","poem":1},{"lineBreak":true},{"text":"we sit down and weep","poem":1},{"lineBreak":true},{"text":"when we remember Zion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"On the poplars in her midst","poem":1},{"lineBreak":true},{"text":"we hang our harps,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"for there our captors ask us to compose songs;","poem":1},{"lineBreak":true},{"text":"those who mock us demand that we be happy, saying:","poem":1},{"lineBreak":true},{"text":"“Sing for us a song about Zion!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How can we sing a song to the Lord","poem":1},{"lineBreak":true},{"text":"in a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, O Jerusalem,","poem":1},{"lineBreak":true},{"text":"may my right hand be crippled!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May my tongue stick to the roof of my mouth,","poem":1},{"lineBreak":true},{"text":"if I do not remember you,","poem":1},{"lineBreak":true},{"text":"and do not give Jerusalem priority","poem":1},{"lineBreak":true},{"text":"over whatever gives me the most joy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Remember, O Lord, what the Edomites did","poem":1},{"lineBreak":true},{"text":"on the day Jerusalem fell.","poem":1},{"lineBreak":true},{"text":"They said, “Tear it down, tear it down,","poem":1},{"lineBreak":true},{"text":"right to its very foundation!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O daughter Babylon, soon to be devastated!","poem":1},{"lineBreak":true},{"text":"How blessed will be the one who repays you","poem":1},{"lineBreak":true},{"text":"for what you dished out to us!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"How blessed will be the one who grabs your babies","poem":1},{"lineBreak":true},{"text":"and smashes them on a rock!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}