{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A song of ascents."]},{"type":"verse","number":1,"content":[{"text":"In my distress I cried out","poem":1},{"lineBreak":true},{"text":"to the Lord and he answered me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I said, “O Lord, rescue me","poem":1},{"lineBreak":true},{"text":"from those who lie with their lips","poem":1},{"lineBreak":true},{"text":"and those who deceive with their tongue.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"How will he severely punish you,","poem":1},{"lineBreak":true},{"text":"you deceptive talker?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Here’s how! With the sharp arrows of warriors,","poem":1},{"lineBreak":true},{"text":"with arrowheads forged over the hot coals.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"How miserable I am!","poem":1},{"lineBreak":true},{"text":"For I have lived temporarily in Meshech;","poem":1},{"lineBreak":true},{"text":"I have resided among the tents of Kedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For too long I have had to reside","poem":1},{"lineBreak":true},{"text":"with those who hate peace.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I am committed to peace,","poem":1},{"lineBreak":true},{"text":"but when I speak, they want to make war.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}