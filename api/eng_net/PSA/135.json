{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"Praise the name of the Lord!","poem":1},{"lineBreak":true},{"text":"Offer praise, you servants of the Lord,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"who serve in the Lord’s temple,","poem":1},{"lineBreak":true},{"text":"in the courts of the temple of our God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise the Lord, for the Lord is good!","poem":1},{"lineBreak":true},{"text":"Sing praises to his name, for it is pleasant!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Indeed, the Lord has chosen Jacob for himself,","poem":1},{"lineBreak":true},{"text":"Israel to be his special possession.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yes, I know the Lord is great,","poem":1},{"lineBreak":true},{"text":"and our Lord is superior to all gods.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He does whatever he pleases","poem":1},{"lineBreak":true},{"text":"in heaven and on earth,","poem":1},{"lineBreak":true},{"text":"in the seas and all the ocean depths.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He causes the clouds to arise from the end of the earth,","poem":1},{"lineBreak":true},{"text":"makes lightning bolts accompany the rain,","poem":1},{"lineBreak":true},{"text":"and brings the wind out of his storehouses.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He struck down the firstborn of Egypt,","poem":1},{"lineBreak":true},{"text":"including both men and animals.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He performed awesome deeds and acts of judgment","poem":1},{"lineBreak":true},{"text":"in your midst, O Egypt,","poem":1},{"lineBreak":true},{"text":"against Pharaoh and all his servants.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"He defeated many nations,","poem":1},{"lineBreak":true},{"text":"and killed mighty kings –","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sihon, king of the Amorites,","poem":1},{"lineBreak":true},{"text":"and Og, king of Bashan,","poem":1},{"lineBreak":true},{"text":"and all the kingdoms of Canaan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"He gave their land as an inheritance,","poem":1},{"lineBreak":true},{"text":"as an inheritance to Israel his people.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O Lord, your name endures,","poem":1},{"lineBreak":true},{"text":"your reputation, O Lord, lasts.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"For the Lord vindicates his people,","poem":1},{"lineBreak":true},{"text":"and has compassion on his servants.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"The nations’ idols are made of silver and gold,","poem":1},{"lineBreak":true},{"text":"they are man-made.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"They have mouths, but cannot speak,","poem":1},{"lineBreak":true},{"text":"eyes, but cannot see,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"and ears, but cannot hear.","poem":1},{"lineBreak":true},{"text":"Indeed, they cannot breathe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Those who make them will end up like them,","poem":1},{"lineBreak":true},{"text":"as will everyone who trusts in them.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O family of Israel, praise the Lord!","poem":1},{"lineBreak":true},{"text":"O family of Aaron, praise the Lord!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O family of Levi, praise the Lord!","poem":1},{"lineBreak":true},{"text":"You loyal followers of the Lord, praise the Lord!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"The Lord deserves praise in Zion –","poem":1},{"lineBreak":true},{"text":"he who dwells in Jerusalem.","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}