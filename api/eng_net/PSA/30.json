{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["A psalm – a song used at the dedication of the temple; by David."]},{"type":"verse","number":1,"content":[{"text":"I will praise you, O Lord, for you lifted me up,","poem":1},{"lineBreak":true},{"text":"and did not allow my enemies to gloat over me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Lord my God,","poem":1},{"lineBreak":true},{"text":"I cried out to you and you healed me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O Lord, you pulled me up from Sheol;","poem":1},{"lineBreak":true},{"text":"you rescued me from among those descending into the grave.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sing to the Lord, you faithful followers of his;","poem":1},{"lineBreak":true},{"text":"give thanks to his holy name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For his anger lasts only a brief moment,","poem":1},{"lineBreak":true},{"text":"and his good favor restores one’s life.","poem":1},{"lineBreak":true},{"text":"One may experience sorrow during the night,","poem":1},{"lineBreak":true},{"text":"but joy arrives in the morning.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"In my self-confidence I said,","poem":1},{"lineBreak":true},{"text":"“I will never be upended.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Lord, in your good favor you made me secure.","poem":1},{"lineBreak":true},{"text":"Then you rejected me and I was terrified.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To you, O Lord, I cried out;","poem":1},{"lineBreak":true},{"text":"I begged the Lord for mercy:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“What profit is there in taking my life,","poem":1},{"lineBreak":true},{"text":"in my descending into the Pit?","poem":1},{"lineBreak":true},{"text":"Can the dust of the grave praise you?","poem":1},{"lineBreak":true},{"text":"Can it declare your loyalty?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hear, O Lord, and have mercy on me!","poem":1},{"lineBreak":true},{"text":"O Lord, deliver me!”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Then you turned my lament into dancing;","poem":1},{"lineBreak":true},{"text":"you removed my sackcloth and covered me with joy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"So now my heart will sing to you and not be silent;","poem":1},{"lineBreak":true},{"text":"O Lord my God, I will always give thanks to you.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}