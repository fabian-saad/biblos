{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["For the music director, to be accompanied by stringed instruments, according to the sheminith style; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Lord, do not rebuke me in your anger!","poem":1},{"lineBreak":true},{"text":"Do not discipline me in your raging fury!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Have mercy on me, Lord, for I am frail!","poem":1},{"lineBreak":true},{"text":"Heal me, Lord, for my bones are shaking!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I am absolutely terrified,","poem":1},{"lineBreak":true},{"text":"and you, Lord – how long will this continue?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Relent, Lord, rescue me!","poem":1},{"lineBreak":true},{"text":"Deliver me because of your faithfulness!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For no one remembers you in the realm of death,","poem":1},{"lineBreak":true},{"text":"In Sheol who gives you thanks?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I am exhausted as I groan;","poem":1},{"lineBreak":true},{"text":"all night long I drench my bed in tears;","poem":1},{"lineBreak":true},{"text":"my tears saturate the cushion beneath me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"My eyes grow dim from suffering;","poem":1},{"lineBreak":true},{"text":"they grow weak because of all my enemies.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Turn back from me, all you who behave wickedly,","poem":1},{"lineBreak":true},{"text":"for the Lord has heard the sound of my weeping!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The Lord has heard my appeal for mercy;","poem":1},{"lineBreak":true},{"text":"the Lord has accepted my prayer.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"May all my enemies be humiliated and absolutely terrified!","poem":1},{"lineBreak":true},{"text":"May they turn back and be suddenly humiliated!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}