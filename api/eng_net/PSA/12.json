{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["For the music director; according to the sheminith style; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Deliver, Lord!","poem":1},{"lineBreak":true},{"text":"For the godly have disappeared;","poem":1},{"lineBreak":true},{"text":"people of integrity have vanished.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"People lie to one another;","poem":1},{"lineBreak":true},{"text":"they flatter and deceive.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May the Lord cut off all flattering lips,","poem":1},{"lineBreak":true},{"text":"and the tongue that boasts!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"They say, “We speak persuasively;","poem":1},{"lineBreak":true},{"text":"we know how to flatter and boast.","poem":1},{"lineBreak":true},{"text":"Who is our master?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Because of the violence done to the oppressed,","poem":1},{"lineBreak":true},{"text":"because of the painful cries of the needy,","poem":1},{"lineBreak":true},{"text":"I will spring into action,” says the Lord.","poem":1},{"lineBreak":true},{"text":"“I will provide the safety they so desperately desire.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord’s words are absolutely reliable.","poem":1},{"lineBreak":true},{"text":"They are as untainted as silver purified in a furnace on the ground,","poem":1},{"lineBreak":true},{"text":"where it is thoroughly refined.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"You, Lord, will protect them;","poem":1},{"lineBreak":true},{"text":"you will continually shelter each one from these evil people,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"for the wicked seem to be everywhere,","poem":1},{"lineBreak":true},{"text":"when people promote evil.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}