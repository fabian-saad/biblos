{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["For the music director; by David."]},{"type":"verse","number":1,"content":[{"text":"In the Lord I have taken shelter.","poem":1},{"lineBreak":true},{"text":"How can you say to me,","poem":1},{"lineBreak":true},{"text":"“Flee to a mountain like a bird!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For look, the wicked prepare their bows,","poem":1},{"lineBreak":true},{"text":"they put their arrows on the strings,","poem":1},{"lineBreak":true},{"text":"to shoot in the darkness at the morally upright.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When the foundations are destroyed,","poem":1},{"lineBreak":true},{"text":"what can the godly accomplish?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord is in his holy temple;","poem":1},{"lineBreak":true},{"text":"the Lord’s throne is in heaven.","poem":1},{"lineBreak":true},{"text":"His eyes watch;","poem":1},{"lineBreak":true},{"text":"his eyes examine all people.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord approves of the godly,","poem":1},{"lineBreak":true},{"text":"but he hates the wicked and those who love to do violence.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May the Lord rain down burning coals and brimstone on the wicked!","poem":1},{"lineBreak":true},{"text":"A whirlwind is what they deserve!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Certainly the Lord is just;","poem":1},{"lineBreak":true},{"text":"he rewards godly deeds;","poem":1},{"lineBreak":true},{"text":"the upright will experience his favor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}