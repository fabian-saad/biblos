{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["For the music director; written by the Korahites, a psalm."]},{"type":"verse","number":1,"content":[{"text":"O Lord, you showed favor to your land;","poem":1},{"lineBreak":true},{"text":"you restored the well-being of Jacob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"You pardoned the wrongdoing of your people;","poem":1},{"lineBreak":true},{"text":"you forgave all their sin. (Selah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"You withdrew all your fury;","poem":1},{"lineBreak":true},{"text":"you turned back from your raging anger.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Restore us, O God our deliverer!","poem":1},{"lineBreak":true},{"text":"Do not be displeased with us!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Will you stay mad at us forever?","poem":1},{"lineBreak":true},{"text":"Will you remain angry throughout future generations?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Will you not revive us once more?","poem":1},{"lineBreak":true},{"text":"Then your people will rejoice in you!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Lord, show us your loyal love!","poem":1},{"lineBreak":true},{"text":"Bestow on us your deliverance!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will listen to what God the Lord says.","poem":1},{"lineBreak":true},{"text":"For he will make peace with his people, his faithful followers.","poem":1},{"lineBreak":true},{"text":"Yet they must not return to their foolish ways.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Certainly his loyal followers will soon experience his deliverance;","poem":1},{"lineBreak":true},{"text":"then his splendor will again appear in our land.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Loyal love and faithfulness meet;","poem":1},{"lineBreak":true},{"text":"deliverance and peace greet each other with a kiss.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Faithfulness grows from the ground,","poem":1},{"lineBreak":true},{"text":"and deliverance looks down from the sky.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yes, the Lord will bestow his good blessings,","poem":1},{"lineBreak":true},{"text":"and our land will yield its crops.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Deliverance goes before him,","poem":1},{"lineBreak":true},{"text":"and prepares a pathway for him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}