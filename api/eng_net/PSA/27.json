{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["By David."]},{"type":"verse","number":1,"content":[{"text":"The Lord delivers and vindicates me!","poem":1},{"lineBreak":true},{"text":"I fear no one!","poem":1},{"lineBreak":true},{"text":"The Lord protects my life!","poem":1},{"lineBreak":true},{"text":"I am afraid of no one!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"When evil men attack me","poem":1},{"lineBreak":true},{"text":"to devour my flesh,","poem":1},{"lineBreak":true},{"text":"when my adversaries and enemies attack me,","poem":1},{"lineBreak":true},{"text":"they stumble and fall.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Even when an army is deployed against me,","poem":1},{"lineBreak":true},{"text":"I do not fear.","poem":1},{"lineBreak":true},{"text":"Even when war is imminent,","poem":1},{"lineBreak":true},{"text":"I remain confident.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I have asked the Lord for one thing –","poem":1},{"lineBreak":true},{"text":"this is what I desire!","poem":1},{"lineBreak":true},{"text":"I want to live in the Lord’s house all the days of my life,","poem":1},{"lineBreak":true},{"text":"so I can gaze at the splendor of the Lord","poem":1},{"lineBreak":true},{"text":"and contemplate in his temple.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He will surely give me shelter in the day of danger;","poem":1},{"lineBreak":true},{"text":"he will hide me in his home;","poem":1},{"lineBreak":true},{"text":"he will place me on an inaccessible rocky summit.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Now I will triumph","poem":1},{"lineBreak":true},{"text":"over my enemies who surround me!","poem":1},{"lineBreak":true},{"text":"I will offer sacrifices in his dwelling place and shout for joy!","poem":1},{"lineBreak":true},{"text":"I will sing praises to the Lord!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hear me, O Lord, when I cry out!","poem":1},{"lineBreak":true},{"text":"Have mercy on me and answer me!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"My heart tells me to pray to you,","poem":1},{"lineBreak":true},{"text":"and I do pray to you, O Lord.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Do not reject me!","poem":1},{"lineBreak":true},{"text":"Do not push your servant away in anger!","poem":1},{"lineBreak":true},{"text":"You are my deliverer!","poem":1},{"lineBreak":true},{"text":"Do not forsake or abandon me,","poem":1},{"lineBreak":true},{"text":"O God who vindicates me!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Even if my father and mother abandoned me,","poem":1},{"lineBreak":true},{"text":"the Lord would take me in.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Teach me how you want me to live;","poem":1},{"lineBreak":true},{"text":"lead me along a level path because of those who wait to ambush me!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Do not turn me over to my enemies,","poem":1},{"lineBreak":true},{"text":"for false witnesses who want to destroy me testify against me.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Where would I be if I did not believe I would experience","poem":1},{"lineBreak":true},{"text":"the Lord’s favor in the land of the living?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rely on the Lord!","poem":1},{"lineBreak":true},{"text":"Be strong and confident!","poem":1},{"lineBreak":true},{"text":"Rely on the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}