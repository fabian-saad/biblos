{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Sing to the Lord a new song!","poem":1},{"lineBreak":true},{"text":"Sing to the Lord, all the earth!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sing to the Lord! Praise his name!","poem":1},{"lineBreak":true},{"text":"Announce every day how he delivers!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tell the nations about his splendor!","poem":1},{"lineBreak":true},{"text":"Tell all the nations about his amazing deeds!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord is great and certainly worthy of praise;","poem":1},{"lineBreak":true},{"text":"he is more awesome than all gods.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For all the gods of the nations are worthless,","poem":1},{"lineBreak":true},{"text":"but the Lord made the sky.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Majestic splendor emanates from him;","poem":1},{"lineBreak":true},{"text":"his sanctuary is firmly established and beautiful.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ascribe to the Lord, O families of the nations,","poem":1},{"lineBreak":true},{"text":"ascribe to the Lord splendor and strength!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ascribe to the Lord the splendor he deserves!","poem":1},{"lineBreak":true},{"text":"Bring an offering and enter his courts!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Worship the Lord in holy attire!","poem":1},{"lineBreak":true},{"text":"Tremble before him, all the earth!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Say among the nations, “The Lord reigns!","poem":1},{"lineBreak":true},{"text":"The world is established, it cannot be moved.","poem":1},{"lineBreak":true},{"text":"He judges the nations fairly.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Let the sky rejoice, and the earth be happy!","poem":1},{"lineBreak":true},{"text":"Let the sea and everything in it shout!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Let the fields and everything in them celebrate!","poem":1},{"lineBreak":true},{"text":"Then let the trees of the forest shout with joy","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"before the Lord, for he comes!","poem":1},{"lineBreak":true},{"text":"For he comes to judge the earth!","poem":1},{"lineBreak":true},{"text":"He judges the world fairly,","poem":1},{"lineBreak":true},{"text":"and the nations in accordance with his justice.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}