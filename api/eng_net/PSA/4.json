{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["For the music director, to be accompanied by stringed instruments; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"When I call out, answer me,","poem":1},{"lineBreak":true},{"text":"O God who vindicates me!","poem":1},{"lineBreak":true},{"text":"Though I am hemmed in, you will lead me into a wide, open place.","poem":1},{"lineBreak":true},{"text":"Have mercy on me and respond to my prayer!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"You men, how long will you try to turn my honor into shame?","poem":1},{"lineBreak":true},{"text":"How long will you love what is worthless","poem":1},{"lineBreak":true},{"text":"and search for what is deceptive? (Selah)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Realize that the Lord shows the godly special favor;","poem":1},{"lineBreak":true},{"text":"the Lord responds when I cry out to him.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tremble with fear and do not sin!","poem":1},{"lineBreak":true},{"text":"Meditate as you lie in bed, and repent of your ways! (Selah)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Offer the prescribed sacrifices","poem":1},{"lineBreak":true},{"text":"and trust in the Lord!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Many say, “Who can show us anything good?”","poem":1},{"lineBreak":true},{"text":"Smile upon us, Lord!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"You make me happier","poem":1},{"lineBreak":true},{"text":"than those who have abundant grain and wine.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I will lie down and sleep peacefully,","poem":1},{"lineBreak":true},{"text":"for you, Lord, make me safe and secure.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}