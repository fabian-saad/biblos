{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord reigns!","poem":1},{"lineBreak":true},{"text":"The nations tremble.","poem":1},{"lineBreak":true},{"text":"He sits enthroned above the winged angels;","poem":1},{"lineBreak":true},{"text":"the earth shakes.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord is elevated in Zion;","poem":1},{"lineBreak":true},{"text":"he is exalted over all the nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise your great and awesome name!","poem":1},{"lineBreak":true},{"text":"He is holy!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The king is strong;","poem":1},{"lineBreak":true},{"text":"he loves justice.","poem":1},{"lineBreak":true},{"text":"You ensure that legal decisions will be made fairly;","poem":1},{"lineBreak":true},{"text":"you promote justice and equity in Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Praise the Lord our God!","poem":1},{"lineBreak":true},{"text":"Worship before his footstool!","poem":1},{"lineBreak":true},{"text":"He is holy!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moses and Aaron were among his priests;","poem":1},{"lineBreak":true},{"text":"Samuel was one of those who prayed to him.","poem":1},{"lineBreak":true},{"text":"They prayed to the Lord and he answered them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spoke to them from a pillar of cloud;","poem":1},{"lineBreak":true},{"text":"they obeyed his regulations and the ordinance he gave them.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord our God, you answered them.","poem":1},{"lineBreak":true},{"text":"They found you to be a forgiving God,","poem":1},{"lineBreak":true},{"text":"but also one who punished their sinful deeds.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Praise the Lord our God!","poem":1},{"lineBreak":true},{"text":"Worship on his holy hill,","poem":1},{"lineBreak":true},{"text":"for the Lord our God is holy!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}