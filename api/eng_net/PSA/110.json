{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Here is the Lord’s proclamation to my lord:","poem":1},{"lineBreak":true},{"text":"“Sit down at my right hand until I make your enemies your footstool!”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord extends your dominion from Zion.","poem":1},{"lineBreak":true},{"text":"Rule in the midst of your enemies!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Your people willingly follow you when you go into battle.","poem":1},{"lineBreak":true},{"text":"On the holy hills at sunrise the dew of your youth belongs to you.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord makes this promise on oath and will not revoke it:","poem":1},{"lineBreak":true},{"text":"“You are an eternal priest after the pattern of Melchizedek.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O sovereign Lord, at your right hand","poem":1},{"lineBreak":true},{"text":"he strikes down kings in the day he unleashes his anger.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He executes judgment against the nations;","poem":1},{"lineBreak":true},{"text":"he fills the valleys with corpses;","poem":1},{"lineBreak":true},{"text":"he shatters their heads over the vast battlefield.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"From the stream along the road he drinks;","poem":1},{"lineBreak":true},{"text":"then he lifts up his head.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}