{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, I cry out to you. Come quickly to me!","poem":1},{"lineBreak":true},{"text":"Pay attention to me when I cry out to you!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"May you accept my prayer like incense,","poem":1},{"lineBreak":true},{"text":"my uplifted hands like the evening offering!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O Lord, place a guard on my mouth!","poem":1},{"lineBreak":true},{"text":"Protect the opening of my lips!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Do not let me have evil desires,","poem":1},{"lineBreak":true},{"text":"or participate in sinful activities","poem":1},{"lineBreak":true},{"text":"with men who behave wickedly.","poem":1},{"lineBreak":true},{"text":"I will not eat their delicacies.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"May the godly strike me in love and correct me!","poem":1},{"lineBreak":true},{"text":"May my head not refuse choice oil!","poem":1},{"lineBreak":true},{"text":"Indeed, my prayer is a witness against their evil deeds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They will be thrown down the side of a cliff by their judges.","poem":1},{"lineBreak":true},{"text":"They will listen to my words, for they are pleasant.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"As when one plows and breaks up the soil,","poem":1},{"lineBreak":true},{"text":"so our bones are scattered at the mouth of Sheol.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Surely I am looking to you, O sovereign Lord.","poem":1},{"lineBreak":true},{"text":"In you I take shelter.","poem":1},{"lineBreak":true},{"text":"Do not expose me to danger!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Protect me from the snare they have laid for me,","poem":1},{"lineBreak":true},{"text":"and the traps the evildoers have set.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Let the wicked fall into their own nets,","poem":1},{"lineBreak":true},{"text":"while I escape.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}