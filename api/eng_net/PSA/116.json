{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"I love the Lord","poem":1},{"lineBreak":true},{"text":"because he heard my plea for mercy,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"and listened to me.","poem":1},{"lineBreak":true},{"text":"As long as I live, I will call to him when I need help.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The ropes of death tightened around me,","poem":1},{"lineBreak":true},{"text":"the snares of Sheol confronted me.","poem":1},{"lineBreak":true},{"text":"I was confronted with trouble and sorrow.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I called on the name of the Lord,","poem":1},{"lineBreak":true},{"text":"“Please Lord, rescue my life!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is merciful and fair;","poem":1},{"lineBreak":true},{"text":"our God is compassionate.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord protects the untrained;","poem":1},{"lineBreak":true},{"text":"I was in serious trouble and he delivered me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rest once more, my soul,","poem":1},{"lineBreak":true},{"text":"for the Lord has vindicated you.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yes, Lord, you rescued my life from death,","poem":1},{"lineBreak":true},{"text":"and kept my feet from stumbling.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I will serve the Lord","poem":1},{"lineBreak":true},{"text":"in the land of the living.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I had faith when I said,","poem":1},{"lineBreak":true},{"text":"“I am severely oppressed.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I rashly declared,","poem":1},{"lineBreak":true},{"text":"“All men are liars.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"How can I repay the Lord","poem":1},{"lineBreak":true},{"text":"for all his acts of kindness to me?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I will celebrate my deliverance,","poem":1},{"lineBreak":true},{"text":"and call on the name of the Lord.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I will fulfill my vows to the Lord","poem":1},{"lineBreak":true},{"text":"before all his people.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"The Lord values","poem":1},{"lineBreak":true},{"text":"the lives of his faithful followers.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yes, Lord! I am indeed your servant;","poem":1},{"lineBreak":true},{"text":"I am your lowest slave.","poem":1},{"lineBreak":true},{"text":"You saved me from death.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I will present a thank offering to you,","poem":1},{"lineBreak":true},{"text":"and call on the name of the Lord.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I will fulfill my vows to the Lord","poem":1},{"lineBreak":true},{"text":"before all his people,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"in the courts of the Lord’s temple,","poem":1},{"lineBreak":true},{"text":"in your midst, O Jerusalem.","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}