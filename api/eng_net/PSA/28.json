{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["By David."]},{"type":"verse","number":1,"content":[{"text":"To you, O Lord, I cry out!","poem":1},{"lineBreak":true},{"text":"My protector, do not ignore me!","poem":1},{"lineBreak":true},{"text":"If you do not respond to me,","poem":1},{"lineBreak":true},{"text":"I will join those who are descending into the grave.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hear my plea for mercy when I cry out to you for help,","poem":1},{"lineBreak":true},{"text":"when I lift my hands toward your holy temple!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Do not drag me away with evil men,","poem":1},{"lineBreak":true},{"text":"with those who behave wickedly,","poem":1},{"lineBreak":true},{"text":"who talk so friendly to their neighbors,","poem":1},{"lineBreak":true},{"text":"while they plan to harm them!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pay them back for their evil deeds!","poem":1},{"lineBreak":true},{"text":"Pay them back for what they do!","poem":1},{"lineBreak":true},{"text":"Punish them!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For they do not understand the Lord’s actions,","poem":1},{"lineBreak":true},{"text":"or the way he carries out justice.","poem":1},{"lineBreak":true},{"text":"The Lord will permanently demolish them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord deserves praise,","poem":1},{"lineBreak":true},{"text":"for he has heard my plea for mercy!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord strengthens and protects me;","poem":1},{"lineBreak":true},{"text":"I trust in him with all my heart.","poem":1},{"lineBreak":true},{"text":"I am rescued and my heart is full of joy;","poem":1},{"lineBreak":true},{"text":"I will sing to him in gratitude.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord strengthens his people;","poem":1},{"lineBreak":true},{"text":"he protects and delivers his chosen king.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Deliver your people!","poem":1},{"lineBreak":true},{"text":"Empower the nation that belongs to you!","poem":1},{"lineBreak":true},{"text":"Care for them like a shepherd and carry them in your arms at all times!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}