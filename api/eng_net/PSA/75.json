{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["For the music director; according to the al-tashcheth style; a psalm of Asaph; a song."]},{"type":"verse","number":1,"content":[{"text":"We give thanks to you, O God! We give thanks!","poem":1},{"lineBreak":true},{"text":"You reveal your presence;","poem":1},{"lineBreak":true},{"text":"people tell about your amazing deeds.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God says,","poem":1},{"lineBreak":true},{"text":"“At the appointed times,","poem":1},{"lineBreak":true},{"text":"I judge fairly.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When the earth and all its inhabitants dissolve in fear,","poem":1},{"lineBreak":true},{"text":"I make its pillars secure.” (Selah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I say to the proud, “Do not be proud,”","poem":1},{"lineBreak":true},{"text":"and to the wicked, “Do not be so confident of victory!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Do not be so certain you have won!","poem":1},{"lineBreak":true},{"text":"Do not speak with your head held so high!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For victory does not come from the east or west,","poem":1},{"lineBreak":true},{"text":"or from the wilderness.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is the judge!","poem":1},{"lineBreak":true},{"text":"He brings one down and exalts another.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the Lord holds in his hand a cup full","poem":1},{"lineBreak":true},{"text":"of foaming wine mixed with spices,","poem":1},{"lineBreak":true},{"text":"and pours it out.","poem":1},{"lineBreak":true},{"text":"Surely all the wicked of the earth","poem":1},{"lineBreak":true},{"text":"will slurp it up and drink it to its very last drop.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"As for me, I will continually tell what you have done;","poem":1},{"lineBreak":true},{"text":"I will sing praises to the God of Jacob!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"God says,","poem":1},{"lineBreak":true},{"text":"“I will bring down all the power of the wicked;","poem":1},{"lineBreak":true},{"text":"the godly will be victorious.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}