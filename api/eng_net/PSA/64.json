{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["For the music director; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Listen to me, O God, as I offer my lament!","poem":1},{"lineBreak":true},{"text":"Protect my life from the enemy’s terrifying attacks.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hide me from the plots of evil men,","poem":1},{"lineBreak":true},{"text":"from the crowd of evildoers.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"They sharpen their tongues like a sword;","poem":1},{"lineBreak":true},{"text":"they aim their arrow, a slanderous charge,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"in order to shoot down the innocent in secluded places.","poem":1},{"lineBreak":true},{"text":"They shoot at him suddenly and are unafraid of retaliation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They encourage one another to carry out their evil deed.","poem":1},{"lineBreak":true},{"text":"They plan how to hide snares,","poem":1},{"lineBreak":true},{"text":"and boast, “Who will see them?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"They devise unjust schemes;","poem":1},{"lineBreak":true},{"text":"they disguise a well-conceived plot.","poem":1},{"lineBreak":true},{"text":"Man’s inner thoughts cannot be discovered.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But God will shoot at them;","poem":1},{"lineBreak":true},{"text":"suddenly they will be wounded by an arrow.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Their slander will bring about their demise.","poem":1},{"lineBreak":true},{"text":"All who see them will shudder,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"and all people will fear.","poem":1},{"lineBreak":true},{"text":"They will proclaim what God has done,","poem":1},{"lineBreak":true},{"text":"and reflect on his deeds.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The godly will rejoice in the Lord","poem":1},{"lineBreak":true},{"text":"and take shelter in him.","poem":1},{"lineBreak":true},{"text":"All the morally upright will boast.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}