{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["A song, a psalm by the Korahites."]},{"type":"verse","number":1,"content":[{"text":"The Lord is great and certainly worthy of praise","poem":1},{"lineBreak":true},{"text":"in the city of our God, his holy hill.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is lofty and pleasing to look at,","poem":1},{"lineBreak":true},{"text":"a source of joy to the whole earth.","poem":1},{"lineBreak":true},{"text":"Mount Zion resembles the peaks of Zaphon;","poem":1},{"lineBreak":true},{"text":"it is the city of the great king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"God is in its fortresses;","poem":1},{"lineBreak":true},{"text":"he reveals himself as its defender.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For look, the kings assemble;","poem":1},{"lineBreak":true},{"text":"they advance together.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As soon as they see, they are shocked;","poem":1},{"lineBreak":true},{"text":"they are terrified, they quickly retreat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Look at them shake uncontrollably,","poem":1},{"lineBreak":true},{"text":"like a woman writhing in childbirth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"With an east wind","poem":1},{"lineBreak":true},{"text":"you shatter the large ships.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"We heard about God’s mighty deeds, now we have seen them,","poem":1},{"lineBreak":true},{"text":"in the city of the Lord, the invincible Warrior,","poem":1},{"lineBreak":true},{"text":"in the city of our God.","poem":1},{"lineBreak":true},{"text":"God makes it permanently secure. (Selah)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"We reflect on your loyal love, O God,","poem":1},{"lineBreak":true},{"text":"within your temple.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The praise you receive as far away as the ends of the earth","poem":1},{"lineBreak":true},{"text":"is worthy of your reputation, O God.","poem":1},{"lineBreak":true},{"text":"You execute justice!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mount Zion rejoices;","poem":1},{"lineBreak":true},{"text":"the towns of Judah are happy,","poem":1},{"lineBreak":true},{"text":"because of your acts of judgment.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Walk around Zion! Encircle it!","poem":1},{"lineBreak":true},{"text":"Count its towers!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Consider its defenses!","poem":1},{"lineBreak":true},{"text":"Walk through its fortresses,","poem":1},{"lineBreak":true},{"text":"so you can tell the next generation about it!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"For God, our God, is our defender forever!","poem":1},{"lineBreak":true},{"text":"He guides us!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}