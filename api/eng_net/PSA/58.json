{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["For the music director; according to the al-tashcheth style; a prayer of David."]},{"type":"verse","number":1,"content":[{"text":"Do you rulers really pronounce just decisions?","poem":1},{"lineBreak":true},{"text":"Do you judge people fairly?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"No! You plan how to do what is unjust;","poem":1},{"lineBreak":true},{"text":"you deal out violence in the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The wicked turn aside from birth;","poem":1},{"lineBreak":true},{"text":"liars go astray as soon as they are born.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Their venom is like that of a snake,","poem":1},{"lineBreak":true},{"text":"like a deaf serpent that does not hear,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"that does not respond to the magicians,","poem":1},{"lineBreak":true},{"text":"or to a skilled snake-charmer.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O God, break the teeth in their mouths!","poem":1},{"lineBreak":true},{"text":"Smash the jawbones of the lions, O Lord!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Let them disappear like water that flows away!","poem":1},{"lineBreak":true},{"text":"Let them wither like grass!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Let them be like a snail that melts away as it moves along!","poem":1},{"lineBreak":true},{"text":"Let them be like stillborn babies that never see the sun!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Before the kindling is even placed under your pots,","poem":1},{"lineBreak":true},{"text":"he will sweep it away along with both the raw and cooked meat.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The godly will rejoice when they see vengeance carried out;","poem":1},{"lineBreak":true},{"text":"they will bathe their feet in the blood of the wicked.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Then observers will say,","poem":1},{"lineBreak":true},{"text":"“Yes indeed, the godly are rewarded!","poem":1},{"lineBreak":true},{"text":"Yes indeed, there is a God who judges in the earth!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}