{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A song of ascents, by Solomon."]},{"type":"verse","number":1,"content":[{"text":"If the Lord does not build a house,","poem":1},{"lineBreak":true},{"text":"then those who build it work in vain.","poem":1},{"lineBreak":true},{"text":"If the Lord does not guard a city,","poem":1},{"lineBreak":true},{"text":"then the watchman stands guard in vain.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is vain for you to rise early, come home late,","poem":1},{"lineBreak":true},{"text":"and work so hard for your food.","poem":1},{"lineBreak":true},{"text":"Yes, he can provide for those whom he loves even when they sleep.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yes, sons are a gift from the Lord,","poem":1},{"lineBreak":true},{"text":"the fruit of the womb is a reward.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sons born during one’s youth","poem":1},{"lineBreak":true},{"text":"are like arrows in a warrior’s hand.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"How blessed is the man who fills his quiver with them!","poem":1},{"lineBreak":true},{"text":"They will not be put to shame when they confront enemies at the city gate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}