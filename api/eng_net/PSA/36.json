{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["For the music director; written by the Lord’s servant, David; an oracle."]},{"type":"verse","number":1,"content":[{"text":"An evil man is rebellious to the core.","poem":1},{"lineBreak":true},{"text":"He does not fear God,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"for he is too proud","poem":1},{"lineBreak":true},{"text":"to recognize and give up his sin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The words he speaks are sinful and deceitful;","poem":1},{"lineBreak":true},{"text":"he does not care about doing what is wise and right.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He plans ways to sin while he lies in bed;","poem":1},{"lineBreak":true},{"text":"he is committed to a sinful lifestyle;","poem":1},{"lineBreak":true},{"text":"he does not reject what is evil.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O Lord, your loyal love reaches to the sky;","poem":1},{"lineBreak":true},{"text":"your faithfulness to the clouds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Your justice is like the highest mountains,","poem":1},{"lineBreak":true},{"text":"your fairness like the deepest sea;","poem":1},{"lineBreak":true},{"text":"you preserve mankind and the animal kingdom.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"How precious is your loyal love, O God!","poem":1},{"lineBreak":true},{"text":"The human race finds shelter under your wings.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They are filled with food from your house,","poem":1},{"lineBreak":true},{"text":"and you allow them to drink from the river of your delicacies.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For you are the one who gives","poem":1},{"lineBreak":true},{"text":"and sustains life.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Extend your loyal love to your faithful followers,","poem":1},{"lineBreak":true},{"text":"and vindicate the morally upright!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Do not let arrogant men overtake me,","poem":1},{"lineBreak":true},{"text":"or let evil men make me homeless!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I can see the evildoers! They have fallen!","poem":1},{"lineBreak":true},{"text":"They have been knocked down and are unable to get up!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}