{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Why do the nations rebel?","poem":1},{"lineBreak":true},{"text":"Why are the countries devising plots that will fail?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The kings of the earth form a united front;","poem":1},{"lineBreak":true},{"text":"the rulers collaborate","poem":1},{"lineBreak":true},{"text":"against the Lord and his anointed king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"They say, “Let’s tear off the shackles they’ve put on us!","poem":1},{"lineBreak":true},{"text":"Let’s free ourselves from their ropes!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The one enthroned in heaven laughs in disgust;","poem":1},{"lineBreak":true},{"text":"the Lord taunts them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then he angrily speaks to them","poem":1},{"lineBreak":true},{"text":"and terrifies them in his rage, saying,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“I myself have installed my king","poem":1},{"lineBreak":true},{"text":"on Zion, my holy hill.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The king says, “I will announce the Lord’s decree. He said to me:","poem":1},{"lineBreak":true},{"text":"‘You are my son! This very day I have become your father!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ask me,","poem":1},{"lineBreak":true},{"text":"and I will give you the nations as your inheritance,","poem":1},{"lineBreak":true},{"text":"the ends of the earth as your personal property.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"You will break them with an iron scepter;","poem":1},{"lineBreak":true},{"text":"you will smash them like a potter’s jar!’”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"So now, you kings, do what is wise;","poem":1},{"lineBreak":true},{"text":"you rulers of the earth, submit to correction!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Serve the Lord in fear!","poem":1},{"lineBreak":true},{"text":"Repent in terror!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Give sincere homage!","poem":1},{"lineBreak":true},{"text":"Otherwise he will be angry,","poem":1},{"lineBreak":true},{"text":"and you will die because of your behavior,","poem":1},{"lineBreak":true},{"text":"when his anger quickly ignites.","poem":1},{"lineBreak":true},{"text":"How blessed are all who take shelter in him!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}