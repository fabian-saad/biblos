{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"Sing to the Lord a new song!","poem":1},{"lineBreak":true},{"text":"Praise him in the assembly of the godly!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in their Creator!","poem":1},{"lineBreak":true},{"text":"Let the people of Zion delight in their king!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name with dancing!","poem":1},{"lineBreak":true},{"text":"Let them sing praises to him to the accompaniment of the tambourine and harp!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord takes delight in his people;","poem":1},{"lineBreak":true},{"text":"he exalts the oppressed by delivering them.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the godly rejoice because of their vindication!","poem":1},{"lineBreak":true},{"text":"Let them shout for joy upon their beds!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May they praise God","poem":1},{"lineBreak":true},{"text":"while they hold a two-edged sword in their hand,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"in order to take revenge on the nations,","poem":1},{"lineBreak":true},{"text":"and punish foreigners.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They bind their kings in chains,","poem":1},{"lineBreak":true},{"text":"and their nobles in iron shackles,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"and execute the judgment to which their enemies have been sentenced.","poem":1},{"lineBreak":true},{"text":"All his loyal followers will be vindicated.","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}