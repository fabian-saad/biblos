{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["For the music director; to be played on a stringed instrument; written by David."]},{"type":"verse","number":1,"content":[{"text":"O God, hear my cry for help!","poem":1},{"lineBreak":true},{"text":"Pay attention to my prayer!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"From the most remote place on earth","poem":1},{"lineBreak":true},{"text":"I call out to you in my despair.","poem":1},{"lineBreak":true},{"text":"Lead me up to an inaccessible rocky summit!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Indeed, you are my shelter,","poem":1},{"lineBreak":true},{"text":"a strong tower that protects me from the enemy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will be a permanent guest in your home;","poem":1},{"lineBreak":true},{"text":"I will find shelter in the protection of your wings. (Selah)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For you, O God, hear my vows;","poem":1},{"lineBreak":true},{"text":"you grant me the reward that belongs to your loyal followers.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Give the king long life!","poem":1},{"lineBreak":true},{"text":"Make his lifetime span several generations!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May he reign forever before God!","poem":1},{"lineBreak":true},{"text":"Decree that your loyal love and faithfulness should protect him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Then I will sing praises to your name continually,","poem":1},{"lineBreak":true},{"text":"as I fulfill my vows day after day.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}