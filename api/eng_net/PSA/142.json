{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["A well-written song by David, when he was in the cave; a prayer."]},{"type":"verse","number":1,"content":[{"text":"To the Lord I cry out;","poem":1},{"lineBreak":true},{"text":"to the Lord I plead for mercy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I pour out my lament before him;","poem":1},{"lineBreak":true},{"text":"I tell him about my troubles.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Even when my strength leaves me,","poem":1},{"lineBreak":true},{"text":"you watch my footsteps.","poem":1},{"lineBreak":true},{"text":"In the path where I walk","poem":1},{"lineBreak":true},{"text":"they have hidden a trap for me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Look to the right and see!","poem":1},{"lineBreak":true},{"text":"No one cares about me.","poem":1},{"lineBreak":true},{"text":"I have nowhere to run;","poem":1},{"lineBreak":true},{"text":"no one is concerned about my life.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I cry out to you, O Lord;","poem":1},{"lineBreak":true},{"text":"I say, “You are my shelter,","poem":1},{"lineBreak":true},{"text":"my security in the land of the living.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Listen to my cry for help,","poem":1},{"lineBreak":true},{"text":"for I am in serious trouble!","poem":1},{"lineBreak":true},{"text":"Rescue me from those who chase me,","poem":1},{"lineBreak":true},{"text":"for they are stronger than I am.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Free me from prison,","poem":1},{"lineBreak":true},{"text":"that I may give thanks to your name.","poem":1},{"lineBreak":true},{"text":"Because of me the godly will assemble,","poem":1},{"lineBreak":true},{"text":"for you will vindicate me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}