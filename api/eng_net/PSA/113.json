{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"Praise, you servants of the Lord,","poem":1},{"lineBreak":true},{"text":"praise the name of the Lord!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"May the Lord’s name be praised","poem":1},{"lineBreak":true},{"text":"now and forevermore!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From east to west","poem":1},{"lineBreak":true},{"text":"the Lord’s name is deserving of praise.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord is exalted over all the nations;","poem":1},{"lineBreak":true},{"text":"his splendor reaches beyond the sky.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who can compare to the Lord our God,","poem":1},{"lineBreak":true},{"text":"who sits on a high throne?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He bends down to look","poem":1},{"lineBreak":true},{"text":"at the sky and the earth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He raises the poor from the dirt,","poem":1},{"lineBreak":true},{"text":"and lifts up the needy from the garbage pile,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"that he might seat him with princes,","poem":1},{"lineBreak":true},{"text":"with the princes of his people.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He makes the barren woman of the family","poem":1},{"lineBreak":true},{"text":"a happy mother of children.","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}