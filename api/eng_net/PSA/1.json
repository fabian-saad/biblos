{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"How blessed is the one who does not follow the advice of the wicked,","poem":1},{"lineBreak":true},{"text":"or stand in the pathway with sinners,","poem":1},{"lineBreak":true},{"text":"or sit in the assembly of scoffers!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Instead he finds pleasure in obeying the Lord’s commands;","poem":1},{"lineBreak":true},{"text":"he meditates on his commands day and night.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He is like a tree planted by flowing streams;","poem":1},{"lineBreak":true},{"text":"it yields its fruit at the proper time,","poem":1},{"lineBreak":true},{"text":"and its leaves never fall off.","poem":1},{"lineBreak":true},{"text":"He succeeds in everything he attempts.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Not so with the wicked!","poem":1},{"lineBreak":true},{"text":"Instead they are like wind-driven chaff.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For this reason the wicked cannot withstand judgment,","poem":1},{"lineBreak":true},{"text":"nor can sinners join the assembly of the godly.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Certainly the Lord guards the way of the godly,","poem":1},{"lineBreak":true},{"text":"but the way of the wicked ends in destruction.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}