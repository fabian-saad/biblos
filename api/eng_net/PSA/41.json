{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["For the music director; a psalm of David."]},{"type":"verse","number":1,"content":[{"text":"How blessed is the one who treats the poor properly!","poem":1},{"lineBreak":true},{"text":"When trouble comes, the Lord delivers him.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"May the Lord protect him and save his life!","poem":1},{"lineBreak":true},{"text":"May he be blessed in the land!","poem":1},{"lineBreak":true},{"text":"Do not turn him over to his enemies!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord supports him on his sickbed;","poem":1},{"lineBreak":true},{"text":"you completely heal him from his illness.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"As for me, I said:","poem":1},{"lineBreak":true},{"text":"“O Lord, have mercy on me!","poem":1},{"lineBreak":true},{"text":"Heal me, for I have sinned against you!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"My enemies ask this cruel question about me,","poem":1},{"lineBreak":true},{"text":"‘When will he finally die and be forgotten?’","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"When someone comes to visit, he pretends to be friendly;","poem":1},{"lineBreak":true},{"text":"he thinks of ways to defame me,","poem":1},{"lineBreak":true},{"text":"and when he leaves he slanders me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"All who hate me whisper insults about me to one another;","poem":1},{"lineBreak":true},{"text":"they plan ways to harm me.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They say,","poem":1},{"lineBreak":true},{"text":"‘An awful disease overwhelms him,","poem":1},{"lineBreak":true},{"text":"and now that he is bed-ridden he will never recover.’","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Even my close friend whom I trusted,","poem":1},{"lineBreak":true},{"text":"he who shared meals with me, has turned against me.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"As for you, O Lord, have mercy on me and raise me up,","poem":1},{"lineBreak":true},{"text":"so I can pay them back!”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"By this I know that you are pleased with me,","poem":1},{"lineBreak":true},{"text":"for my enemy does not triumph over me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"As for me, you uphold me because of my integrity;","poem":1},{"lineBreak":true},{"text":"you allow me permanent access to your presence.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"The Lord God of Israel deserves praise","poem":1},{"lineBreak":true},{"text":"in the future and forevermore!","poem":1},{"lineBreak":true},{"text":"We agree! We agree!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}