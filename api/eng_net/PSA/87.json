{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Written by the Korahites; a psalm, a song."]},{"type":"verse","number":1,"content":[{"text":"The Lord’s city is in the holy hills.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The Lord loves the gates of Zion","poem":1},{"lineBreak":true},{"text":"more than all the dwelling places of Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"People say wonderful things about you,","poem":1},{"lineBreak":true},{"text":"O city of God. (Selah)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I mention Rahab and Babylon to my followers.","poem":1},{"lineBreak":true},{"text":"Here are Philistia and Tyre, along with Ethiopia.","poem":1},{"lineBreak":true},{"text":"It is said of them, “This one was born there.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But it is said of Zion’s residents,","poem":1},{"lineBreak":true},{"text":"“Each one of these was born in her,","poem":1},{"lineBreak":true},{"text":"and the sovereign One makes her secure.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The Lord writes in the census book of the nations,","poem":1},{"lineBreak":true},{"text":"“This one was born there.” (Selah)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"As for the singers, as well as the pipers –","poem":1},{"lineBreak":true},{"text":"all of them sing within your walls.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}