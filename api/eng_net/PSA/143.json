{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"O Lord, hear my prayer!","poem":1},{"lineBreak":true},{"text":"Pay attention to my plea for help!","poem":1},{"lineBreak":true},{"text":"Because of your faithfulness and justice, answer me!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Do not sit in judgment on your servant,","poem":1},{"lineBreak":true},{"text":"for no one alive is innocent before you.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Certainly my enemies chase me.","poem":1},{"lineBreak":true},{"text":"They smash me into the ground.","poem":1},{"lineBreak":true},{"text":"They force me to live in dark regions,","poem":1},{"lineBreak":true},{"text":"like those who have been dead for ages.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"My strength leaves me;","poem":1},{"lineBreak":true},{"text":"I am absolutely shocked.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I recall the old days;","poem":1},{"lineBreak":true},{"text":"I meditate on all you have done;","poem":1},{"lineBreak":true},{"text":"I reflect on your accomplishments.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I spread my hands out to you in prayer;","poem":1},{"lineBreak":true},{"text":"my soul thirsts for you in a parched land.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Answer me quickly, Lord!","poem":1},{"lineBreak":true},{"text":"My strength is fading.","poem":1},{"lineBreak":true},{"text":"Do not reject me,","poem":1},{"lineBreak":true},{"text":"or I will join those descending into the grave.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"May I hear about your loyal love in the morning,","poem":1},{"lineBreak":true},{"text":"for I trust in you.","poem":1},{"lineBreak":true},{"text":"Show me the way I should go,","poem":1},{"lineBreak":true},{"text":"because I long for you.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rescue me from my enemies, O Lord!","poem":1},{"lineBreak":true},{"text":"I run to you for protection.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Teach me to do what pleases you,","poem":1},{"lineBreak":true},{"text":"for you are my God.","poem":1},{"lineBreak":true},{"text":"May your kind presence","poem":1},{"lineBreak":true},{"text":"lead me into a level land.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O Lord, for the sake of your reputation, revive me!","poem":1},{"lineBreak":true},{"text":"Because of your justice, rescue me from trouble!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"As a demonstration of your loyal love, destroy my enemies!","poem":1},{"lineBreak":true},{"text":"Annihilate all who threaten my life,","poem":1},{"lineBreak":true},{"text":"for I am your servant.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}