ill not harm you by day,","poem":1},{"lineBreak":true},{"text":"or the moon by night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord will protect you from all harm;","poem":1},{"lineBreak":true},{"text":"he will protect your life.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord will protect you in all you do,","poem":1},{"lineBreak":true},{"text":"now and forevermore.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}