{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord!","poem":1},{"lineBreak":true},{"text":"Praise the Lord from the sky!","poem":1},{"lineBreak":true},{"text":"Praise him in the heavens!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Praise him, all his angels!","poem":1},{"lineBreak":true},{"text":"Praise him, all his heavenly assembly!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise him, O sun and moon!","poem":1},{"lineBreak":true},{"text":"Praise him, all you shiny stars!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Praise him, O highest heaven,","poem":1},{"lineBreak":true},{"text":"and you waters above the sky!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let them praise the name of the Lord,","poem":1},{"lineBreak":true},{"text":"for he gave the command and they came into existence.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He established them so they would endure;","poem":1},{"lineBreak":true},{"text":"he issued a decree that will not be revoked.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Praise the Lord from the earth,","poem":1},{"lineBreak":true},{"text":"you sea creatures and all you ocean depths,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O fire and hail, snow and clouds,","poem":1},{"lineBreak":true},{"text":"O stormy wind that carries out his orders,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"you mountains and all you hills,","poem":1},{"lineBreak":true},{"text":"you fruit trees and all you cedars,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"you animals and all you cattle,","poem":1},{"lineBreak":true},{"text":"you creeping things and birds,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"you kings of the earth and all you nations,","poem":1},{"lineBreak":true},{"text":"you princes and all you leaders on the earth,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"you young men and young women,","poem":1},{"lineBreak":true},{"text":"you elderly, along with you children!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Let them praise the name of the Lord,","poem":1},{"lineBreak":true},{"text":"for his name alone is exalted;","poem":1},{"lineBreak":true},{"text":"his majesty extends over the earth and sky.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"He has made his people victorious,","poem":1},{"lineBreak":true},{"text":"and given all his loyal followers reason to praise –","poem":1},{"lineBreak":true},{"text":"the Israelites, the people who are close to him.","poem":1},{"lineBreak":true},{"text":"Praise the Lord!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}