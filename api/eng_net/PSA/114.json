"like lambs, O hills?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tremble, O earth, before the Lord –","poem":1},{"lineBreak":true},{"text":"before the God of Jacob,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"who turned a rock into a pool of water,","poem":1},{"lineBreak":true},{"text":"a hard rock into springs of water!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}