{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A song of ascents."]},{"type":"verse","number":1,"content":[{"text":"When the Lord restored the well-being of Zion,","poem":1},{"lineBreak":true},{"text":"we thought we were dreaming.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"At that time we laughed loudly","poem":1},{"lineBreak":true},{"text":"and shouted for joy.","poem":1},{"lineBreak":true},{"text":"At that time the nations said,","poem":1},{"lineBreak":true},{"text":"“The Lord has accomplished great things for these people.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord did indeed accomplish great things for us.","poem":1},{"lineBreak":true},{"text":"We were happy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O Lord, restore our well-being,","poem":1},{"lineBreak":true},{"text":"just as the streams in the arid south are replenished.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Those who shed tears as they plant","poem":1},{"lineBreak":true},{"text":"will shout for joy when they reap the harvest.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The one who weeps as he walks along, carrying his bag of seed,","poem":1},{"lineBreak":true},{"text":"will certainly come in with a shout of joy, carrying his sheaves of grain.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}