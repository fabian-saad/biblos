{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A song of ascents, by David."]},{"type":"verse","number":1,"content":[{"text":"I was glad because they said to me,","poem":1},{"lineBreak":true},{"text":"“We will go to the Lord’s temple.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet are standing","poem":1},{"lineBreak":true},{"text":"inside your gates, O Jerusalem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem is a city designed","poem":1},{"lineBreak":true},{"text":"to accommodate an assembly.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The tribes go up there,","poem":1},{"lineBreak":true},{"text":"the tribes of the Lord,","poem":1},{"lineBreak":true},{"text":"where it is required that Israel","poem":1},{"lineBreak":true},{"text":"give thanks to the name of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Indeed, the leaders sit there on thrones and make legal decisions,","poem":1},{"lineBreak":true},{"text":"on the thrones of the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pray for the peace of Jerusalem!","poem":1},{"lineBreak":true},{"text":"May those who love her prosper!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May there be peace inside your defenses,","poem":1},{"lineBreak":true},{"text":"and prosperity inside your fortresses!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the sake of my brothers and my neighbors","poem":1},{"lineBreak":true},{"text":"I will say, “May there be peace in you!”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For the sake of the temple of the Lord our God","poem":1},{"lineBreak":true},{"text":"I will pray for you to prosper.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}