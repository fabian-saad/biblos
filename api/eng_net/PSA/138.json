{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["By David."]},{"type":"verse","number":1,"content":[{"text":"I will give you thanks with all my heart;","poem":1},{"lineBreak":true},{"text":"before the heavenly assembly I will sing praises to you.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will bow down toward your holy temple,","poem":1},{"lineBreak":true},{"text":"and give thanks to your name,","poem":1},{"lineBreak":true},{"text":"because of your loyal love and faithfulness,","poem":1},{"lineBreak":true},{"text":"for you have exalted your promise above the entire sky.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When I cried out for help, you answered me.","poem":1},{"lineBreak":true},{"text":"You made me bold and energized me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let all the kings of the earth give thanks to you, O Lord,","poem":1},{"lineBreak":true},{"text":"when they hear the words you speak.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let them sing about the Lord’s deeds,","poem":1},{"lineBreak":true},{"text":"for the Lord’s splendor is magnificent.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Though the Lord is exalted, he takes note of the lowly,","poem":1},{"lineBreak":true},{"text":"and recognizes the proud from far away.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Even when I must walk in the midst of danger, you revive me.","poem":1},{"lineBreak":true},{"text":"You oppose my angry enemies,","poem":1},{"lineBreak":true},{"text":"and your right hand delivers me.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord avenges me.","poem":1},{"lineBreak":true},{"text":"O Lord, your loyal love endures.","poem":1},{"lineBreak":true},{"text":"Do not abandon those whom you have made!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}