"text":"The Lord deserves praise,","poem":1},{"lineBreak":true},{"text":"for he did not hand us over as prey to their teeth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"We escaped with our lives, like a bird from a hunter’s snare.","poem":1},{"lineBreak":true},{"text":"The snare broke, and we escaped.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Our deliverer is the Lord,","poem":1},{"lineBreak":true},{"text":"the Creator of heaven and earth.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}