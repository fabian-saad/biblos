{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["By David."]},{"type":"verse","number":1,"content":[{"text":"Vindicate me, O Lord,","poem":1},{"lineBreak":true},{"text":"for I have integrity,","poem":1},{"lineBreak":true},{"text":"and I trust in the Lord without wavering.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Examine me, O Lord, and test me!","poem":1},{"lineBreak":true},{"text":"Evaluate my inner thoughts and motives!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For I am ever aware of your faithfulness,","poem":1},{"lineBreak":true},{"text":"and your loyalty continually motivates me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I do not associate with deceitful men,","poem":1},{"lineBreak":true},{"text":"or consort with those who are dishonest.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I hate the mob of evil men,","poem":1},{"lineBreak":true},{"text":"and do not associate with the wicked.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I maintain a pure lifestyle,","poem":1},{"lineBreak":true},{"text":"so I can appear before your altar, O Lord,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"to give you thanks,","poem":1},{"lineBreak":true},{"text":"and to tell about all your amazing deeds.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Lord, I love the temple where you live,","poem":1},{"lineBreak":true},{"text":"the place where your splendor is revealed.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Do not sweep me away with sinners,","poem":1},{"lineBreak":true},{"text":"or execute me along with violent people,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"who are always ready to do wrong","poem":1},{"lineBreak":true},{"text":"or offer a bribe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"But I have integrity!","poem":1},{"lineBreak":true},{"text":"Rescue me and have mercy on me!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I am safe,","poem":1},{"lineBreak":true},{"text":"and among the worshipers I will praise the Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}