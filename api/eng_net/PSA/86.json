{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["A prayer of David."]},{"type":"verse","number":1,"content":[{"text":"Listen O Lord! Answer me!","poem":1},{"lineBreak":true},{"text":"For I am oppressed and needy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Protect me, for I am loyal!","poem":1},{"lineBreak":true},{"text":"O my God, deliver your servant, who trusts in you!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Have mercy on me, O Lord,","poem":1},{"lineBreak":true},{"text":"for I cry out to you all day long!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Make your servant glad,","poem":1},{"lineBreak":true},{"text":"for to you, O Lord, I pray!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Certainly O Lord, you are kind and forgiving,","poem":1},{"lineBreak":true},{"text":"and show great faithfulness to all who cry out to you.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O Lord, hear my prayer!","poem":1},{"lineBreak":true},{"text":"Pay attention to my plea for mercy!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"In my time of trouble I cry out to you,","poem":1},{"lineBreak":true},{"text":"for you will answer me.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"None can compare to you among the gods, O Lord!","poem":1},{"lineBreak":true},{"text":"Your exploits are incomparable!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"All the nations, whom you created,","poem":1},{"lineBreak":true},{"text":"will come and worship you, O Lord.","poem":1},{"lineBreak":true},{"text":"They will honor your name.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"For you are great and do amazing things.","poem":1},{"lineBreak":true},{"text":"You alone are God.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O Lord, teach me how you want me to live!","poem":1},{"lineBreak":true},{"text":"Then I will obey your commands.","poem":1},{"lineBreak":true},{"text":"Make me wholeheartedly committed to you!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O Lord, my God, I will give you thanks with my whole heart!","poem":1},{"lineBreak":true},{"text":"I will honor your name continually!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"For you will extend your great loyal love to me,","poem":1},{"lineBreak":true},{"text":"and will deliver my life from the depths of Sheol.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O God, arrogant men attack me;","poem":1},{"lineBreak":true},{"text":"a gang of ruthless men, who do not respect you, seek my life.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"But you, O Lord, are a compassionate and merciful God.","poem":1},{"lineBreak":true},{"text":"You are patient and demonstrate great loyal love and faithfulness.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Turn toward me and have mercy on me!","poem":1},{"lineBreak":true},{"text":"Give your servant your strength!","poem":1},{"lineBreak":true},{"text":"Deliver your slave!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Show me evidence of your favor!","poem":1},{"lineBreak":true},{"text":"Then those who hate me will see it and be ashamed,","poem":1},{"lineBreak":true},{"text":"for you, O Lord, will help me and comfort me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}