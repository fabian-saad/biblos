{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_net","name":"Psalms","commonName":"Psalms","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"fc4557b4e2856a973bd2d27de9359765c1e9372d4a0599aa3bacf44e9797f051","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_net/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"The Lord reigns!","poem":1},{"lineBreak":true},{"text":"He is robed in majesty,","poem":1},{"lineBreak":true},{"text":"the Lord is robed,","poem":1},{"lineBreak":true},{"text":"he wears strength around his waist.","poem":1},{"lineBreak":true},{"text":"Indeed, the world is established, it cannot be moved.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Your throne has been secure from ancient times;","poem":1},{"lineBreak":true},{"text":"you have always been king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The waves roar, O Lord,","poem":1},{"lineBreak":true},{"text":"the waves roar,","poem":1},{"lineBreak":true},{"text":"the waves roar and crash.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Above the sound of the surging water,","poem":1},{"lineBreak":true},{"text":"and the mighty waves of the sea,","poem":1},{"lineBreak":true},{"text":"the Lord sits enthroned in majesty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The rules you set down are completely reliable.","poem":1},{"lineBreak":true},{"text":"Holiness aptly adorns your house, O Lord, forever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}