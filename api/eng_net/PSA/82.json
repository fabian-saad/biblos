dark,","poem":1},{"lineBreak":true},{"text":"while all the foundations of the earth crumble.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I thought, ‘You are gods;","poem":1},{"lineBreak":true},{"text":"all of you are sons of the Most High.’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yet you will die like mortals;","poem":1},{"lineBreak":true},{"text":"you will fall like all the other rulers.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rise up, O God, and execute judgment on the earth!","poem":1},{"lineBreak":true},{"text":"For you own all the nations.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}