{"translation":{"id":"eng_net","name":"NET Bible","website":"https://ebible.org/Scriptures/details.php?id=engnet","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engnet","licenseNotes":null,"shortName":"NETB","englishName":"NET Bible","language":"eng","textDirection":"ltr","sha256":"df44d46b2e1977f4c8fc4c4cad1e9cfcfff97c3ebb61b88413e62f5490d36eb0","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_net/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"SNG","translationId":"eng_net","name":"Song of Solomon","commonName":"Song of Songs","title":"Song of Songs","order":22,"numberOfChapters":8,"sha256":"ee740762bcd525103dbc9440bd593fc4e0b7543ff2ee85d866d8f4df749ba84c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_net/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/eng_net/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["The Maidens to the Beloved:"]},{"type":"verse","number":1,"content":[{"text":"Where has your beloved gone,","poem":1},{"lineBreak":true},{"text":"O most beautiful among women?","poem":1},{"lineBreak":true},{"text":"Where has your beloved turned?","poem":1},{"lineBreak":true},{"text":"Tell us, that we may seek him with you.","poem":1}]},{"type":"heading","content":["The Beloved to the Maidens:"]},{"type":"verse","number":2,"content":[{"text":"My beloved has gone down to his garden,","poem":1},{"lineBreak":true},{"text":"to the flowerbeds of balsam spices,","poem":1},{"lineBreak":true},{"text":"to graze in the gardens,","poem":1},{"lineBreak":true},{"text":"and to gather lilies.","poem":1}]},{"type":"heading","content":["Poetic Refrain: Mutual Possession"]},{"type":"heading","content":["The Beloved about Her Lover:"]},{"type":"verse","number":3,"content":[{"text":"I am my lover’s and my lover is mine;","poem":1},{"lineBreak":true},{"text":"he grazes among the lilies.","poem":1}]},{"type":"heading","content":["The Renewal of Love"]},{"type":"heading","content":["The Lover to His Beloved:"]},{"type":"verse","number":4,"content":[{"text":"My darling, you are as beautiful as Tirzah,","poem":1},{"lineBreak":true},{"text":"as lovely as Jerusalem,","poem":1},{"lineBreak":true},{"text":"as awe-inspiring as bannered armies!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Turn your eyes away from me –","poem":1},{"lineBreak":true},{"text":"they overwhelm me!","poem":1},{"lineBreak":true},{"text":"Your hair is like a flock of goats","poem":1},{"lineBreak":true},{"text":"descending from Mount Gilead.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Your teeth are like a flock of sheep","poem":1},{"lineBreak":true},{"text":"coming up from the washing;","poem":1},{"lineBreak":true},{"text":"each has its twin;","poem":1},{"lineBreak":true},{"text":"not one of them is missing.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Like a slice of pomegranate","poem":1},{"lineBreak":true},{"text":"is your forehead behind your veil.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"There may be sixty queens,","poem":1},{"lineBreak":true},{"text":"and eighty concubines,","poem":1},{"lineBreak":true},{"text":"and young women without number.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"But she is unique!","poem":1},{"lineBreak":true},{"text":"My dove, my perfect one!","poem":1},{"lineBreak":true},{"text":"She is the special daughter of her mother,","poem":1},{"lineBreak":true},{"text":"she is the favorite of the one who bore her.","poem":1},{"lineBreak":true},{"text":"The maidens saw her and complimented her;","poem":1},{"lineBreak":true},{"text":"the queens and concubines praised her:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“Who is this who appears like the dawn?","poem":1},{"lineBreak":true},{"text":"Beautiful as the moon, bright as the sun,","poem":1},{"lineBreak":true},{"text":"awe-inspiring as the stars in procession?”","poem":1}]},{"type":"heading","content":["The Return to the Vineyards"]},{"type":"heading","content":["The Lover to His Beloved:"]},{"type":"verse","number":11,"content":[{"text":"I went down to the orchard of walnut trees,","poem":1},{"lineBreak":true},{"text":"to look for the blossoms of the valley,","poem":1},{"lineBreak":true},{"text":"to see if the vines had budded","poem":1},{"lineBreak":true},{"text":"or if the pomegranates were in bloom.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I was beside myself with joy!","poem":1},{"lineBreak":true},{"text":"There please give me your myrrh,","poem":1},{"lineBreak":true},{"text":"O daughter of my princely people.","poem":1}]},{"type":"heading","content":["The Love Song and Dance"]},{"type":"heading","content":["The Lover to His Beloved:"]},{"type":"verse","number":13,"content":[{"text":"Turn , turn, O Perfect One!","poem":1},{"lineBreak":true},{"text":"Turn, turn, that I may stare at you!","poem":1},"The Beloved to Her Lover:",{"text":"Why do you gaze upon the Perfect One","poem":1},{"lineBreak":true},{"text":"like the dance of the Mahanaim?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_net/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_net/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_net/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}