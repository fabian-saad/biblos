{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"(A psalm of Dovid, when he fled from Avshalom bno)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Hashem, how are they increased that are my foes!","poem":1},{"lineBreak":true},{"text":"Many are they that rise up against me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Many there be which say of my nefesh,","poem":1},{"lineBreak":true},{"text":"There is no yeshu'ah for him in Elohim. Selah","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But Thou, Hashem, art a mogen around me;","poem":1},{"lineBreak":true},{"text":"my kavod, and the One who lifts up mine head.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I cried unto Hashem with my voice,","poem":1},{"lineBreak":true},{"text":"and He heard me out of His Har Kodesh. Selah","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I laid me down and slept;","poem":1},{"lineBreak":true},{"text":"I awaked, for Hashem sustains me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I will not be afraid of ten thousands of am (people),","poem":1},{"lineBreak":true},{"text":"that have set themselves against me round about.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arise, Hashem; hoshieini (save me), O Elohai;","poem":1},{"lineBreak":true},{"text":"for Thou hast struck all mine enemies upon the cheekbone;","poem":1},{"lineBreak":true},{"text":"Thou hast broken the teeth of the resha'im.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"HaYeshuah (salvation) belongeth unto Hashem;","poem":1},{"lineBreak":true},{"text":"the Birkhat (blessing) of Thee is upon Thy people. Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}