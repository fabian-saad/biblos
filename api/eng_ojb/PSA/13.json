{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"(For the one directing. Mizmor Dovid)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"How long wilt Thou forget me, Hashem? Netzach (forever)?","poem":1},{"lineBreak":true},{"text":"How long wilt Thou hide Thy face from me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"How long shall I take counsel in my nefesh,","poem":1},{"lineBreak":true},{"text":"having sorrow in my lev daily?","poem":1},{"lineBreak":true},{"text":"How long shall mine oyev be exalted over me?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Consider and hear me, Hashem Elohai;","poem":1},{"lineBreak":true},{"text":"enlighten mine eyes, lest I sleep the sleep of mavet;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lest mine oyev say,","poem":1},{"lineBreak":true},{"text":"I have prevailed against him;","poem":1},{"lineBreak":true},{"text":"and those that trouble me rejoice","poem":1},{"lineBreak":true},{"text":"when I am defeated.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"But I have trusted in Thy chesed;","poem":1},{"lineBreak":true},{"text":"my lev shall rejoice in Thy Yeshu'ah (salvation).","poem":1},{"lineBreak":true},{"text":"6 I will sing unto Hashem,","poem":1},{"lineBreak":true},{"text":"because He hath dealt bountifully with me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}