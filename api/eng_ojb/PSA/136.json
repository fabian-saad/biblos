{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"O give thanks unto Hashem; for He is tov;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo (His chesed indures forever).","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O give thanks unto Elohei HaElohim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O give thanks to Adonei HaAdonim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"To Him Who alone doeth nifla'ot gedolot;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To Him that by tevunah (understanding) made HaShomayim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"To Him that stretched out ha'aretz above the mayim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To Him that made ohrim gedolim (great lights);","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The shemesh to rule by yom;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The yarei'ach and kokhavim to rule by lailah;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"To Him that struck down Mitzrayim in their bechorot (firstborn);","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"And brought out Yisroel from among them;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"With a yad chazakah, and with a stretched out zero'a;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"To Him Who divided asunder Yam Suf;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"And made Yisroel to pass through the midst of it;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"But overthrew Pharaoh and his army in the Yam Suf;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"To Him Who led His people through the midbar;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"To Him Who struck down melachim gedolim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"And slaughtered mighty melachim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sichon Melech HaEmori;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"And Og Melech HaBashan;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"And gave their land for a nachalah;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Even a nachalah unto Yisroel His eved;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Who remembered us in our low estate;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"And hath released us from our enemies;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Who giveth lechem to kol basar;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"O give thanks unto the G-d of Shomayim;","poem":1},{"lineBreak":true},{"text":"ki l'olam chasdo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}