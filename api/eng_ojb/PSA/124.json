"lineBreak":true},{"text":"Then the mayim hazedonim (treacherous waters)","poem":1},{"lineBreak":true},{"text":"would have swept over nafsheinu (our nefesh).","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Baruch Hashem,","poem":1},{"lineBreak":true},{"text":"Who hath not given us up","poem":1},{"lineBreak":true},{"text":"as a prey to their shinayim (teeth).","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nafsheinu (our nefesh) is escaped as a tzippor (bird)","poem":1},{"lineBreak":true},{"text":"out of the pach (snare of the fowlers);","poem":1},{"lineBreak":true},{"text":"the pach is broken,","poem":1},{"lineBreak":true},{"text":"and we are escaped.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ezreinu (our help) B'Shem Hashem","poem":1},{"lineBreak":true},{"text":"Oseh Shomayim vaAretz.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}