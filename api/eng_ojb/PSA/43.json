{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Vindicate me, O Elohim,","poem":1},{"lineBreak":true},{"text":"and plead my cause against a nation lo chasid;","poem":1},{"lineBreak":true},{"text":"O deliver me from the ish mirmah v'avlah","poem":1},{"lineBreak":true},{"text":"(deceitful and unjust man).","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For Thou art the Elohei Ma'oz of me.","poem":1},{"lineBreak":true},{"text":"Why dost Thou cast me off?","poem":1},{"lineBreak":true},{"text":"Why must I go mourning","poem":1},{"lineBreak":true},{"text":"because of the oppression of the oyev?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O send out Thy Ohr and Thy Emes;","poem":1},{"lineBreak":true},{"text":"let them guide me;","poem":1},{"lineBreak":true},{"text":"let them bring me unto Thy Har Kodesh,","poem":1},{"lineBreak":true},{"text":"and to Thy Mishkan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then will I go unto the Mizbe'ach of Elohim,","poem":1},{"lineBreak":true},{"text":"unto El my exceeding joy;","poem":1},{"lineBreak":true},{"text":"yea, upon the kinnor will I praise Thee,","poem":1},{"lineBreak":true},{"text":"O Elohim Elohai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Why art thou cast down, O my nefesh?","poem":1},{"lineBreak":true},{"text":"And why art thou disquieted within me?","poem":1},{"lineBreak":true},{"text":"Hope in Elohim; for I shall yet praise Him,","poem":1},{"lineBreak":true},{"text":"Who is the Yeshu'ot of my countenance, and Elohai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}