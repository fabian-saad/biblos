{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"(For the one directing. With stringed instruments. Of Dovid)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Hear my cry, Elohim;","poem":1},{"lineBreak":true},{"text":"attend unto my tefillah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the end of ha'aretz will I call unto Thee,","poem":1},{"lineBreak":true},{"text":"when my lev is overwhelmed;","poem":1},{"lineBreak":true},{"text":"lead me to the Tzur","poem":1},{"lineBreak":true},{"text":"that is higher than I.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For Thou hast been a refuge for me,","poem":1},{"lineBreak":true},{"text":"and a migdal oz (tower of strength) from the enemy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I will abide in Thy ohel forever;","poem":1},{"lineBreak":true},{"text":"I will take refuge in the covert of Thy wings.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"For Thou, Elohim, hast heard my nederim;","poem":1},{"lineBreak":true},{"text":"Thou hast given me the yerushat yirei Shemecha","poem":1},{"lineBreak":true},{"text":"(inheritance of those that fear Thy Name).","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Thou wilt prolong days of the Melech,","poem":1},{"lineBreak":true},{"text":"and his shanot dor vador.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He shall abide before Elohim forever;","poem":1},{"lineBreak":true},{"text":"O appoint chesed and emes, to preserve him.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"So will I sing praise unto Shimecha forever,","poem":1},{"lineBreak":true},{"text":"that I may yom yom (daily) perform my nederim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}