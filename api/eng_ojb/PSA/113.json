{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye Hashem.","poem":1},{"lineBreak":true},{"text":"Praise O ye avadim of Hashem,","poem":1},{"lineBreak":true},{"text":"praise the Shem of Hashem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Blessed be the Shem of Hashem","poem":1},{"lineBreak":true},{"text":"from this time forth and forevermore.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"From the rising of the shemesh unto the going down of the same","poem":1},{"lineBreak":true},{"text":"the Shem of Hashem is to be praised.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hashem is high above kol Goyim,","poem":1},{"lineBreak":true},{"text":"and His kavod above HaShomayim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who is like unto Hashem Eloheinu,","poem":1},{"lineBreak":true},{"text":"Who dwelleth on high,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Who stoopeth down to behold the things","poem":1},{"lineBreak":true},{"text":"that are in Shomayim, and in ha'aretz!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He raiseth up the poor out of the aphar (dust),","poem":1},{"lineBreak":true},{"text":"and lifteth the needy out of the ash heap;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"That he may seat him with princes,","poem":1},{"lineBreak":true},{"text":"even with the princes of amo (His people).","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He settleth the akeret (barren woman) in her bais","poem":1},{"lineBreak":true},{"text":"to be a happy em of banim.","poem":1},{"lineBreak":true},{"text":"Praise ye Hashem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}