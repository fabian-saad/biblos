{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"(Shir HaMa'alot [Song of Ascents], of Dovid)","descriptive":true},{"text":"1 I was glad when they said unto me,","poem":1},{"lineBreak":true},{"text":"Let us go into the Bais Hashem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Our feet shall stand within thy she'arim,","poem":1},{"lineBreak":true},{"text":"O Yerushalayim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerushalayim is built as an Ir","poem":1},{"lineBreak":true},{"text":"bound firmly together;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"That is where the Shevatim (tribes) go up,","poem":1},{"lineBreak":true},{"text":"the Shivtei Hashem,","poem":1},{"lineBreak":true},{"text":"according to the edut l'Yisroel (the statute to Yisroel),","poem":1},{"lineBreak":true},{"text":"to give thanks unto the Shem of Hashem.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For there are set kise'ot l'mishpat (thrones of judgment),","poem":1},{"lineBreak":true},{"text":"the kise'ot of the Bais Dovid.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sha'alu shalom Yerushalayim (pray for the peace of Jerusalem);","poem":1},{"lineBreak":true},{"text":"they shall prosper that love thee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shalom be within thy wall,","poem":1},{"lineBreak":true},{"text":"and security within thy citadels.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"L'ma'an (for the sake of) my achim and companions,","poem":1},{"lineBreak":true},{"text":"I will now say, Shalom be within thee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"L'ma'an the Bais Hashem Eloheinu","poem":1},{"lineBreak":true},{"text":"I will seek thy tov.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}