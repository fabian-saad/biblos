{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"(For the one directing. Of Dovid)","descriptive":true},{"text":"1 In Hashem do I take refuge;","poem":1},{"lineBreak":true},{"text":"how say ye to my nefesh,","poem":1},{"lineBreak":true},{"text":"Flee as a bird to your mountain?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For, hinei, the resha'im bend their bow,","poem":1},{"lineBreak":true},{"text":"they make ready their arrow upon the string,","poem":1},{"lineBreak":true},{"text":"that they may secretly shoot at the yishrei lev (upright in heart).","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"If the foundations be destroyed,","poem":1},{"lineBreak":true},{"text":"what can the tzaddik do?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hashem is in His Heikhal Kodesh,","poem":1},{"lineBreak":true},{"text":"Hashemʼs kisse is in Shomayim;","poem":1},{"lineBreak":true},{"text":"His eyes examine,","poem":1},{"lineBreak":true},{"text":"His eyelids try, Bnei Adam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hashem trieth the tzaddik,","poem":1},{"lineBreak":true},{"text":"but the resha'im and him that loveth chamas (violence)","poem":1},{"lineBreak":true},{"text":"His Nefesh hateth.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Upon the resha'im He shall rain snares,","poem":1},{"lineBreak":true},{"text":"eish and gofrit,","poem":1},{"lineBreak":true},{"text":"and a burning wind;","poem":1},{"lineBreak":true},{"text":"this shall be the portion of their kos (cup).","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For Hashem is tzaddik (righteous), Hashem loveth tzedakot;","poem":1},{"lineBreak":true},{"text":"His countenance doth behold the yashar (upright).","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}