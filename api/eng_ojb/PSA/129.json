{"lineBreak":true},{"text":"and turned back that hate Tziyon.","poem":1},{"noteId":164}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let them be as the khatzir (grass) upon the housetops,","poem":1},{"lineBreak":true},{"text":"which withereth before it groweth up;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"With it the kotzer (reaper) filleth not his yad;","poem":1},{"lineBreak":true},{"text":"nor he that gathereth sheaves, his bosom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neither do they which go by say,","poem":1},{"lineBreak":true},{"text":"Birkat Hashem be upon you;","poem":1},{"lineBreak":true},{"text":"we bless you b'Shem Hashem.","poem":1}]}],"footnotes":[{"noteId":164,"caller":"+","text":"i.e, all anti-Semites","reference":{"chapter":129,"verse":5}}]},"thisChapterLink":"/api/eng_ojb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}