{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"(Maskil of Dovid; A tefillah when he was in the me'arah)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"I cried out unto Hashem with my voice;","poem":1},{"lineBreak":true},{"text":"with my voice unto Hashem did I make my techinnah (supplication).","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I poured out my complaint before Him;","poem":1},{"lineBreak":true},{"text":"I showed before Him my tzoros.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"When my ruach became faint within me,","poem":1},{"lineBreak":true},{"text":"then Thou had da'as of my path.","poem":1},{"lineBreak":true},{"text":"In the way wherein I walked","poem":1},{"lineBreak":true},{"text":"have they laid a pach (snare, hidden trap) for me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I looked on my right, and behold,","poem":1},{"lineBreak":true},{"text":"there was no man that would know me;","poem":1},{"lineBreak":true},{"text":"refuge failed me;","poem":1},{"lineBreak":true},{"text":"no man cared for my nefesh.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I cried unto Thee,","poem":1},{"lineBreak":true},{"text":"Hashem; I said,","poem":1},{"lineBreak":true},{"text":"Thou art my refuge and my chelek (portion) in the Eretz HaChayyim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Attend unto my cry;","poem":1},{"lineBreak":true},{"text":"for I am brought very low;","poem":1},{"lineBreak":true},{"text":"save me from my persecutors;","poem":1},{"lineBreak":true},{"text":"for they are stronger than I.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Release my nefesh from prison, to praise Shemecha (Thy Name);","poem":1},{"lineBreak":true},{"text":"the tzaddikim shall gather about me;","poem":1},{"lineBreak":true},{"text":"for Thou shalt deal bountifully with me.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}