{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"(Of the Bnei Korach. A mizmor. A shir)","descriptive":true},{"text":"1 On the Harei Kodesh (Holy Mountain) stands His foundation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hashem loveth the sha'arei Tziyon","poem":1},{"lineBreak":true},{"text":"more than all the mishkenot Ya'akov.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Glorious things are spoken of thee,","poem":1},{"lineBreak":true},{"text":"O Ir HaElohim.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"To them that know me, I will make mention of Rachav and Babylon;","poem":1},{"lineBreak":true},{"text":"hinei, Philistia, and Tzor, with Ethiopia:","poem":1},{"lineBreak":true},{"text":"this man was born there.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But of Tziyon it shall be said,","poem":1},{"lineBreak":true},{"text":"This one and that one were born in her;","poem":1},{"lineBreak":true},{"text":"and Elyon Himself shall establish it.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hashem shall register, when He writeth up the people,","poem":1},{"lineBreak":true},{"text":"that this one was born there.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"The sharim (ones singing) as well as the cholelim (players on instruments) shall be there;","poem":1},{"lineBreak":true},{"text":"all my fountains are in thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}