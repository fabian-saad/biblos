{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"(Mizmor of Asaph)","descriptive":true},{"text":"1 Elohim standeth in the Adat El;","poem":1},{"lineBreak":true},{"text":"He judgeth among the elohim.","poem":1},{"noteId":116}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ad mosai (How long) will ye judge unjustly,","poem":1},{"lineBreak":true},{"text":"and show partiality to the resha'im?","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Defend the poor and yatom (fatherless);","poem":1},{"lineBreak":true},{"text":"do justice to the oni (afflicted) and needy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Deliver the poor and needy;","poem":1},{"lineBreak":true},{"text":"rid them out of the yad resha'im.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"They know not, neither will they understand;","poem":1},{"lineBreak":true},{"text":"they walk on in choshech;","poem":1},{"lineBreak":true},{"text":"all the foundations of ha'aretz are shaken.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have said, elohim ye are;","poem":1},{"lineBreak":true},{"text":"and all of you are Bnei HaElyon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But ye shall die like adam,","poem":1},{"lineBreak":true},{"text":"and fall like one of the sarim (princes).","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arise, Elohim, judge ha'aretz;","poem":1},{"lineBreak":true},{"text":"for Thou shalt inherit kol HaGoyim.","poem":1}]}],"footnotes":[{"noteId":116,"caller":"+","text":"See Ps 82:6and Yn 10:34","reference":{"chapter":82,"verse":1}}]},"thisChapterLink":"/api/eng_ojb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}