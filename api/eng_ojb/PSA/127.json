"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"As khitzim (arrows) are in the yad of a gibbor;","poem":1},{"lineBreak":true},{"text":"so are bnei haneurim (children born in oneʼs youth).","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashrei hagever that hath his quiver full of them;","poem":1},{"lineBreak":true},{"text":"they shall not be ashamed,","poem":1},{"lineBreak":true},{"text":"but they shall speak with the oyevim basha'ar (enemy at the gate).","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}