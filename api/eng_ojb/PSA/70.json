{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"(For the one directing. Mizmor of Dovid. For the memorial portion of the minchah)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Make haste, Elohim, to deliver me;","poem":1},{"lineBreak":true},{"text":"make haste to help me, Hashem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them have bushah and be confounded","poem":1},{"lineBreak":true},{"text":"that seek my nefesh;","poem":1},{"lineBreak":true},{"text":"let them be turned back, and be put to confusion,","poem":1},{"lineBreak":true},{"text":"that desire my hurt.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let them be turned back for a reward of their bushah","poem":1},{"lineBreak":true},{"text":"that say, Aha, aha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Let all those that seek Thee","poem":1},{"lineBreak":true},{"text":"rejoice and have simcha in Thee;","poem":1},{"lineBreak":true},{"text":"and let such as love Thy Yeshu'ah (salvation) say continually:","poem":1},{"lineBreak":true},{"text":"Let Elohim be magnified.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"But I am poor and needy;","poem":1},{"lineBreak":true},{"text":"make haste unto me, Elohim;","poem":1},{"lineBreak":true},{"text":"Thou art my help and my deliverer.","poem":1},{"lineBreak":true},{"text":"Hashem, make no delay.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}