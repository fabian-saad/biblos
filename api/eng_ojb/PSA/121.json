},{"lineBreak":true},{"text":"Hashem is thy shade upon thy right hand.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The shemesh shall not strike thee by day,","poem":1},{"lineBreak":true},{"text":"nor the yarei'ach by night.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hashem shall preserve thee from kol rah;","poem":1},{"lineBreak":true},{"text":"He shall preserve thy nefesh.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hashem shall be shomer over thy going out and thy coming in","poem":1},{"lineBreak":true},{"text":"from this time forth, and even v'ad olam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}