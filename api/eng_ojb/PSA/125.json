{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"(Shir HaMa'alot [Song of Ascents])","descriptive":true},{"text":"1They that trust in Hashem","poem":1},{"lineBreak":true},{"text":"shall be as Mount Tziyon, which is immoveable,","poem":1},{"lineBreak":true},{"text":"and abideth l'olam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"As harim (the mountains) surround Yerushalayim,","poem":1},{"lineBreak":true},{"text":"so Hashem surrounds His people","poem":1},{"lineBreak":true},{"text":"from henceforth v'ad olam (and to forever).","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the shevet (scepter) of the resha shall not rest","poem":1},{"lineBreak":true},{"text":"upon the goral (allotment, property) of the tzaddikim;","poem":1},{"lineBreak":true},{"text":"lest the tzaddikim put forth","poem":1},{"lineBreak":true},{"text":"their hands unto iniquity.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Do good, Hashem, unto the tovim,","poem":1},{"lineBreak":true},{"text":"and to them that are upright in their hearts.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As for such as turn aside unto their crooked ways,","poem":1},{"lineBreak":true},{"text":"Hashem shall turn them away with the workers of iniquity;","poem":1},{"lineBreak":true},{"text":"but shalom shall be upon Yisroel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}