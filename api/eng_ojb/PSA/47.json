{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"(For the one directing. Of the Bnei Korach. A Mizmor)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"O clap your hands, all ye nations;","poem":1},{"lineBreak":true},{"text":"shout unto Elohim with the voice of joy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For Hashem Elyon is awesome;","poem":1},{"lineBreak":true},{"text":"He is Melech Gadol over kol ha'aretz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He shall subdue the peoples under us,","poem":1},{"lineBreak":true},{"text":"and the nations under our raglayim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He shall choose nachalateinu for us,","poem":1},{"lineBreak":true},{"text":"the ga'on Ya'akov (pride, glory of Jacob) whom He loves.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Elohim is ascended with a shout of joy,","poem":1},{"lineBreak":true},{"text":"Hashem with the sound of a shofar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sing praises to Elohim, sing praises;","poem":1},{"lineBreak":true},{"text":"sing praises unto Malkeinu, sing praises.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For Melech kol ha'aretz is He;","poem":1},{"lineBreak":true},{"text":"sing ye praises with understanding.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Elohim reigneth over the Goyim;","poem":1},{"lineBreak":true},{"text":"Elohim sitteth upon the Kisse Kadsho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The princes of the nations are gathered together,","poem":1},{"lineBreak":true},{"text":"even the Am Elohei Avraham;","poem":1},{"lineBreak":true},{"text":"for the moginei Eretz (shields of the Earth) belong unto Elohim;","poem":1},{"lineBreak":true},{"text":"He is greatly exalted.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}