{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Praise Hashem.","poem":1},{"lineBreak":true},{"text":"Shiru l'Adonoi shir chadash (Sing unto Hashem a new song),","poem":1},{"lineBreak":true},{"text":"and His praise in the Kahal Chasidim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Yisroel rejoice in Him that made him;","poem":1},{"lineBreak":true},{"text":"let the Bnei Tziyon be glad in their Melech.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise Shmo in the dance;","poem":1},{"lineBreak":true},{"text":"let them sing zemirot unto Him with the tambourine and kinnor.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For Hashem taketh pleasure in His people;","poem":1},{"lineBreak":true},{"text":"He will crown the meek with Yeshu'ah (salvation).","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the Chasidim be joyful in kavod;","poem":1},{"lineBreak":true},{"text":"let them sing for joy upon their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let the high praises of G-d be in their mouth,","poem":1},{"lineBreak":true},{"text":"and a two-edged sword in their hand;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance upon the Goyim,","poem":1},{"lineBreak":true},{"text":"and punishments upon the people;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their melachim with chains,","poem":1},{"lineBreak":true},{"text":"and their nobles with shackles of barzel (iron);","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute upon them the mishpat katuv (written judgment);","poem":1},{"lineBreak":true},{"text":"this honor have all His Chasidim.","poem":1},{"lineBreak":true},{"text":"Hallelu Hashem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}