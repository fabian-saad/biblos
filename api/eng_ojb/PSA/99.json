{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Hashem reigneth;","poem":1},{"lineBreak":true},{"text":"let the nations tremble;","poem":1},{"lineBreak":true},{"text":"He sitteth between the keruvim;","poem":1},{"lineBreak":true},{"text":"let ha'aretz be shaken.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hashem is great in Tziyon;","poem":1},{"lineBreak":true},{"text":"and He is high above all the nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise Thy Shem gadol v'nora;","poem":1},{"lineBreak":true},{"text":"for it is kadosh.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Mighty King also loveth mishpat;","poem":1},{"lineBreak":true},{"text":"Thou dost establish equity,","poem":1},{"lineBreak":true},{"text":"Thou executest mishpat and tzedakah in Ya'akov.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Exalt ye Hashem Eloheinu,","poem":1},{"lineBreak":true},{"text":"and worship at His footstool; for He is kadosh.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moshe and Aharon among His kohanim,","poem":1},{"lineBreak":true},{"text":"and Shmuel among them that call upon Shmo;","poem":1},{"lineBreak":true},{"text":"they called upon Hashem,","poem":1},{"lineBreak":true},{"text":"and He answered them.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He spoke unto them in the ammud anan (pillar of cloud);","poem":1},{"lineBreak":true},{"text":"they were shomer over His statutes,","poem":1},{"lineBreak":true},{"text":"and the chok (ordinance) that He gave them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Thou answeredst them, Hashem Eloheinu;","poem":1},{"lineBreak":true},{"text":"Thou wast El (G-d) that forgavest them,","poem":1},{"lineBreak":true},{"text":"though Thou tookest vengeance of their misdeeds.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Exalt Hashem Eloheinu,","poem":1},{"lineBreak":true},{"text":"and worship at His Har Kodesh;","poem":1},{"lineBreak":true},{"text":"for Hashem Eloheinu is kadosh.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}