t":"Woe is me, that I sojourn in Meshech,","poem":1},{"lineBreak":true},{"text":"that I dwell in the ohalim of Kedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My nefesh hath long dwelt","poem":1},{"lineBreak":true},{"text":"with him that hateth shalom.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I am for shalom;","poem":1},{"lineBreak":true},{"text":"but when I speak, they are for milchamah (war).","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}