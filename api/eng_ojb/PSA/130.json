{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"(Shir HaMa'alot)","descriptive":true},{"text":"1 Out of the depths have I cried unto Thee, Hashem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Adonoi, hear my voice;","poem":1},{"lineBreak":true},{"text":"let Thine ears be attentive","poem":1},{"lineBreak":true},{"text":"to the voice of my techinnot (supplications).","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"If Thou, Hashem, shouldest record iniquities,","poem":1},{"lineBreak":true},{"text":"Adonoi, who could stand?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But there is selichah (forgiveness) with Thee;","poem":1},{"lineBreak":true},{"text":"therefore, Thou art feared.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I wait for Hashem,","poem":1},{"lineBreak":true},{"text":"my nefesh doth wait,","poem":1},{"lineBreak":true},{"text":"and in His Devar do I hope.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My nefesh waiteth for Adonoi","poem":1},{"lineBreak":true},{"text":"more than the shomrim that watch for the boker;","poem":1},{"lineBreak":true},{"text":"I say, more than the shomrim that watch for the boker.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Let Yisroel hope in Hashem;","poem":1},{"lineBreak":true},{"text":"for with Hashem there is chesed,","poem":1},{"lineBreak":true},{"text":"and with Him is plenteous pedut (redemption).","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"And He shall redeem Yisroel from all his iniquities.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}