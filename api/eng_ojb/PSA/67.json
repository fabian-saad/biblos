:true},{"text":"for Thou shalt judge the people righteously,","poem":1},{"lineBreak":true},{"text":"and govern the peoples upon HaAretz.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Let the people praise Thee, O Elohim;","poem":1},{"lineBreak":true},{"text":"let kol Amim praise Thee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Then shall eretz yield her yevul (increase, produce, harvest);","poem":1},{"lineBreak":true},{"text":"and Elohim, even Eloheinu, shall put a brocha upon us.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Elohim shall bless us;","poem":1},{"lineBreak":true},{"text":"and kol afsei aretz (all the ends of the earth) shall fear Him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}