 fortunes, Hashem,","poem":1},{"lineBreak":true},{"text":"like torrents in the Negev.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They that sow in dimah (tears)","poem":1},{"lineBreak":true},{"text":"shall reap in rinnah (joyful song).","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He that goeth forth and weepeth,","poem":1},{"lineBreak":true},{"text":"bearing meshek hazara (seed to be sown)","poem":1},{"lineBreak":true},{"text":"shall doubtless come again with rinnah,","poem":1},{"lineBreak":true},{"text":"bearing his alummot (sheaves).","poem":1},{"noteId":163}]}],"footnotes":[{"noteId":163,"caller":"+","text":"of harvest","reference":{"chapter":126,"verse":6}}]},"thisChapterLink":"/api/eng_ojb/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}