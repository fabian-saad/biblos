{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"(Of Dovid. Mizmor)","descriptive":true},{"text":"1Hashem said unto Adoni,","poem":1},{"noteId":143},{"lineBreak":true},{"text":"Sit thou at My right hand,","poem":1},{"lineBreak":true},{"text":"until I make thine enemies","poem":1},{"lineBreak":true},{"text":"a footstool for thy feet.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hashem shall stretch forth","poem":1},{"lineBreak":true},{"text":"the rod of thy might out of Tziyon;","poem":1},{"lineBreak":true},{"text":"rule thou in the midst of thine","poem":1},{"noteId":144},{"text":"enemies.","poem":1},{"noteId":145}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Thy","poem":1},{"noteId":146},{"text":"people, willing in the Day of thy","poem":1},{"noteId":147},{"text":"Army,","poem":1},{"lineBreak":true},{"text":"will be arrayed in the splendor of kodesh (holiness);","poem":1},{"lineBreak":true},{"text":"from the womb of the dawn,","poem":1},{"lineBreak":true},{"text":"cometh to thee","poem":1},{"noteId":148},{"text":"thy young men","poem":1},{"noteId":149},{"text":"as the tal (dew).","poem":1},{"noteId":150}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hashem hath sworn, and will not relent,","poem":1},{"lineBreak":true},{"text":"Thou","poem":1},{"noteId":151},{"text":"art a kohen l'olam al divrati Malki-Tzedek","poem":1},{"lineBreak":true},{"text":"(kohen forever in respect to the order of Malki-Tzedek).","poem":1},{"noteId":152}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Adonoi at thy right hand shall dash melachim (kings)","poem":1},{"lineBreak":true},{"text":"in pieces in the Yom Afo (Day of His Wrath).","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He","poem":1},{"noteId":153},{"text":"shall judge among the Goyim,","poem":1},{"lineBreak":true},{"text":"He shall heap up geviyyot (corpses);","poem":1},{"lineBreak":true},{"text":"He shall dash in pieces Rosh (Head);","poem":1},{"noteId":154},{"text":"al Eretz Rabbah (over Great, Whole Earth).","poem":1},{"noteId":155}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Of the brook in the Derech shall he","poem":1},{"noteId":156},{"text":"drink;","poem":1},{"lineBreak":true},{"text":"therefore shall he lift up [as victor] the Rosh.","poem":1},{"noteId":157}]}],"footnotes":[{"noteId":143,"caller":"+","text":"i.e., Moshiach Adoneinu; Mal 3:1","reference":{"chapter":110,"verse":1}},{"noteId":144,"caller":"+","text":"Moshiachʼs","reference":{"chapter":110,"verse":2}},{"noteId":145,"caller":"+","text":"i.e., anti-Moshiachs","reference":{"chapter":110,"verse":2}},{"noteId":146,"caller":"+","text":"Moshiachʼs Messianic","reference":{"chapter":110,"verse":3}},{"noteId":147,"caller":"+","text":"Moshiachʼs called up","reference":{"chapter":110,"verse":3}},{"noteId":148,"caller":"+","text":"Moshiach","reference":{"chapter":110,"verse":3}},{"noteId":149,"caller":"+","text":"cf Isa 53:10","reference":{"chapter":110,"verse":3}},{"noteId":150,"caller":"+","text":"Rv 19:14","reference":{"chapter":110,"verse":3}},{"noteId":151,"caller":"+","text":"Moshiach","reference":{"chapter":110,"verse":4}},{"noteId":152,"caller":"+","text":"see Gn 14:18; note it is the kohen who makes kapporah for sin — see Lv 4:20; Isa 53:8","reference":{"chapter":110,"verse":4}},{"noteId":153,"caller":"+","text":"Adonoi acting through Moshiach","reference":{"chapter":110,"verse":6}},{"noteId":154,"caller":"+","text":"Gn 3:15","reference":{"chapter":110,"verse":6}},{"noteId":155,"caller":"+","text":"cf 2Th 2:8","reference":{"chapter":110,"verse":6}},{"noteId":156,"caller":"+","text":"Moshiach","reference":{"chapter":110,"verse":7}},{"noteId":157,"caller":"+","text":"Moshiachʼs head; Pp 2:8-10; Ep 4:15","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/eng_ojb/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}