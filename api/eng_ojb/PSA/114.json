{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Yisroel went out of Mitzrayim,","poem":1},{"lineBreak":true},{"text":"Bais Ya'akov from a people of foreign tongue,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yehudah was His kodesh (sanctuary),","poem":1},{"lineBreak":true},{"text":"and Yisroel His dominion.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The yam saw it, and fled;","poem":1},{"lineBreak":true},{"text":"Yarden was driven back.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The harim skipped like rams,","poem":1},{"lineBreak":true},{"text":"and the little hills like lambs.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"What ailed thee, O thou yam, that thou didst flee?","poem":1},{"lineBreak":true},{"text":"Thou Yarden, that thou wast driven back?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye harim, that ye skipped like rams;","poem":1},{"lineBreak":true},{"text":"and ye little hills, like lambs?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tremble, thou earth, at the presence of Hashem,","poem":1},{"lineBreak":true},{"text":"at the presence of Elohei Ya'akov;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Which turned the rock into a pool of mayim,","poem":1},{"lineBreak":true},{"text":"the flint into a spring of mayim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}