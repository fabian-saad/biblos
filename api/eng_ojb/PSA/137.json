{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon,","poem":1},{"lineBreak":true},{"text":"there we sat down, yes, we wept,","poem":1},{"lineBreak":true},{"text":"when we remembered Tziyon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"We hung up our kinnorot (lyres)","poem":1},{"lineBreak":true},{"text":"upon the willows in the midst thereof.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that carried us away captive","poem":1},{"lineBreak":true},{"text":"required of us a shir (song);","poem":1},{"lineBreak":true},{"text":"and they that tormented us required of us simchah,","poem":1},{"lineBreak":true},{"text":"saying, Sing us one of the Shir Tziyon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"How shall we sing Shir Hashem","poem":1},{"lineBreak":true},{"text":"in an admat nekhar (foreign land).","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget thee, O Yerushalayim,","poem":1},{"lineBreak":true},{"text":"let my yamin (right hand) forget.","poem":1},{"noteId":170}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"If I do not remember thee,","poem":1},{"lineBreak":true},{"text":"let my leshon cleave to the roof of my mouth;","poem":1},{"lineBreak":true},{"text":"if I prefer not Yerushalayim","poem":1},{"lineBreak":true},{"text":"above my rosh simchah (chief joy).","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Remember, Hashem, the Bnei Edom","poem":1},{"lineBreak":true},{"text":"in the Yom Yerushalayim;","poem":1},{"lineBreak":true},{"text":"who said, Raze it, raze it,","poem":1},{"lineBreak":true},{"text":"even to the yesod (foundation) thereof.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Bat Bavel, who art to be destroyed,","poem":1},{"lineBreak":true},{"text":"ashrei shall he be, that repayeth thee","poem":1},{"lineBreak":true},{"text":"the gemul thou hast done to us.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ashrei shall he be,","poem":1},{"lineBreak":true},{"text":"that taketh and dasheth thy olalim against the sela.","poem":1}]}],"footnotes":[{"noteId":170,"caller":"+","text":"i.e., have paralysis","reference":{"chapter":137,"verse":5}}]},"thisChapterLink":"/api/eng_ojb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}