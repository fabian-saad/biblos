{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":[{"text":"(For the one directing. On stringed instruments. Mizmor of Asaph. Shir)","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"In Yehudah is Elohim known;","poem":1},{"lineBreak":true},{"text":"Shmo is gadol in Yisroel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"In Shalem","poem":1},{"noteId":107},{"text":"also is His Sukkah,","poem":1},{"lineBreak":true},{"text":"and His Ma'on (dwelling place) in Tziyon.","poem":1},{"noteId":108}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"There He broke the flashing arrows,","poem":1},{"lineBreak":true},{"text":"the mogen, and the cherev, and the milchamah.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Thou art more glorious and adir (majestic)","poem":1},{"lineBreak":true},{"text":"than the mountains of prey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The stouthearted are plundered;","poem":1},{"lineBreak":true},{"text":"now their last sleep they sleep;","poem":1},{"lineBreak":true},{"text":"and none of the anshei chayil can find their hands.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"At Thy rebuke, O Elohei Ya'akov,","poem":1},{"lineBreak":true},{"text":"both the merkavah and sus are cast into a dead sleep.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Thou, even Thou, art to be feared;","poem":1},{"lineBreak":true},{"text":"and who may stand in Thy sight","poem":1},{"lineBreak":true},{"text":"when once Thou art angry?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Thou didst pronounce din (sentence, judgment) from Shomayim;","poem":1},{"lineBreak":true},{"text":"Eretz feared, and was still,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"When Elohim arose to mishpat,","poem":1},{"lineBreak":true},{"text":"to save all the meek of Eretz.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Surely the chamat adam (the wrath of man) shall praise Thee;","poem":1},{"lineBreak":true},{"text":"the she'erit (remnant, survivor) of wrath shalt Thou restrain.","poem":1},{"noteId":109}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Make neder (vow), and pay unto Hashem Eloheichem;","poem":1},{"lineBreak":true},{"text":"let all that be around Him bring gifts unto Him that ought to be feared.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"He shall cut short the ruach of negidim (nobles);","poem":1},{"lineBreak":true},{"text":"He is fearsome to the Malkhei-Aretz (Kings of the Earth).","poem":1}]}],"footnotes":[{"noteId":107,"caller":"+","text":"i.e., Yerushalayim","reference":{"chapter":76,"verse":3}},{"noteId":108,"caller":"+","text":"See Yochanan chp 14","reference":{"chapter":76,"verse":3}},{"noteId":109,"caller":"+","text":"from doing evil","reference":{"chapter":76,"verse":11}}]},"thisChapterLink":"/api/eng_ojb/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}