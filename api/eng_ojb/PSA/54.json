{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"(For the director. With stringed instruments. A maskil. For Dovid,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"when the Ziphim came and said to Sha'ul, Dovid is in hiding among us)","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Hoshieini (save me), O Elohim, by Shimecha,","poem":1},{"lineBreak":true},{"text":"and vindicate me by Thy gevurah (might, power).","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hear my tefillah, O Elohim;","poem":1},{"lineBreak":true},{"text":"give ear to the words of my mouth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For zarim (strangers) are risen up against me,","poem":1},{"lineBreak":true},{"text":"and oppressors seek after my nefesh;","poem":1},{"lineBreak":true},{"text":"they have not set Elohim before them.","poem":1},{"lineBreak":true},{"text":"Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hinei, Elohim is mine Ozer (helper);","poem":1},{"lineBreak":true},{"text":"Adonoi is with them that uphold my nefesh.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall recompense the rah (evil) unto mine enemies;","poem":1},{"lineBreak":true},{"text":"in Thy emes cut them off.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I will sacrifice a nedavah (freewill offering) unto Thee;","poem":1},{"lineBreak":true},{"text":"I will praise Shimecha, Hashem; for it is tov (good).","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For He hath delivered me out of all my tzoros;","poem":1},{"lineBreak":true},{"text":"and mine eye hath looked in triumph upon mine oyevim (enemies.)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}