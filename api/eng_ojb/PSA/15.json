{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ojb","name":"TEHILLIM","commonName":"Psalms","title":"Tehillim","order":19,"numberOfChapters":150,"sha256":"8592f6696937a044311c72e6bd1b6b05bc18cb512011f0bbfcf786a4235b0552","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ojb/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"(Mizmor Dovid)","descriptive":true},{"text":"1Hashem, who shall abide in Thy Ohel?","poem":1},{"lineBreak":true},{"text":"Who shall dwell in Thy Har Kodesh?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"He that walketh blamelessly, and worketh tzedek,","poem":1},{"lineBreak":true},{"text":"and speaketh emes from his lev.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He that backbiteth not with his leshon,","poem":1},{"lineBreak":true},{"text":"nor doeth ra'ah to his re'a,","poem":1},{"lineBreak":true},{"text":"nor taketh up a slur to discredit his neighbor.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In whose eyes a vile person is despicable;","poem":1},{"lineBreak":true},{"text":"but he honoreth them that fear Hashem.","poem":1},{"lineBreak":true},{"text":"He that sweareth to his own hurt, and changeth not.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He that putteth not out his kesef to neshekh (usury),","poem":1},{"lineBreak":true},{"text":"nor taketh bribes against the naki (innocent).","poem":1},{"lineBreak":true},{"text":"He that doeth these things shall never be shaken.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}