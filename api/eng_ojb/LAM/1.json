{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"LAM","translationId":"eng_ojb","name":"EKHAH","commonName":"Lamentations","title":"Ekhah","order":25,"numberOfChapters":5,"sha256":"61d05c29814cd0408f94f7459ae311152b511c0afe7bf94716a54d9ad5873e6f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/eng_ojb/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"How doth HaIr (the city, Yerushalayim) sit solitary,","poem":1},{"lineBreak":true},{"text":"that was full of people!","poem":1},{"lineBreak":true},{"text":"How is she become like an almanah (widow)!","poem":1},{"lineBreak":true},{"text":"She that was great among the Goyim,","poem":1},{"lineBreak":true},{"text":"and sarah (princess) among the provinces,","poem":1},{"lineBreak":true},{"text":"how is she become a forced laborer!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"She weepeth bitterly in the lailah (night),","poem":1},{"lineBreak":true},{"text":"and her tears are on her cheeks;","poem":1},{"lineBreak":true},{"text":"among all her lovers she hath no Menachem (comforter);","poem":1},{"lineBreak":true},{"text":"all her friends have dealt treacherously with her;","poem":1},{"lineBreak":true},{"text":"they have become her enemies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yehudah is gone into the Golus (Exile) under affliction,","poem":1},{"lineBreak":true},{"text":"and under great avodah (servitude);","poem":1},{"lineBreak":true},{"text":"she dwelleth among the Goyim;","poem":1},{"lineBreak":true},{"text":"she findeth no manoach (rest);","poem":1},{"lineBreak":true},{"text":"all her rodefim (persecutors)","poem":1},{"lineBreak":true},{"text":"overtook her in dire straits.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The darkhei Tziyon (approaches to Tziyon) do mourn,","poem":1},{"lineBreak":true},{"text":"because none come to mo'ed (set feasts);","poem":1},{"lineBreak":true},{"text":"all her she'arim (gates) are desolate;","poem":1},{"lineBreak":true},{"text":"her kohanim sigh,","poem":1},{"lineBreak":true},{"text":"her betulot (virgins) are afflicted,","poem":1},{"lineBreak":true},{"text":"and she is in bitterness.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Her adversaries are now the rosh (supreme, master);","poem":1},{"lineBreak":true},{"text":"her enemies prosper;","poem":1},{"lineBreak":true},{"text":"for Hashem hath afflicted her","poem":1},{"lineBreak":true},{"text":"because of the multitude of her peysha'im (transgressions);","poem":1},{"lineBreak":true},{"text":"her olalim (little children) are gone","poem":1},{"lineBreak":true},{"text":"into captivity before the enemy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"And from Bat Tziyon","poem":1},{"lineBreak":true},{"text":"all her beauty has departed;","poem":1},{"lineBreak":true},{"text":"her sarim (princes) are become like deer","poem":1},{"lineBreak":true},{"text":"that find no pasture,","poem":1},{"lineBreak":true},{"text":"and they are gone without strength","poem":1},{"lineBreak":true},{"text":"before the rodef (persecutor, pursuer).","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"In the yamim (days) of her affliction","poem":1},{"lineBreak":true},{"text":"and of her persecutions,","poem":1},{"lineBreak":true},{"text":"Yerushalayim remembers all her pleasant things","poem":1},{"lineBreak":true},{"text":"that she had miymei kedem (in the days of old).","poem":1},{"lineBreak":true},{"text":"When her people fell into the hand of the enemy,","poem":1},{"lineBreak":true},{"text":"and there was no ozer (helper) for her,","poem":1},{"lineBreak":true},{"text":"the adversaries saw her,","poem":1},{"lineBreak":true},{"text":"and did mock at her downfall.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerushalayim hath grievously sinned;","poem":1},{"lineBreak":true},{"text":"therefore she is niddah","poem":1},{"noteId":0},{"text":"(unclean, Jewish womanʼs untouchability during menstruation);","poem":1},{"lineBreak":true},{"text":"all that honored her despise her,","poem":1},{"lineBreak":true},{"text":"because they have seen her erom (nakedness);","poem":1},{"lineBreak":true},{"text":"yea, she sigheth, and turneth away for shame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Her filthiness is in her skirts;","poem":1},{"lineBreak":true},{"text":"she remembereth not her latter end;","poem":1},{"lineBreak":true},{"text":"therefore she sank appallingly;","poem":1},{"lineBreak":true},{"text":"she had no Menachem (comforter).","poem":1},{"lineBreak":true},{"text":"O Hashem, behold my affliction;","poem":1},{"lineBreak":true},{"text":"for the enemy hath triumphed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The adversary hath spread out his hand","poem":1},{"lineBreak":true},{"text":"upon all her precious things;","poem":1},{"lineBreak":true},{"text":"for she hath seen how the Goyim","poem":1},{"lineBreak":true},{"text":"entered into her [Beis] Hamikdash,","poem":1},{"lineBreak":true},{"text":"whom Thou didst command that","poem":1},{"lineBreak":true},{"text":"they should not enter into Thy Kahal (congregation, community).","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"All her people sigh, they seek lechem;","poem":1},{"lineBreak":true},{"text":"they have given their precious things","poem":1},{"lineBreak":true},{"text":"for bread to revive the nefesh;","poem":1},{"lineBreak":true},{"text":"see, O Hashem, and consider","poem":1},{"lineBreak":true},{"text":"that I am become despised.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Is it nothing to you, all ye that pass by?","poem":1},{"lineBreak":true},{"text":"Consider, and see","poem":1},{"lineBreak":true},{"text":"if there be any sorrow like my sorrow,","poem":1},{"lineBreak":true},{"text":"which is done unto me,","poem":1},{"lineBreak":true},{"text":"wherewith Hashem hath afflicted me","poem":1},{"lineBreak":true},{"text":"in the Yom Charon Af (day of His fierce anger).","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"From above hath He sent eish","poem":1},{"lineBreak":true},{"text":"into my atzamot (bones), and it prevaileth against them;","poem":1},{"lineBreak":true},{"text":"He hath spread a net for my feet,","poem":1},{"lineBreak":true},{"text":"He hath turned me back;","poem":1},{"lineBreak":true},{"text":"He hath made me desolate and kol hayom (ever) languishing.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"The yoke of my peysha'im hath been fastened by His hand;","poem":1},{"lineBreak":true},{"text":"they","poem":1},{"noteId":1},{"text":"intertwine themselves and set upon my tzavar (neck);","poem":1},{"lineBreak":true},{"text":"He hath made my strength to fall;","poem":1},{"lineBreak":true},{"text":"Adonoi hath delivered me into their hands,","poem":1},{"lineBreak":true},{"text":"from whom I am not able to rise up.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Adonoi hath taken away","poem":1},{"lineBreak":true},{"text":"all my strong ones in my midst;","poem":1},{"lineBreak":true},{"text":"He hath proclaimed a mo'ed (set time) against me","poem":1},{"lineBreak":true},{"text":"to crush my young men;","poem":1},{"lineBreak":true},{"text":"Adonoi hath trodden the winepress","poem":1},{"lineBreak":true},{"text":"for the Betulat Bat Yehudah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"For these things I weep;","poem":1},{"lineBreak":true},{"text":"mine eye, mine eye runneth down with mayim,","poem":1},{"lineBreak":true},{"text":"because the Menachem (comforter)","poem":1},{"lineBreak":true},{"text":"that should refresh my nefesh is far from me;","poem":1},{"lineBreak":true},{"text":"my children are desolate,","poem":1},{"lineBreak":true},{"text":"because the enemy hath prevailed.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tziyon stretcheth forth her hands,","poem":1},{"lineBreak":true},{"text":"yet there is no Menachem (comforter) for her;","poem":1},{"lineBreak":true},{"text":"Hashem hath commanded concerning Ya'akov,","poem":1},{"lineBreak":true},{"text":"that his adversaries should be round about him;","poem":1},{"lineBreak":true},{"text":"Yerushalayim is as a niddah (menstruous woman) among them.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tzaddik is Hashem;","poem":1},{"lineBreak":true},{"text":"for I have rebelled against His mouth;","poem":1},{"lineBreak":true},{"text":"hear, I pray you, kol amim (all people),","poem":1},{"lineBreak":true},{"text":"and behold my sorrow;","poem":1},{"lineBreak":true},{"text":"my betulot and my bochurim","poem":1},{"lineBreak":true},{"text":"are gone into captivity.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"I called for my lovers,","poem":1},{"lineBreak":true},{"text":"but they have deceived me;","poem":1},{"lineBreak":true},{"text":"my kohanim and my zekenim","poem":1},{"lineBreak":true},{"text":"gave up the ghost","poem":1},{"noteId":2},{"text":"in HaIr (the City),","poem":1},{"lineBreak":true},{"text":"while they sought okhel (food)","poem":1},{"lineBreak":true},{"text":"to revive their nefashot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Consider, O Hashem how I am in distress;","poem":1},{"lineBreak":true},{"text":"my bowels are troubled;","poem":1},{"lineBreak":true},{"text":"mine lev is turned within me;","poem":1},{"lineBreak":true},{"text":"for I have grievously rebelled;","poem":1},{"lineBreak":true},{"text":"without,","poem":1},{"noteId":3},{"text":"the cherev (sword) bereaveth,","poem":1},{"lineBreak":true},{"text":"within","poem":1},{"noteId":4},{"text":"it is like mavet (death).","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"They have heard that I sigh;","poem":1},{"lineBreak":true},{"text":"there is no Menachem (comforter);","poem":1},{"lineBreak":true},{"text":"all mine enemies have heard of my trouble;","poem":1},{"lineBreak":true},{"text":"they are glad that Thou hast done it;","poem":1},{"lineBreak":true},{"text":"Thou bringest the Yom Karata (the day that Thou has proclaimed),","poem":1},{"lineBreak":true},{"text":"that they","poem":1},{"noteId":5},{"text":"[all the peoples] may be like me.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Let all their wickedness come before Thee;","poem":1},{"lineBreak":true},{"text":"and do unto them,","poem":1},{"lineBreak":true},{"text":"as Thou hast done unto me for all my peysha'im;","poem":1},{"lineBreak":true},{"text":"for my sighs are many,","poem":1},{"lineBreak":true},{"text":"and my lev is faint.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Lv 15:19","reference":{"chapter":1,"verse":8}},{"noteId":1,"caller":"+","text":"i.e., my sins","reference":{"chapter":1,"verse":14}},{"noteId":2,"caller":"+","text":"i.e., expired","reference":{"chapter":1,"verse":19}},{"noteId":3,"caller":"+","text":"i.e., outside","reference":{"chapter":1,"verse":20}},{"noteId":4,"caller":"+","text":"i.e., babayit, at home","reference":{"chapter":1,"verse":20}},{"noteId":5,"caller":"+","text":"see 1:18","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/eng_ojb/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}