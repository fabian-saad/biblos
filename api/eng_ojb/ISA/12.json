{"translation":{"id":"eng_ojb","name":"The Orthodox Jewish Bible","website":"https://ebible.org/Scriptures/details.php?id=engojb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engojb","licenseNotes":null,"shortName":"TOJB","englishName":"The Orthodox Jewish Bible -  Tanakh and Orthodox Jewish Brit Chadasha - The Holy Bible","language":"eng","textDirection":"ltr","sha256":"7e228ecf8c559f9f6801ea3f4530a5f1dfff15815fb205571fc757a4b2962497","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ojb/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31165,"languageName":"English","languageEnglishName":"English"},"book":{"id":"ISA","translationId":"eng_ojb","name":"YESHAYAH","commonName":"Isaiah","title":"Yeshayah","order":23,"numberOfChapters":66,"sha256":"76b6e6e53b2fbe1801dffefcd8b8fe86e7641716b0b6d9863a5823d374d6ccc6","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ojb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/eng_ojb/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"And in Yom Hahu thou shalt say,","poem":1},{"lineBreak":true},{"text":"Hashem, I will praise Thee;","poem":1},{"lineBreak":true},{"text":"though Thou wast angry with me,","poem":1},{"lineBreak":true},{"text":"Thine anger is turned away,","poem":1},{"lineBreak":true},{"text":"and Thou comfortedst me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hinei, El is my Yeshu'ah (Salvation);","poem":1},{"lineBreak":true},{"text":"I will trust, and not be afraid;","poem":1},{"lineBreak":true},{"text":"for Hashem G-d is my strength and my zemirah;","poem":1},{"lineBreak":true},{"text":"He also has become my Yeshu'ah (Salvation).","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Therefore with sasson shall ye draw mayim out of the wells of Yeshu'ah (Salvation)."]},{"type":"verse","number":4,"content":["And in Yom Hahu shall ye say:",{"lineBreak":true},{"text":"Hodu LaHashem, call upon Shmo,","poem":1},{"lineBreak":true},{"text":"declare His deeds among the peoples,","poem":1},{"lineBreak":true},{"text":"proclaim that Shmo is exalted.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sing unto Hashem; for He hath done glorious things;","poem":1},{"lineBreak":true},{"text":"let this be known b'chol ha'aretz.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cry out and shout for joy, thou inhabitant of Tziyon;","poem":1},{"lineBreak":true},{"text":"for gadol is Kadosh Yisroel in the midst of thee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ojb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ojb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ojb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}