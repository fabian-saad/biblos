{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger, mit Saitenspiel. Ein Maskil",{"noteId":375},"von David,"]},{"type":"verse","number":2,"content":["als die Siphiter kamen und zu Saul sprachen: Hält David sich nicht bei uns verborgen?)"]},{"type":"verse","number":3,"content":["Gott, durch deinen Namen rette mich, und schaffe mir Recht durch deine Macht!"]},{"type":"verse","number":4,"content":["Gott, höre mein Gebet, nimm zu Ohren die Reden meines Mundes!"]},{"type":"verse","number":5,"content":["Denn Fremde sind gegen mich aufgestanden, und Gewalttätige trachten nach meinem Leben; sie haben Gott nicht vor sich gestellt. (Sela.)"]},{"type":"verse","number":6,"content":["Siehe, Gott ist mein Helfer; der Herr ist unter denen",{"noteId":376},", die meine Seele stützen."]},{"type":"verse","number":7,"content":["Er wird das Böse zurückerstatten meinen Feinden",{"noteId":377},"; nach deiner Wahrheit vertilge sie!"]},{"type":"verse","number":8,"content":["Opfern will ich dir mit Freiwilligkeit; deinen Namen will ich preisen, HERR, denn er ist gut."]},{"type":"verse","number":9,"content":["Denn aus aller Bedrängnis hat er mich errettet; und mein Auge hat seine Lust gesehen an meinen Feinden."]}],"footnotes":[{"noteId":375,"caller":"-","text":"54,1 S. die Anm. zu Ps. 32, Überschrift","reference":{"chapter":54,"verse":1}},{"noteId":376,"caller":"-","text":"54,6 d.h. ist der Inbegriff aller derer usw.; eine hebräische Ausdrucksweise","reference":{"chapter":54,"verse":6}},{"noteId":377,"caller":"-","text":"54,7 Eig. Nachstellern; so auch Ps. 56,2; 59,10","reference":{"chapter":54,"verse":7}}]},"thisChapterLink":"/api/deu_elbbk/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}