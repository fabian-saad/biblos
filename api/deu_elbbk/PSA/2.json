{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Warum toben die Nationen und sinnen Eitles die Völkerschaften?"]},{"type":"verse","number":2,"content":["Es treten auf",{"noteId":4},"die Könige der Erde, und die Fürsten ratschlagen miteinander gegen den HERRN und gegen seinen Gesalbten:"]},{"type":"verse","number":3,"content":["„Lasst uns zerreißen ihre Fesseln und von uns werfen ihre Seile!“"]},{"type":"verse","number":4,"content":["Der im Himmel thront",{"noteId":5},", lacht, der Herr spottet",{"noteId":6},"ihrer."]},{"type":"verse","number":5,"content":["Dann wird er zu ihnen reden in seinem Zorn, und in seiner Zornglut wird er sie schrecken."]},{"type":"verse","number":6,"content":["„Habe ich doch meinen König gesalbt",{"noteId":7},"auf Zion, meinem heiligen Berg!“"]},{"type":"verse","number":7,"content":["Vom Beschluss will ich erzählen: Der HERR hat zu mir gesprochen: Du bist mein Sohn, heute habe ich dich gezeugt."]},{"type":"verse","number":8,"content":["Fordere von mir, und ich will dir zum Erbteil geben die Nationen und zum Besitztum die Enden der Erde."]},{"type":"verse","number":9,"content":["Mit eisernem Zepter",{"noteId":8},"wirst du sie zerschmettern, wie ein Töpfergefäß sie zerschmeißen."]},{"type":"verse","number":10,"content":["Und nun, ihr Könige, seid verständig, lasst euch zurechtweisen, ihr Richter der Erde!"]},{"type":"verse","number":11,"content":["Dient dem HERRN mit Furcht, und freut euch",{"noteId":9},"mit Zittern!"]},{"type":"verse","number":12,"content":["Küsst den Sohn, dass er nicht zürne und ihr umkommt auf dem Weg, wenn nur ein wenig entbrennt",{"noteId":10},"sein Zorn. Glückselig alle, die Zuflucht zu ihm nehmen!"]}],"footnotes":[{"noteId":4,"caller":"-","text":"2,2 O. Warum treten auf usw.","reference":{"chapter":2,"verse":2}},{"noteId":5,"caller":"-","text":"2,4 O. wohnt","reference":{"chapter":2,"verse":4}},{"noteId":6,"caller":"-","text":"2,4 O. wird lachen ... wird spotten","reference":{"chapter":2,"verse":4}},{"noteId":7,"caller":"-","text":"2,6 O. eingesetzt","reference":{"chapter":2,"verse":6}},{"noteId":8,"caller":"-","text":"2,9 O. eiserner Zuchtrute","reference":{"chapter":2,"verse":9}},{"noteId":9,"caller":"-","text":"2,11 Eig. frohlockt","reference":{"chapter":2,"verse":11}},{"noteId":10,"caller":"-","text":"2,12 O. denn gar bald möchte entbrennen","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/deu_elbbk/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}