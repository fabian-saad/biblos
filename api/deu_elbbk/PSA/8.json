{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger, auf der Gittith. Ein Psalm von David.)"]},{"type":"verse","number":2,"content":["HERR, unser Herr, wie herrlich ist dein Name auf der ganzen Erde, der du deine Majestät gestellt hast über die Himmel",{"noteId":48},"!"]},{"type":"verse","number":3,"content":["Aus dem Mund der Kinder und Säuglinge hast du Macht",{"noteId":49},"gegründet um deiner Bedränger willen, um zum Schweigen zu bringen den Feind und den Rachgierigen."]},{"type":"verse","number":4,"content":["Wenn ich anschaue deinen Himmel, deiner Finger Werk, den Mond und die Sterne, die du bereitet hast:"]},{"type":"verse","number":5,"content":["Was ist der Mensch, dass du sein gedenkst, und des Menschen Sohn, dass du auf ihn achthast",{"noteId":50},"?"]},{"type":"verse","number":6,"content":["Denn ein wenig",{"noteId":51},"hast du ihn unter die Engel",{"noteId":52},"erniedrigt",{"noteId":53},"; und mit Herrlichkeit und Pracht hast du ihn gekrönt."]},{"type":"verse","number":7,"content":["Du hast ihn zum Herrscher gemacht über die Werke deiner Hände; alles hast du unter seine Füße gestellt:"]},{"type":"verse","number":8,"content":["Schafe und Rinder allesamt und auch die Tiere des Feldes,"]},{"type":"verse","number":9,"content":["die Vögel des Himmels und die Fische des Meeres, was die Pfade der Meere durchwandert."]},{"type":"verse","number":10,"content":["HERR, unser Herr, wie herrlich ist dein Name auf der ganzen Erde!"]}],"footnotes":[{"noteId":48,"caller":"-","text":"8,2 And. üb.: mit deiner Majestät die Himmel angetan hast","reference":{"chapter":8,"verse":2}},{"noteId":49,"caller":"-","text":"8,3 And.: Lob","reference":{"chapter":8,"verse":3}},{"noteId":50,"caller":"-","text":"8,5 O. dich fürsorglich seiner annimmst","reference":{"chapter":8,"verse":5}},{"noteId":51,"caller":"-","text":"8,6 O. eine kleine Zeit","reference":{"chapter":8,"verse":6}},{"noteId":52,"caller":"-","text":"8,6 Hebr. Elohim","reference":{"chapter":8,"verse":6}},{"noteId":53,"caller":"-","text":"8,6 Eig. geringer gemacht als","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/deu_elbbk/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}