{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":["An den Flüssen Babels, da saßen wir und weinten, indem wir Zions gedachten."]},{"type":"verse","number":2,"content":["An die Weiden in ihr hängten wir unsere Lauten."]},{"type":"verse","number":3,"content":["Denn die uns gefangen weggeführt hatten, forderten dort von uns die Worte eines Liedes, und die uns wehklagen machten",{"noteId":920},", Freude: „Singt uns eines von Zions Liedern!“"]},{"type":"verse","number":4,"content":["Wie sollten wir ein Lied des HERRN singen auf fremder Erde?"]},{"type":"verse","number":5,"content":["Wenn ich dein vergesse, Jerusalem, so vergesse meine Rechte",{"noteId":921},"!"]},{"type":"verse","number":6,"content":["Es klebe meine Zunge an meinem Gaumen, wenn ich deiner nicht gedenke, wenn ich Jerusalem nicht erhebe über die höchste meiner Freuden",{"noteId":922},"!"]},{"type":"verse","number":7,"content":["Gedenke, HERR, den Kindern Edom den Tag Jerusalems, die sprachen: Entblößt, entblößt sie bis auf ihre Grundfeste!",{"noteId":923}]},{"type":"verse","number":8,"content":["Tochter Babel, du Verwüstete",{"noteId":924},"! Glückselig der dir dasselbe vergilt, was du uns getan hast!"]},{"type":"verse","number":9,"content":["Glückselig, der deine kleinen Kinder ergreift und sie hinschmettert an den Felsen!"]}],"footnotes":[{"noteId":920,"caller":"-","text":"137,3 O. uns peinigten","reference":{"chapter":137,"verse":3}},{"noteId":921,"caller":"-","text":"137,5 d.h. sie versage ihren Dienst","reference":{"chapter":137,"verse":5}},{"noteId":922,"caller":"-","text":"137,6 O. zu meiner höchsten Freude","reference":{"chapter":137,"verse":6}},{"noteId":923,"caller":"-","text":"137,7 Vergl. Obadja 1,11 usw.","reference":{"chapter":137,"verse":7}},{"noteId":924,"caller":"-","text":"137,8 Viell.: zu verwüstende","reference":{"chapter":137,"verse":8}}]},"thisChapterLink":"/api/deu_elbbk/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}