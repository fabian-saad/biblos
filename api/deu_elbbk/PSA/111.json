{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"noteId":798},"(Lobt den HERRN!",{"noteId":799},") Preisen will ich den HERRN von ganzem Herzen im Kreis",{"noteId":800},"der Aufrichtigen",{"noteId":801},"und in der Gemeinde."]},{"type":"verse","number":2,"content":["Groß sind die Taten des HERRN, sie werden erforscht von allen, die Lust an ihnen haben."]},{"type":"verse","number":3,"content":["Majestät und Pracht ist sein Tun; und seine Gerechtigkeit besteht ewiglich."]},{"type":"verse","number":4,"content":["Er hat ein Gedächtnis gestiftet seinen Wundertaten; gnädig und barmherzig ist der HERR."]},{"type":"verse","number":5,"content":["Er hat Speise gegeben denen, die ihn fürchten; er gedenkt in Ewigkeit seines Bundes."]},{"type":"verse","number":6,"content":["Er hat seinem Volk kundgemacht die Kraft seiner Taten, um ihnen zu geben",{"noteId":802},"das Erbteil der Nationen."]},{"type":"verse","number":7,"content":["Die Taten seiner Hände sind Wahrheit und Recht; zuverlässig sind alle seine Vorschriften,"]},{"type":"verse","number":8,"content":["festgestellt auf immer, auf ewig, ausgeführt in Wahrheit und Geradheit."]},{"type":"verse","number":9,"content":["Er hat Erlösung gesandt seinem Volk, seinen Bund verordnet auf ewig; heilig und furchtbar ist sein Name."]},{"type":"verse","number":10,"content":["Die Furcht des HERRN ist der Weisheit Anfang; gute Einsicht haben alle, die sie",{"noteId":803},"ausüben. Sein Lob",{"noteId":804},"besteht ewiglich."]}],"footnotes":[{"noteId":798,"caller":"-","text":"111,1 Die Anfangsbuchstaben einer jeden Vershälfte dieses Psalmes folgen im Hebr. der alphabetischen Ordnung.","reference":{"chapter":111,"verse":1}},{"noteId":799,"caller":"-","text":"111,1 Hallelujah!","reference":{"chapter":111,"verse":1}},{"noteId":800,"caller":"-","text":"111,1 Dasselbe Wort wie Ps. 89,7","reference":{"chapter":111,"verse":1}},{"noteId":801,"caller":"-","text":"111,1 O. Rechtschaffenen; so auch Ps. 112,2.4","reference":{"chapter":111,"verse":1}},{"noteId":802,"caller":"-","text":"111,6 O. indem er ihnen gab","reference":{"chapter":111,"verse":6}},{"noteId":803,"caller":"-","text":"111,10 d.h. die Vorschriften (V.7)","reference":{"chapter":111,"verse":10}},{"noteId":804,"caller":"-","text":"111,10 O. Ruhm","reference":{"chapter":111,"verse":10}}]},"thisChapterLink":"/api/deu_elbbk/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}