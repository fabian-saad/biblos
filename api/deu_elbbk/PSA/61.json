{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger, mit Saitenspiel. Von David.)"]},{"type":"verse","number":2,"content":["Höre, Gott, mein Schreien, horche auf mein Gebet!"]},{"type":"verse","number":3,"content":["Vom Ende der Erde werde ich zu dir rufen, wenn mein Herz verschmachtet; du wirst mich auf einen Felsen leiten, der mir zu hoch ist."]},{"type":"verse","number":4,"content":["Denn du bist mir eine Zuflucht gewesen, ein starker Turm, vor dem Feind."]},{"type":"verse","number":5,"content":["Ich werde",{"noteId":425},"mich in deinem Zelt aufhalten in Ewigkeit, werde",{"noteId":426},"Zuflucht nehmen zu dem Schutz deiner Flügel. (Sela.)"]},{"type":"verse","number":6,"content":["Denn du, Gott, hast auf meine Gelübde gehört, hast mir gegeben das Erbteil derer, die deinen Namen fürchten."]},{"type":"verse","number":7,"content":["Du wirst Tage hinzufügen zu den Tagen des Königs; seine Jahre werden sein wie Geschlechter und Geschlechter."]},{"type":"verse","number":8,"content":["Er wird ewiglich bleiben",{"noteId":427},"vor dem Angesicht Gottes. Bestelle Güte und Wahrheit, dass sie ihn behüten!"]},{"type":"verse","number":9,"content":["So werde ich deinen Namen besingen auf ewig, indem ich meine Gelübde bezahle Tag für Tag."]}],"footnotes":[{"noteId":425,"caller":"-","text":"61,5 O. will","reference":{"chapter":61,"verse":5}},{"noteId":426,"caller":"-","text":"61,5 O. will","reference":{"chapter":61,"verse":5}},{"noteId":427,"caller":"-","text":"61,8 O. thronen","reference":{"chapter":61,"verse":8}}]},"thisChapterLink":"/api/deu_elbbk/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}