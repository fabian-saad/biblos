,{"noteId":76},"."]},{"type":"verse","number":7,"content":["Die Worte des HERRN sind reine Worte – Silber, das geläutert in dem Schmelztiegel zur Erde fließt, siebenmal gereinigt."]},{"type":"verse","number":8,"content":["Du, HERR, wirst sie bewahren, wirst sie",{"noteId":77},"behüten vor diesem Geschlecht ewiglich."]},{"type":"verse","number":9,"content":["Die Gottlosen wandeln ringsumher, wenn die Gemeinheit erhöht ist bei den Menschenkindern."]}],"footnotes":[{"noteId":72,"caller":"-","text":"12,3 O. Eitles","reference":{"chapter":12,"verse":3}},{"noteId":73,"caller":"-","text":"12,3 W. schmeichelnde Lippe","reference":{"chapter":12,"verse":3}},{"noteId":74,"caller":"-","text":"12,4 O. rotte aus","reference":{"chapter":12,"verse":4}},{"noteId":75,"caller":"-","text":"12,6 Eig. Rettung, Heil","reference":{"chapter":12,"verse":6}},{"noteId":76,"caller":"-","text":"12,6 And. üb.: den man anschnaubt","reference":{"chapter":12,"verse":6}},{"noteId":77,"caller":"-","text":"12,8 W. ihn; s. V. 5","reference":{"chapter":12,"verse":8}}]},"thisChapterLink":"/api/deu_elbbk/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}