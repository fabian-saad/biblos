{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger. Ein Maskil",{"noteId":364},"von David,"]},{"type":"verse","number":2,"content":["als Doeg, der Edomiter, kam und Saul berichtete und ihm sagte: David ist in das Haus Ahimelechs gekommen.)"]},{"type":"verse","number":3,"content":["Was rühmst du dich des Bösen",{"noteId":365},", du Gewaltiger? Die Güte Gottes",{"noteId":366},"währt den ganzen Tag."]},{"type":"verse","number":4,"content":["Verderben sinnt deine Zunge, wie ein geschliffenes Schermesser Trug übend",{"noteId":367},"."]},{"type":"verse","number":5,"content":["Du hast das Böse mehr geliebt als das Gute, die Lüge mehr, als Gerechtigkeit zu reden. (Sela.)"]},{"type":"verse","number":6,"content":["Du hast alle Vertilgungsworte geliebt, du Zunge des Trugs!"]},{"type":"verse","number":7,"content":["Gott",{"noteId":368},"wird dich auch für immer zerstören; er wird dich fassen und herausreißen aus dem Zelt und auswurzeln aus dem Land der Lebendigen. (Sela.)"]},{"type":"verse","number":8,"content":["Und sehen werden es die Gerechten und sich fürchten, und sie werden über ihn lachen:"]},{"type":"verse","number":9,"content":["„Sieh den Mann, der Gott nicht zu seiner Stärke",{"noteId":369},"machte, sondern auf die Größe seines Reichtums vertraute, durch sein Schadentun stark war!“"]},{"type":"verse","number":10,"content":["Ich aber bin wie ein grüner Olivenbaum im Haus Gottes; ich vertraue auf die Güte Gottes immer und ewiglich."]},{"type":"verse","number":11,"content":["Ich werde dich preisen ewiglich, weil",{"noteId":370},"du es getan hast; und auf deinen Namen werde ich harren, denn er ist gut, vor deinen Frommen."]}],"footnotes":[{"noteId":364,"caller":"-","text":"52,1 S. die Anm. zu Ps. 32, Überschrift","reference":{"chapter":52,"verse":1}},{"noteId":365,"caller":"-","text":"52,3 O. der Bosheit","reference":{"chapter":52,"verse":3}},{"noteId":366,"caller":"-","text":"52,3 El","reference":{"chapter":52,"verse":3}},{"noteId":367,"caller":"-","text":"52,4 O. du Trug Übender","reference":{"chapter":52,"verse":4}},{"noteId":368,"caller":"-","text":"52,7 El","reference":{"chapter":52,"verse":7}},{"noteId":369,"caller":"-","text":"52,9 Eig. Festung, Schutzwehr","reference":{"chapter":52,"verse":9}},{"noteId":370,"caller":"-","text":"52,11 O. dir danken, dass","reference":{"chapter":52,"verse":11}}]},"thisChapterLink":"/api/deu_elbbk/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}