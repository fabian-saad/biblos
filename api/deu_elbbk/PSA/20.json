{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger. Ein Psalm von David.)"]},{"type":"verse","number":2,"content":["Der HERR erhöre dich am Tag der Drangsal, der Name des Gottes Jakobs setze dich in Sicherheit;"]},{"type":"verse","number":3,"content":["er sende deine Hilfe aus dem Heiligtum, und von Zion aus unterstütze er dich;"]},{"type":"verse","number":4,"content":["er gedenke aller deiner Speisopfer, und dein Brandopfer wolle er annehmen! (Sela.)"]},{"type":"verse","number":5,"content":["Er gebe dir nach deinem Herzen, und alle deine Ratschläge erfülle er!"]},{"type":"verse","number":6,"content":["Jubeln wollen wir über deine Rettung, und im Namen unseres Gottes das Panier erheben",{"noteId":131},". Der HERR erfülle alle deine Bitten!"]},{"type":"verse","number":7,"content":["Jetzt weiß ich, dass der HERR seinen Gesalbten rettet; aus seinen heiligen Himmeln wird er ihn erhören durch die Machttaten des Heils seiner Rechten."]},{"type":"verse","number":8,"content":["Diese gedenken der Wagen und jene der Pferde, wir aber gedenken",{"noteId":132},"des Namens des HERRN, unseres Gottes."]},{"type":"verse","number":9,"content":["Jene krümmen sich und fallen, wir aber stehen und halten uns aufrecht."]},{"type":"verse","number":10,"content":["HERR, rette! Der König erhöre uns am Tag unseres Rufens!"]}],"footnotes":[{"noteId":131,"caller":"-","text":"20,6 O. schwingen","reference":{"chapter":20,"verse":6}},{"noteId":132,"caller":"-","text":"20,8 d.h. rühmend","reference":{"chapter":20,"verse":8}}]},"thisChapterLink":"/api/deu_elbbk/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}