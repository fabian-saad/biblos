{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["(Ein Psalm von David, als er vor seinem Sohn Absalom floh.)"]},{"type":"verse","number":2,"content":["HERR! Wie viele sind meiner Bedränger! Viele erheben sich gegen mich."]},{"type":"verse","number":3,"content":["Viele sagen von meiner Seele: Es ist keine Rettung für ihn bei",{"noteId":11},"Gott! (Sela.)",{"noteId":12}]},{"type":"verse","number":4,"content":["Du aber, HERR, bist ein Schild um mich her, meine Herrlichkeit",{"noteId":13},"und der, der mein Haupt emporhebt."]},{"type":"verse","number":5,"content":["Mit meiner Stimme rufe ich zu dem HERRN, und er antwortet mir von seinem heiligen Berg. (Sela.)"]},{"type":"verse","number":6,"content":["Ich legte mich nieder und schlief. Ich erwachte, denn der HERR stützt mich."]},{"type":"verse","number":7,"content":["Nicht fürchte ich mich vor Zehntausenden des Volkes, die sich ringsum gegen mich gesetzt haben."]},{"type":"verse","number":8,"content":["Steh auf, HERR! Rette mich, mein Gott! Denn du hast alle meine Feinde auf den Backen geschlagen; die Zähne der Gottlosen hast du zerschmettert."]},{"type":"verse","number":9,"content":["Von dem HERRN ist die Rettung; dein Segen ist auf deinem Volk",{"noteId":14},". (Sela.)"]}],"footnotes":[{"noteId":11,"caller":"-","text":"3,3 W. in","reference":{"chapter":3,"verse":3}},{"noteId":12,"caller":"-","text":"3,3 Bedeutet wahrsch.: Zwischenspiel, od. Verstärkung der begleitenden Musik","reference":{"chapter":3,"verse":3}},{"noteId":13,"caller":"-","text":"3,4 O. Ehre","reference":{"chapter":3,"verse":4}},{"noteId":14,"caller":"-","text":"3,9 O. komme auf dein Volk","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/deu_elbbk/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}