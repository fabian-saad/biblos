{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger. Von dem Knecht des HERRN, von David.)"]},{"type":"verse","number":2,"content":["Die Übertretung des Gottlosen spricht",{"noteId":244},"im Innern meines Herzens: Es ist keine Furcht Gottes vor seinen Augen."]},{"type":"verse","number":3,"content":["Denn es",{"noteId":245},"schmeichelt ihm in seinen eigenen Augen, seine Ungerechtigkeit zu erreichen, Hass auszuüben."]},{"type":"verse","number":4,"content":["Frevel",{"noteId":246},"und Trug sind die Worte seines Mundes; er hat es aufgegeben, verständig zu sein, Gutes zu tun."]},{"type":"verse","number":5,"content":["Frevel",{"noteId":247},"ersinnt er auf seinem Lager; er stellt sich auf einen",{"noteId":248},"Weg, der nicht gut ist; das Böse verabscheut er nicht."]},{"type":"verse","number":6,"content":["HERR! An die Himmel reicht deine Güte, bis zu den Wolken deine Treue."]},{"type":"verse","number":7,"content":["Deine Gerechtigkeit ist gleich Bergen Gottes",{"noteId":249},", deine Gerichte",{"noteId":250},"sind eine große Tiefe",{"noteId":251},"; Menschen und Vieh rettest du, HERR."]},{"type":"verse","number":8,"content":["Wie köstlich ist deine Güte, o Gott! Und Menschenkinder nehmen Zuflucht zu deiner Flügel Schatten;"]},{"type":"verse","number":9,"content":["Sie werden reichlich trinken von der Fettigkeit deines Hauses, und mit dem Strom deiner Wonnen wirst du sie tränken."]},{"type":"verse","number":10,"content":["Denn bei dir ist die Quelle des Lebens, in deinem Licht werden wir das Licht sehen."]},{"type":"verse","number":11,"content":["Lass deine Güte fortdauern denen, die dich kennen, und deine Gerechtigkeit den von Herzen Aufrichtigen!"]},{"type":"verse","number":12,"content":["Nicht erreiche mich der Fuß der Hochmütigen",{"noteId":252},", und die Hand der Gottlosen vertreibe mich nicht!"]},{"type":"verse","number":13,"content":["Da",{"noteId":253},"sind gefallen, die Frevel tun; sie wurden niedergestoßen und vermochten nicht aufzustehen."]}],"footnotes":[{"noteId":244,"caller":"-","text":"36,2 Eig. Spruch der Übertretung","reference":{"chapter":36,"verse":2}},{"noteId":245,"caller":"-","text":"36,3 O. sie","reference":{"chapter":36,"verse":3}},{"noteId":246,"caller":"-","text":"36,4 O. Unheil","reference":{"chapter":36,"verse":4}},{"noteId":247,"caller":"-","text":"36,5 O. Unheil","reference":{"chapter":36,"verse":5}},{"noteId":248,"caller":"-","text":"36,5 O. er steht auf einem","reference":{"chapter":36,"verse":5}},{"noteId":249,"caller":"-","text":"36,7 El; d.h. gleich hohen Bergen","reference":{"chapter":36,"verse":7}},{"noteId":250,"caller":"-","text":"36,7 O. Urteile, Rechte","reference":{"chapter":36,"verse":7}},{"noteId":251,"caller":"-","text":"36,7 S. die Anm. zu Ps. 33,7","reference":{"chapter":36,"verse":7}},{"noteId":252,"caller":"-","text":"36,12 W. des Hochmuts","reference":{"chapter":36,"verse":12}},{"noteId":253,"caller":"-","text":"36,13 O. Dort, dann","reference":