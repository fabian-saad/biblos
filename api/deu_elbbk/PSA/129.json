en über euch! – Wir segnen euch im Namen des HERRN."]}],"footnotes":[{"noteId":891,"caller":"-","text":"129,6 O. ehe es aufgeschossen ist","reference":{"chapter":129,"verse":6}}]},"thisChapterLink":"/api/deu_elbbk/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}