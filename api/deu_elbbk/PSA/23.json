. an","reference":{"chapter":23,"verse":2}},{"noteId":159,"caller":"-","text":"23,6 W. auf Länge der Tage","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/deu_elbbk/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}