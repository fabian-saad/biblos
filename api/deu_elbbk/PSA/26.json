{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["(Von David.) Richte mich",{"noteId":168},", HERR! Denn in meiner Lauterkeit habe ich gewandelt; und auf den HERRN habe ich vertraut, ich werde nicht wanken."]},{"type":"verse","number":2,"content":["Prüfe mich, HERR, und erprobe mich; läutere meine Nieren und mein Herz!"]},{"type":"verse","number":3,"content":["Denn deine Güte ist vor meinen Augen, und in deiner Wahrheit wandle ich."]},{"type":"verse","number":4,"content":["Nicht habe ich gesessen bei falschen Leuten, und mit Hinterlistigen ging ich nicht um."]},{"type":"verse","number":5,"content":["Ich habe die Versammlung der Übeltäter gehasst, und bei Gottlosen saß ich nicht."]},{"type":"verse","number":6,"content":["Ich wasche in Unschuld meine Hände und umgehe",{"noteId":169},"deinen Altar, HERR,"]},{"type":"verse","number":7,"content":["um hören zu lassen die Stimme des Lobes",{"noteId":170},"und um zu erzählen alle deine Wundertaten."]},{"type":"verse","number":8,"content":["HERR, ich habe geliebt die Wohnung deines Hauses und den Wohnort deiner Herrlichkeit."]},{"type":"verse","number":9,"content":["Raffe meine Seele nicht weg mit",{"noteId":171},"Sündern, noch mein Leben mit Blutmenschen,"]},{"type":"verse","number":10,"content":["in deren Händen böses Vornehmen",{"noteId":172},", und deren Rechte voll Bestechung ist!"]},{"type":"verse","number":11,"content":["Ich aber wandle",{"noteId":173},"in meiner Lauterkeit. Erlöse mich und sei mir gnädig!"]},{"type":"verse","number":12,"content":["Mein Fuß steht auf ebenem Boden: Den HERRN werde ich preisen in den Versammlungen."]}],"footnotes":[{"noteId":168,"caller":"-","text":"26,1 d.h. Urteile über mich","reference":{"chapter":26,"verse":1}},{"noteId":169,"caller":"-","text":"26,6 O. will (möchte) umgehen","reference":{"chapter":26,"verse":6}},{"noteId":170,"caller":"-","text":"26,7 O. Dankes","reference":{"chapter":26,"verse":7}},{"noteId":171,"caller":"-","text":"26,9 O. Sammle ... nicht zu","reference":{"chapter":26,"verse":9}},{"noteId":172,"caller":"-","text":"26,10 O. Schandtat","reference":{"chapter":26,"verse":10}},{"noteId":173,"caller":"-","text":"26,11 O. werde wandeln","reference":{"chapter":26,"verse":11}}]},"thisChapterLink":"/api/deu_elbbk/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}