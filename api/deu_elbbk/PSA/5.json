{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger, zu Nechiloth",{"noteId":18},". Ein Psalm von David.)"]},{"type":"verse","number":2,"content":["Nimm zu Ohren, HERR, meine Worte, höre auf mein Nachsinnen",{"noteId":19},"!"]},{"type":"verse","number":3,"content":["Horche auf die Stimme meines Schreiens, mein König und mein Gott! Denn zu dir bete ich."]},{"type":"verse","number":4,"content":["Frühe",{"noteId":20},"wirst du, HERR, meine Stimme hören, frühe",{"noteId":21},"werde ich mein Anliegen dir vorstellen und harren",{"noteId":22},"."]},{"type":"verse","number":5,"content":["Denn nicht ein Gott",{"noteId":23},"bist du, der an Gottlosigkeit Gefallen hat; bei dir wird sich das Böse",{"noteId":24},"nicht aufhalten."]},{"type":"verse","number":6,"content":["Nicht werden die Toren",{"noteId":25},"bestehen vor deinen Augen; du hasst alle, die Frevel tun."]},{"type":"verse","number":7,"content":["Du wirst vertilgen die Lügenredner; den Mann des Blutes und des Truges verabscheut der HERR."]},{"type":"verse","number":8,"content":["Ich aber, ich werde in der",{"noteId":26},"Größe deiner Güte eingehen in dein Haus, ich werde anbeten",{"noteId":27},"in deiner Furcht gegen deinen heiligen Tempel",{"noteId":28},"."]},{"type":"verse","number":9,"content":["Leite mich, HERR, in deiner Gerechtigkeit um meiner Feinde",{"noteId":29},"willen; ebne vor mir deinen Weg."]},{"type":"verse","number":10,"content":["Denn in ihrem Mund ist nichts Zuverlässiges; ihr Inneres ist Verderben, ein offenes Grab ihr Schlund; ihre Zunge glätten sie",{"noteId":30},"."]},{"type":"verse","number":11,"content":["Lass sie büßen, o Gott; mögen sie fallen durch ihre Anschläge! Stoße sie weg wegen der Menge ihrer Übertretungen, denn sie sind widerspenstig gegen dich gewesen."]},{"type":"verse","number":12,"content":["So werden sich freuen alle, die Zuflucht bei dir suchen: Ewig werden sie jubeln, und du wirst sie beschirmen; und in dir werden frohlocken die deinen Namen lieben."]},{"type":"verse","number":13,"content":["Denn du wirst den Gerechten segnen; HERR, mit Gunst wirst du ihn umgeben wie mit einem Schild",{"noteId":31},"."]}],"footnotes":[{"noteId":18,"caller":"-","text":"5,1 d.h. zu Flöten","reference":{"chapter":5,"verse":1}},{"noteId":19,"caller":"-","text":"5,2 O. meine Klage","reference":{"chapter":5,"verse":2}},{"noteId":20,"caller":"-","text":"5,4 W. am Morgen","reference":{"chapter":5,"verse":4}},{"noteId":21,"caller":"-","text":"5,4 W. am Morgen","reference":{"chapter":5,"verse":4}},{"noteId":22,"caller":"-","text":"5,4 Eig. ausschauen","reference":{"chapter":5,"verse":4}},{"noteId":23,"caller":"-","text":"5,5 El","reference":{"chapter":5,"verse":5}},{"noteId":24,"caller":"-","text":"5,5 O. der Böse","reference":{"chapter":5,"verse":5}},{"noteId":25,"caller":"-","text":"5,6 O. die Prahler, die Übermütigen","reference":{"chapter":5,"verse":6}},{"noteId":26,"caller":"-","text":"5,8 O. durch die","reference":{"chapter":5,"verse":8}},{"noteId":27,"caller":"-","text":"5,8 Eig. mich niederwerfen","reference":{"chapter":5,"verse":8}},{"noteId":28,"caller":"-","text":"5,8 S. die Anm. zu 1. Kön. 6,3","reference":{"chapter":5,"verse":8}},{"noteId":29,"caller":"-","text":"5,9 Eig. Nachsteller","reference":{"chapter":5,"verse":9}},{"noteId":30,"caller":"-","text":"5,10 d.h. sie schmeicheln","reference":{"chapter":5,"verse":10}},{"noteId":31,"caller":"-","text":"5,13 Hier der große Schild, der den ganzen Mann deckte","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/deu_elbbk/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}