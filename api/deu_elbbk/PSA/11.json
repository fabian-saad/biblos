{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger. Von David.) Auf den HERRN traue ich; wie sagt ihr zu meiner Seele: Flieht",{"noteId":66},"wie ein Vogel",{"noteId":67},"nach eurem Berg?"]},{"type":"verse","number":2,"content":["Denn siehe, die Gottlosen spannen den Bogen, sie haben ihren Pfeil auf der Sehne gerichtet, um im Finstern zu schießen auf die von Herzen Aufrichtigen."]},{"type":"verse","number":3,"content":["Wenn die Grundpfeiler umgerissen werden, was tut dann der Gerechte?"]},{"type":"verse","number":4,"content":["Der HERR ist in seinem heiligen Palast",{"noteId":68},". Der HERR – in den Himmeln ist sein Thron; seine Augen schauen, seine Augenlider prüfen die Menschenkinder."]},{"type":"verse","number":5,"content":["Der HERR prüft den Gerechten; und den Gottlosen und den, der Gewalttat liebt, hasst seine Seele."]},{"type":"verse","number":6,"content":["Er wird Schlingen",{"noteId":69},"regnen lassen auf die Gottlosen; Feuer und Schwefel und Glutwind wird das Teil ihres Bechers sein."]},{"type":"verse","number":7,"content":["Denn gerecht ist der HERR, Gerechtigkeiten",{"noteId":70},"liebt er. Sein Angesicht schaut den Aufrichtigen an.",{"noteId":71}]}],"footnotes":[{"noteId":66,"caller":"-","text":"11,1 Nach and. Les.: Fliehe","reference":{"chapter":11,"verse":1}},{"noteId":67,"caller":"-","text":"11,1 O. ihr Vögel","reference":{"chapter":11,"verse":1}},{"noteId":68,"caller":"-","text":"11,4 O. Tempel","reference":{"chapter":11,"verse":4}},{"noteId":69,"caller":"-","text":"11,6 d.h. wahrsch. Blitze","reference":{"chapter":11,"verse":6}},{"noteId":70,"caller":"-","text":"11,7 d.h. Betätigungen der Gerechtigkeit","reference":{"chapter":11,"verse":7}},{"noteId":71,"caller":"-","text":"11,7 O. Die Aufrichtigen werden sein Angesicht schauen","reference":{"chapter":11,"verse":7}}]},"thisChapterLink":"/api/deu_elbbk/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}