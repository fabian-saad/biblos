{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":["(Dem Vorsänger. Von den Söhnen Korahs, ein Psalm.)"]},{"type":"verse","number":2,"content":["Ihr Völker alle, klatscht in die Hände! Jauchzt Gott mit Jubelschall!"]},{"type":"verse","number":3,"content":["Denn der HERR, der Höchste, ist furchtbar, ein großer König über die ganze Erde."]},{"type":"verse","number":4,"content":["Er unterwarf uns die Völker, und die Völkerschaften unter unsere Füße."]},{"type":"verse","number":5,"content":["Er erwählte für uns unser Erbteil, den Stolz Jakobs, den er geliebt hat. (Sela.)"]},{"type":"verse","number":6,"content":["Gott ist emporgestiegen unter Jauchzen, der HERR unter Posaunenschall."]},{"type":"verse","number":7,"content":["Singt Gott Psalmen",{"noteId":335},", singt Psalmen; singt Psalmen unserem König, singt Psalmen!"]},{"type":"verse","number":8,"content":["Denn Gott ist König der ganzen Erde; singt Psalmen mit Einsicht",{"noteId":336},"!"]},{"type":"verse","number":9,"content":["Gott regiert über die Nationen; Gott hat sich auf den Thron seiner Heiligkeit gesetzt."]},{"type":"verse","number":10,"content":["Die Edlen der Völker haben sich versammelt und das Volk",{"noteId":337},"des Gottes Abrahams; denn die Schilde",{"noteId":338},"der Erde sind Gottes; er ist sehr erhaben."]}],"footnotes":[{"noteId":335,"caller":"-","text":"47,7 Eig. Singspielt","reference":{"chapter":47,"verse":7}},{"noteId":336,"caller":"-","text":"47,8 Eig. Singt Maskil. S. die Anm. zu Ps. 32, Überschrift","reference":{"chapter":47,"verse":8}},{"noteId":337,"caller":"-","text":"47,10 O. als ein Volk","reference":{"chapter":47,"verse":10}},{"noteId":338,"caller":"-","text":"47,10 d.h. die Fürsten, die Schirmherren","reference":{"chapter":47,"verse":10}}]},"thisChapterLink":"/api/deu_elbbk/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}