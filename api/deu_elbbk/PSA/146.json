{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["(Lobt den HERRN!",{"noteId":974},") Lobe den HERRN, meine Seele!"]},{"type":"verse","number":2,"content":["Loben will ich den HERRN mein Leben lang, will Psalmen singen meinem Gott, solange ich bin."]},{"type":"verse","number":3,"content":["Vertraut nicht auf Fürsten, auf einen Menschensohn, bei dem keine Rettung ist!"]},{"type":"verse","number":4,"content":["Sein Geist geht aus, er kehrt wieder zu seiner Erde: An demselben Tag gehen seine Pläne zugrunde."]},{"type":"verse","number":5,"content":["Glückselig der, dessen Hilfe der Gott",{"noteId":975},"Jakobs, dessen Hoffnung auf den HERRN, seinen Gott, ist!"]},{"type":"verse","number":6,"content":["Der Himmel und Erde gemacht hat, das Meer und alles, was in ihnen ist; der Wahrheit hält auf ewig;"]},{"type":"verse","number":7,"content":["der Recht schafft den Bedrückten, der Brot gibt den Hungrigen. Der HERR löst die Gebundenen."]},{"type":"verse","number":8,"content":["Der HERR öffnet die Augen der Blinden, der HERR richtet auf die Niedergebeugten, der HERR liebt die Gerechten;"]},{"type":"verse","number":9,"content":["der HERR bewahrt die Fremden, die Waise und die Witwe hält er aufrecht; aber er krümmt den Weg der Gottlosen",{"noteId":976},"."]},{"type":"verse","number":10,"content":["Der HERR wird regieren in Ewigkeit, dein Gott, Zion, von Geschlecht zu Geschlecht. Lobt den HERRN!",{"noteId":977}]}],"footnotes":[{"noteId":974,"caller":"-","text":"146,1 Hallelujah!","reference":{"chapter":146,"verse":1}},{"noteId":975,"caller":"-","text":"146,5 El","reference":{"chapter":146,"verse":5}},{"noteId":976,"caller":"-","text":"146,9 d.h. er lässt sie irregehen","reference":{"chapter":146,"verse":9}},{"noteId":977,"caller":"-","text":"146,10 Hallelujah!","reference":{"chapter":146,"verse":10}}]},"thisChapterLink":"/api/deu_elbbk/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}