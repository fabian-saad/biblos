{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elbbk","name":"Psalm","commonName":"Psalm","title":"Psalm","order":19,"numberOfChapters":150,"sha256":"5cee937fbcc8bd6fba4fe35476e59341871be4be052d5ec92cef107c78d9edf7","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elbbk/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["(Ein Psalm; von David.) Gebt dem HERRN, ihr Söhne der Starken, gebt dem HERRN Herrlichkeit und Stärke!"]},{"type":"verse","number":2,"content":["Gebt dem HERRN die Herrlichkeit seines Namens; betet den HERRN an in heiliger Pracht!"]},{"type":"verse","number":3,"content":["Die Stimme des HERRN ist auf",{"noteId":187},"den Wassern; der Gott",{"noteId":188},"der Herrlichkeit donnert, der HERR auf",{"noteId":189},"großen Wassern."]},{"type":"verse","number":4,"content":["Die Stimme des HERRN ist gewaltig, die Stimme des HERRN ist majestätisch."]},{"type":"verse","number":5,"content":["Die Stimme des HERRN zerbricht Zedern, ja, der HERR zerbricht die Zedern des Libanon;"]},{"type":"verse","number":6,"content":["und er macht sie hüpfen wie ein Kalb, den Libanon und Sirjon",{"noteId":190},"wie einen jungen Wildochse."]},{"type":"verse","number":7,"content":["Die Stimme des HERRN sprüht Feuerflammen aus",{"noteId":191},"."]},{"type":"verse","number":8,"content":["Die Stimme des HERRN erschüttert die Wüste, der HERR erschüttert die Wüste Kades."]},{"type":"verse","number":9,"content":["Die Stimme des HERRN macht Hirschkühe kreißen, und entblößt die Wälder; und in seinem Tempel spricht alles",{"noteId":192},": Herrlichkeit!"]},{"type":"verse","number":10,"content":["Der HERR thront auf",{"noteId":193},"der Wasserflut",{"noteId":194},", und der HERR thront als König ewiglich."]},{"type":"verse","number":11,"content":["Der HERR wird Stärke geben seinem Volk, der HERR wird sein Volk segnen mit Frieden."]}],"footnotes":[{"noteId":187,"caller":"-","text":"29,3 O. über","reference":{"chapter":29,"verse":3}},{"noteId":188,"caller":"-","text":"29,3 El","reference":{"chapter":29,"verse":3}},{"noteId":189,"caller":"-","text":"29,3 O. über","reference":{"chapter":29,"verse":3}},{"noteId":190,"caller":"-","text":"29,6 der zidonische Name für den Berg Hermon; vergl. 5. Mose 3,9","reference":{"chapter":29,"verse":6}},{"noteId":191,"caller":"-","text":"29,7 W. spaltet Feuerflammen","reference":{"chapter":29,"verse":7}},{"noteId":192,"caller":"-","text":"29,9 W. sein Alles, d.h. alles, was darin ist","reference":{"chapter":29,"verse":9}},{"noteId":193,"caller":"-","text":"29,10 O. thronte bei","reference":{"chapter":29,"verse":10}},{"noteId":194,"caller":"-","text":"29,10 Dasselbe Wort wie 1. Mose 6,17 usw.","reference":{"chapter":29,"verse":10}}]},"thisChapterLink":"/api/deu_elbbk/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}