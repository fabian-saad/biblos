":6,"content":["Jauchze und juble, Bewohnerin von Zion! Denn groß ist in deiner Mitte der Heilige Israels."]}],"footnotes":[{"noteId":106,"caller":"-","text":"12,1 O. Ich danke dir","reference":{"chapter":12,"verse":1}},{"noteId":107,"caller":"-","text":"12,2 Vergl. 2. Mose 15,2; Ps. 118,14","reference":{"chapter":12,"verse":2}},{"noteId":108,"caller":"-","text":"12,4 O. Dankt","reference":{"chapter":12,"verse":4}},{"noteId":109,"caller":"-","text":"12,4 Eig. erwähnt rühmend","reference":{"chapter":12,"verse":4}},{"noteId":110,"caller":"-","text":"12,5 Eig. Erhabenes","reference":{"chapter":12,"verse":5}}]},"thisChapterLink":"/api/deu_elbbk/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}