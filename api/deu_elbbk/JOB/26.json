{"translation":{"id":"deu_elbbk","name":"Elberfelder Übersetzung (Version von bibelkommentare.de)","website":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelbbk","licenseNotes":null,"shortName":"ELBBK","englishName":"German ELBBK Bible","language":"deu","textDirection":"ltr","sha256":"4d01ad795a0baa75a5f51da443a6118fc6bdea1859aa6a31982a45364e6eb818","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elbbk/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"JOB","translationId":"deu_elbbk","name":"Hiob","commonName":"Hiob","title":"Hiob","order":18,"numberOfChapters":42,"sha256":"304b7bf7687e99a4171698bb36ed0effc45a1c2ba067e76f1f97ca0a1bd6a11f","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elbbk/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/deu_elbbk/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Und Hiob antwortete und sprach:"]},{"type":"verse","number":2,"content":["Wie hast du dem Ohnmächtigen geholfen, den kraftlosen Arm gerettet!"]},{"type":"verse","number":3,"content":["Wie hast du den beraten, der keine Weisheit hat, und gründliches Wissen in Fülle mitgeteilt!"]},{"type":"verse","number":4,"content":["An wen hast du Worte gerichtet",{"noteId":207},", und wessen Odem ist von dir ausgegangen?"]},{"type":"verse","number":5,"content":["Die Schatten",{"noteId":208},"beben unter den Wassern und ihren Bewohnern."]},{"type":"verse","number":6,"content":["Der Scheol ist nackt vor ihm, und keine Hülle hat der Abgrund",{"noteId":209},"."]},{"type":"verse","number":7,"content":["Er spannt den Norden",{"noteId":210},"aus über der Leere, hängt die Erde auf über dem Nichts."]},{"type":"verse","number":8,"content":["Er bindet die Wasser in seine Wolken, und das Gewölk zerreißt nicht unter ihnen."]},{"type":"verse","number":9,"content":["Er verhüllt den Anblick seines Thrones, indem er sein Gewölk darüber ausbreitet."]},{"type":"verse","number":10,"content":["Er rundete eine Schranke ab über der Fläche der Wasser bis zum äußersten Ende, wo Licht und Finsternis zusammentreffen."]},{"type":"verse","number":11,"content":["Die Säulen des Himmels wanken und entsetzen sich vor seinem Schelten."]},{"type":"verse","number":12,"content":["Durch seine Kraft erregt er das Meer, und durch seine Einsicht zerschellt er Rahab",{"noteId":211},"."]},{"type":"verse","number":13,"content":["Durch seinen Hauch wird der Himmel heiter, seine Hand durchbohrt den flüchtigen Drachen",{"noteId":212},"."]},{"type":"verse","number":14,"content":["Siehe, das sind die Säume seiner Wege; und wie wenig",{"noteId":213},"haben wir von ihm gehört! Und den Donner seiner Macht",{"noteId":214},", wer versteht ihn?"]}],"footnotes":[{"noteId":207,"caller":"-","text":"26,4 Eig. Wem ... verkündet","reference":{"chapter":26,"verse":4}},{"noteId":208,"caller":"-","text":"26,5 S. die Anm. zu Ps. 88,10","reference":{"chapter":26,"verse":5}},{"noteId":209,"caller":"-","text":"26,6 S. die Anm. zu Ps. 88,11","reference":{"chapter":26,"verse":6}},{"noteId":210,"caller":"-","text":"26,7 d.h. den nördlichen Himmel","reference":{"chapter":26,"verse":7}},{"noteId":211,"caller":"-","text":"26,12 Wahrsch. ein Seeungeheuer","reference":{"chapter":26,"verse":12}},{"noteId":212,"caller":"-","text":"26,13 S. die Anm. zu Kap. 3,8","reference":{"chapter":26,"verse":13}},{"noteId":213,"caller":"-","text":"26,14 Eig. welch flüsterndes Wort","reference":{"chapter":26,"verse":14}},{"noteId":214,"caller":"-","text":"26,14 Nach and. Lesart: Machttaten","reference":{"chapter":26,"verse":14}}]},"thisChapterLink":"/api/deu_elbbk/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elbbk/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elbbk/JOB/25.json","previousChapterAudioLinks":{},"numb