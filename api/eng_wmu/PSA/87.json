{"translation":{"id":"eng_wmu","name":"World Messianic Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseNotes":null,"shortName":"WMBBE","englishName":"World Messianic Bible British Edition","language":"eng","textDirection":"ltr","sha256":"ba62c43c08b77c989ea8a6fa2b2e367920b799f5079a8f1b7482f6dccddccdd4","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"ff57ea4551f4ccdfead2eb39951ce341b9096babbe7ab011de7ef11f6b6ffd00","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["A Psalm by the sons of Korah; a Song."]},{"type":"verse","number":1,"content":[{"text":"His foundation is in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"The LORD loves the gates of Zion more than all the dwellings of Jacob.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Glorious things are spoken about you, city of God. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will record Rahab","poem":1},{"noteId":28},{"text":"and Babylon amongst those who acknowledge me.","poem":1},{"text":"Behold, Philistia, Tyre, and also Ethiopia:","poem":2},{"lineBreak":true},{"text":"“This one was born there.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yes, of Zion it will be said, “This one and that one was born in her;”","poem":1},{"text":"the Most High himself will establish her.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The LORD will count, when he writes up the peoples,","poem":1},{"text":"“This one was born there.” Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Those who sing as well as those who dance say,","poem":1},{"text":"“All my springs are in you.”","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Rahab is a reference to Egypt.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/eng_wmu/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmu/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmu/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}