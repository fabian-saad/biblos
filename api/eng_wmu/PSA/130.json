{"translation":{"id":"eng_wmu","name":"World Messianic Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseNotes":null,"shortName":"WMBBE","englishName":"World Messianic Bible British Edition","language":"eng","textDirection":"ltr","sha256":"ba62c43c08b77c989ea8a6fa2b2e367920b799f5079a8f1b7482f6dccddccdd4","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"ff57ea4551f4ccdfead2eb39951ce341b9096babbe7ab011de7ef11f6b6ffd00","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"Out of the depths I have cried to you, LORD.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, hear my voice.","poem":1},{"text":"Let your ears be attentive to the voice of my petitions.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"If you, LORD, kept a record of sins,","poem":1},{"text":"Lord, who could stand?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"But there is forgiveness with you,","poem":1},{"text":"therefore you are feared.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I wait for the LORD.","poem":1},{"text":"My soul waits.","poem":2},{"lineBreak":true},{"text":"I hope in his word.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul longs for the Lord more than watchmen long for the morning,","poem":1},{"text":"more than watchmen for the morning.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel, hope in the LORD,","poem":1},{"text":"for there is loving kindness with the LORD.","poem":2},{"lineBreak":true},{"text":"Abundant redemption is with him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He will redeem Israel from all their sins.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmu/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmu/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmu/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}