{"translation":{"id":"eng_wmu","name":"World Messianic Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseNotes":null,"shortName":"WMBBE","englishName":"World Messianic Bible British Edition","language":"eng","textDirection":"ltr","sha256":"ba62c43c08b77c989ea8a6fa2b2e367920b799f5079a8f1b7482f6dccddccdd4","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"ff57ea4551f4ccdfead2eb39951ce341b9096babbe7ab011de7ef11f6b6ffd00","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"May the LORD answer you in the day of trouble.","poem":1},{"text":"May the name of the God of Jacob set you up on high,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"send you help from the sanctuary,","poem":2},{"lineBreak":true},{"text":"grant you support from Zion,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"remember all your offerings,","poem":2},{"lineBreak":true},{"text":"and accept your burnt sacrifice. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"May he grant you your heart’s desire,","poem":1},{"text":"and fulfil all your counsel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"We will triumph in your salvation.","poem":1},{"text":"In the name of our God, we will set up our banners.","poem":2},{"lineBreak":true},{"text":"May the LORD grant all your requests.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Now I know that the LORD saves his anointed.","poem":1},{"text":"He will answer him from his holy heaven,","poem":2},{"lineBreak":true},{"text":"with the saving strength of his right hand.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Some trust in chariots, and some in horses,","poem":1},{"text":"but we trust in the name of the LORD our God.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They are bowed down and fallen,","poem":1},{"text":"but we rise up, and stand upright.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Save, LORD!","poem":1},{"text":"Let the King answer us when we call!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmu/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmu/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmu/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}