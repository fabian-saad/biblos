{"translation":{"id":"eng_wmu","name":"World Messianic Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmbb","licenseNotes":null,"shortName":"WMBBE","englishName":"World Messianic Bible British Edition","language":"eng","textDirection":"ltr","sha256":"ba62c43c08b77c989ea8a6fa2b2e367920b799f5079a8f1b7482f6dccddccdd4","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmu","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"ff57ea4551f4ccdfead2eb39951ce341b9096babbe7ab011de7ef11f6b6ffd00","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By David."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said to me,","poem":1},{"text":"“Let’s go to the LORD’s house!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Our feet are standing within your gates, Jerusalem!","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Jerusalem is built as a city that is compact together,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"where the tribes go up, even the LORD’s tribes,","poem":1},{"text":"according to an ordinance for Israel,","poem":2},{"lineBreak":true},{"text":"to give thanks to the LORD’s name.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For there are set thrones for judgement,","poem":1},{"text":"the thrones of David’s house.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pray for the peace of Jerusalem.","poem":1},{"text":"Those who love you will prosper.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peace be within your walls,","poem":1},{"text":"and prosperity within your palaces.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For my brothers’ and companions’ sakes,","poem":1},{"text":"I will now say, “Peace be within you.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For the sake of the house of the LORD our God,","poem":1},{"text":"I will seek your good.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmu/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmu/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmu/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}