{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord! Sing a new song to the Lord! Praise him wherever his faithful followers gather!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel celebrate their Creator; let the people of Zion be happy in their King.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Praise his nature with dancing; sing praises to him, accompanied by tambourine and harp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the Lord enjoys his people; he honors the oppressed with salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the faithful celebrate how he honors them; let them sing happily even from their beds.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May their praises of God always be on their lips, a double-edged sword in their hands,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ready to take revenge on the nations, to punish the foreign peoples,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"to imprison their kings in shackles and their leaders in iron chains,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"to impose the judgment decreed against them. This is an honor for all his faithful followers. Praise the Lord!","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_fbv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}