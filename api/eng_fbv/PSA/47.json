{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["For the music director. A psalm of the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"Everyone, clap your hands! Shout with joy to the Lord!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For the Lord Most High is awe-inspiring; he is the great King of all the earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He subdues other peoples under us; he puts nations under our feet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He chose the land for us to own; the proud possession of Jacob's descendants whom he loves. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God ascends his throne","poem":1},{"noteId":143},{"text":"with a great shout, the Lord is accompanied by the sound of the trumpet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sing praises to God, sing praises; sing praises to our King, sing praises!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For God is King of all the earth; sing praises with a psalm!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God rules over the nations; he sits on his holy throne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"The rulers of the nations gather together with the people of the God of Abraham, for the defenders","poem":1},{"noteId":144},{"text":"of the earth belong to God. He is highly honored everywhere.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":143,"caller":"+","text":"Implied.","reference":{"chapter":47,"verse":5}},{"noteId":144,"caller":"+","text":"Literally, “shields.”","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/eng_fbv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}