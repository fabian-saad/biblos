{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["For the music director. To be accompanied by stringed instruments. A psalm. A song."]},{"type":"verse","number":1,"content":[{"text":"May God be gracious to us and bless us. May he look favorably on us. Selah.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"May everyone on earth come to know your ways, your salvation among all people.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May the people praise you, God; may all the people praise you.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"May they be happy and sing for joy because you judge people fairly, and you guide everyone on earth. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"May the people praise you, God; may all the people praise you.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The earth has produced its crops; and God, our God, has blessed us.","poem":1},{"noteId":205}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God will bless us, and all people everywhere will respect","poem":1},{"noteId":206},{"text":"him.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":205,"caller":"+","text":"Or “May the earth produce its crops; may God, our God, bless us.”","reference":{"chapter":67,"verse":6}},{"noteId":206,"caller":"+","text":"Literally, “fear.”","reference":{"chapter":67,"verse":7}}]},"thisChapterLink":"/api/eng_fbv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}