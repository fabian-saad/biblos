{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A song for pilgrims going up to Jerusalem. A psalm of Solomon."]},{"type":"verse","number":1,"content":[{"text":"If the Lord doesn't build the house, the work of the builders is futile. If the Lord doesn't guard the city, the work of the guards is pointless.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It's useless to get up early in the morning and go to work, and stay late into the evening, worrying about earning enough to eat, when the Lord gives rest to those he loves.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Children certainly are a gift from the Lord, for a family is a blessing.","poem":1},{"noteId":432}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Like arrows in the hand of a warrior are the children of a young man.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Happy is the father who fills his quiver","poem":1},{"noteId":433},{"text":"with them! Such fathers will not be embarrassed when they confront their enemies at the city gate.","poem":1},{"noteId":434}]},{"type":"line_break"}],"footnotes":[{"noteId":432,"caller":"+","text":"Literally, “the reward of the fruit of the womb.”","reference":{"chapter":127,"verse":3}},{"noteId":433,"caller":"+","text":"A container for arrows.","reference":{"chapter":127,"verse":5}},{"noteId":434,"caller":"+","text":"“City gate.” The place where judgments were made, similar to a court.","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/eng_fbv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}