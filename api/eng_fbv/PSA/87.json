{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["A song. A psalm of the descendants of Korah."]},{"type":"verse","number":1,"content":[{"text":"The Lord founded the city on his holy mountain.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jerusalem is the city that the Lord loves more than any other city in Israel.","poem":1},{"noteId":300}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Many wonderful things are said of you, city of God! Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I mention Egypt","poem":1},{"noteId":301},{"text":"and Babylon as those who know me, and in addition Philistia, Tyre, and Ethiopia—“this man was born there.”","poem":1},{"noteId":302}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"It will be said concerning Jerusalem, “Everyone was born there,”","poem":1},{"noteId":303},{"text":"and the Most High will make it secure.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"When the Lord registers the nations, he will write, “They were born there.”","poem":1},{"noteId":304},{"text":"Selah.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Singers and dancers alike say, “Living here I am at home.”","poem":1},{"noteId":305}]},{"type":"line_break"}],"footnotes":[{"noteId":300,"caller":"+","text":"“Israel”: literally, Jacob.","reference":{"chapter":87,"verse":2}},{"noteId":301,"caller":"+","text":"Literally, “Rahab.”","reference":{"chapter":87,"verse":4}},{"noteId":302,"caller":"+","text":"The meaning of this verse is debated. What it seems to be saying is that despite the patriotism for each country/city mentioned, the best is to be born in Jerusalem. (See following verse.)","reference":{"chapter":87,"verse":4}},{"noteId":303,"caller":"+","text":"In other words, everyone will have the right to citizenship in Jerusalem.","reference":{"chapter":87,"verse":5}},{"noteId":304,"caller":"+","text":"In Jerusalem.","reference":{"chapter":87,"verse":6}},{"noteId":305,"caller":"+","text":"Literally, “All of my springs are in you.”","reference":{"chapter":87,"verse":7}}]},"thisChapterLink":"/api/eng_fbv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}