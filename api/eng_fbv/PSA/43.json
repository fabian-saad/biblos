m":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_fbv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}