{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"At the time of the exodus of Israel from Egypt, when the descendants of Jacob left that foreign country,","poem":1},{"noteId":394}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"the land of Judah became the Lord's sanctuary, Israel his kingdom.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Red Sea saw them and ran away; the Jordan River retreated.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mountains jumped in fright","poem":1},{"noteId":395},{"text":"like rams, hills startled","poem":1},{"noteId":396},{"text":"like lambs.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Red Sea—why did you run away? Jordan River—why did you retreat?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mountains—why did you jump in fright? Hills—why did you startle like lambs?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Earth, tremble in the presence of the Lord, tremble in the presence of the God of Jacob!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He is the one who turned the rock into a pool of water; making water flow from the hard rock.","poem":1},{"noteId":397}]},{"type":"line_break"}],"footnotes":[{"noteId":394,"caller":"+","text":"“Foreign country”: literally, “people of a foreign language.”","reference":{"chapter":114,"verse":1}},{"noteId":395,"caller":"+","text":"Literally “skipped,” but this suggests a playful action when the context makes it clear that the jumping is due to fear, not joy.","reference":{"chapter":114,"verse":4}},{"noteId":396,"caller":"+","text":"“Startled”: implied. The image is of mountains and hills shaking as in an earthquake.","reference":{"chapter":114,"verse":4}},{"noteId":397,"caller":"+","text":"See Exodus 17:1-7; Numbers 20:1-13.","reference":{"chapter":114,"verse":8}}]},"thisChapterLink":"/api/eng_fbv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}