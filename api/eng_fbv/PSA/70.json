{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["For the music director. A psalm of David. For a memorial.",{"noteId":231}]},{"type":"verse","number":1,"content":[{"text":"God, save me! Hurry, Lord, help me!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Please defeat and humiliate the people who are trying to kill me; turn back in disgrace those who want to hurt me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May they be shocked at their defeat, those who taunted me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But may everyone who comes to you be happy and glad; may those who love your salvation always say, “God is great!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"As for me, I am poor and needy. Hurry, God, help me! Save me! Lord, don't wait!","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":231,"caller":"+","text":"This psalm is taken from Psalms 40with a few minor changes.","reference":{"chapter":70,"verse":0}}]},"thisChapterLink":"/api/eng_fbv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}