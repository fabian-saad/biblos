{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Since the Lord is my shepherd, I have everything I need.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He gives me rest in green fields. He leads me towards quietly flowing streams.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He revives me. He guides me along the right paths because that's the kind of person he is.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Even when I walk through the valley dark as death, I'm not afraid of any evil, because you are right there with me; your rod and your staff protect me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"You prepare a banquet for me before my enemies. You honor me by anointing my head with olive oil. My cup is so full it overflows!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I'm absolutely certain that your goodness and trustworthy love will be with me all through my life, and I will live in the house of the Lord forever.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_fbv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}