{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A song for pilgrims going up to Jerusalem. A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I was so happy when they said to me, “Let's go the house of the Lord.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Now we're standing inside your gates, Jerusalem!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem is built as a city where people can be together.","poem":1},{"noteId":429}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"All the tribes—the tribes of the Lord—go up there, following the command given to Israel to give thanks to the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"This is where the thrones are placed, where judgment is given, the thrones of the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pray that Jerusalem may be at peace. May everyone who loves Jerusalem be kept safe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May there be peace within your walls, and safety within your fortresses.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"On behalf of my family and friends, I will now say, “May you be at peace.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"On behalf of the house of the Lord our God, I pray that everything goes well for you.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":429,"caller":"+","text":"“Where people can be together,” or, “that is closely joined together.”","reference":{"chapter":122,"verse":3}}]},"thisChapterLink":"/api/eng_fbv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}