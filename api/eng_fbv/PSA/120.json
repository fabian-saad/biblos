{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A song for pilgrims going up to Jerusalem."]},{"type":"verse","number":1,"content":[{"text":"I called out to the Lord for help in all my troubles, and he answered me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, please save me from liars and cheats!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"What will the Lord do to you, you liars? How will he punish you?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"With the sharp arrows of a warrior and burning coals made from a broom tree.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I'm sorry for myself, because I live as a foreigner in Meshech, or among the tent-dwellers of Kedar.","poem":1},{"noteId":427}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I have lived for far too long among people who hate peace.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I want peace, but when I talk of peace, they want war.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":427,"caller":"+","text":"Far-off places, very distant from each other.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/eng_fbv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}