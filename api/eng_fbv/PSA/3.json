{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A psalm of David concerning the time he had to flee from his son Absalom."]},{"type":"verse","number":1,"content":[{"text":"Lord, my enemies have become so many; so many are rebelling","poem":1},{"noteId":8},{"text":"against me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"So many are telling me, “God can't save you!” Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But you, Lord, are a shield protecting me. You give me victory;","poem":1},{"noteId":9},{"text":"you hold my head high.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I cry out to the Lord for help, and he answers me from his holy mountain. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I lie down to sleep, and in the morning","poem":1},{"noteId":10},{"text":"I wake up because the Lord takes care of me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I'm not afraid of tens of thousands who surround me, people who are against me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Stand up for me, Lord! Save me, my God! Hit all my enemies on the cheek; break the teeth of the wicked!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Salvation belongs to you, Lord; may you be a blessing to your people. Selah.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":8,"caller":"+","text":"Since David is the writer this is clearly a reference to a widespread rebellion against him as king.","reference":{"chapter":3,"verse":1}},{"noteId":9,"caller":"+","text":"Literally, “you are my glory” which makes little sense in English.","reference":{"chapter":3,"verse":3}},{"noteId":10,"caller":"+","text":"Implied.","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/eng_fbv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}