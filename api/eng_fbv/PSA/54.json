{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["For the music director. With stringed instruments. A psalm (maskil) of David, concerning the time when the Ziphites came to Saul and told him, “David is hiding among us.”"]},{"type":"verse","number":1,"content":[{"text":"God, because of your very nature,","poem":1},{"noteId":164},{"text":"please save me! Vindicate me by your power!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God, please hear my prayer; listen to what I'm saying.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For strangers are coming to attack me—violent men who don't care about God are trying to kill me. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But God helps me; the Lord saves my life!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The evil my enemies have done will come back upon them. I depend on you to destroy them.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will happily offer a sacrifice to you; I will praise the kind of person you are,","poem":1},{"noteId":165},{"text":"Lord, for you are good.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"For he has saved me from all my troubles; and I have seen those who hated me defeated.","poem":1},{"noteId":166}]},{"type":"line_break"}],"footnotes":[{"noteId":164,"caller":"+","text":"Literally, “name.”","reference":{"chapter":54,"verse":1}},{"noteId":165,"caller":"+","text":"Literally, “your name.”","reference":{"chapter":54,"verse":6}},{"noteId":166,"caller":"+","text":"“Defeated”: implied. Literally, “with my eye I have looked at those who hate me.”","reference":{"chapter":54,"verse":7}}]},"thisChapterLink":"/api/eng_fbv/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}