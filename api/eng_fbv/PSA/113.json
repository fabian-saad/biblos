{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the Lord! Praise him, servants of the Lord! Praise the Lord as he is!","poem":1},{"noteId":390}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let the Lord's nature be praised, now and forever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let everyone everywhere, from the east to the west,","poem":1},{"noteId":391},{"text":"praise the Lord as he is!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The Lord rules supreme over all nations; his glory extends higher than the heavens.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Who is like the Lord our God? He is the one who lives on high, seated on his throne.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He has to stoop low to look down on the heavens and the earth.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He helps the poor up from the dust; he lifts the needy from the dump.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He gives them positions of honor","poem":1},{"noteId":392},{"text":"together with important leaders,","poem":1},{"noteId":393},{"text":"with leaders of his own people.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He makes the childless woman happy in her home by giving her children. Praise the Lord!","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":390,"caller":"+","text":"“As he is!” literally, “name,” but this word in Hebrew means far more than simply an appellation, “name” is indicative of nature and character. Also in verses 2 and 3.","reference":{"chapter":113,"verse":1}},{"noteId":391,"caller":"+","text":"Or “from sunrise to sunset.”","reference":{"chapter":113,"verse":3}},{"noteId":392,"caller":"+","text":"“Gives them positions of honor”: literally, “makes them sit.”","reference":{"chapter":113,"verse":8}},{"noteId":393,"caller":"+","text":"“Important leaders”: literally, “princes.”","reference":{"chapter":113,"verse":8}}]},"thisChapterLink":"/api/eng_fbv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}