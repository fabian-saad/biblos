{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["A song for pilgrims going up to Jerusalem."]},{"type":"verse","number":1,"content":[{"text":"Happy are all those who worship the Lord, everyone who follows his ways!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"You will eat what your own hands have produced. You will be happy and do well.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Your wife will be like a fruitful vine growing in your home. Your children will be like the shoots of an olive tree around your table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"This will certainly be the Lord's blessing on those who worship him.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"May the Lord go on blessing you from Zion; may you see Jerusalem prosper all the days of your life.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May you see your children's children. May Israel be at peace!","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_fbv/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}