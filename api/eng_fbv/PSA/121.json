{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["A song for pilgrims going up to Jerusalem."]},{"type":"verse","number":1,"content":[{"text":"I look to the hills","poem":1},{"noteId":428},{"text":"—but is that where my help comes from?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"My help comes from the Lord, who made heaven and earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He will not let you fall; he who watches over you won't fall asleep.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"In fact he who watches over you doesn't take naps or fall asleep.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord keeps watch over you; the Lord protects you; he stands right beside you.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The sun won't hurt you during the day, nor the moon at night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord will protect you from all kinds of evil; he will keep you safe and sound.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord will look after you when you leave, and when you return, now and forever.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":428,"caller":"+","text":"It seems most likely that this reference is to pagan worship which occurred on the “high places” of the hills, and that this is contrasted with the true source of help in verse 2—the Lord.","reference":{"chapter":121,"verse":1}}]},"thisChapterLink":"/api/eng_fbv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}