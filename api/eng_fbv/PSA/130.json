{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A song for pilgrims going up to Jerusalem."]},{"type":"verse","number":1,"content":[{"text":"Lord, I cry out to you from the depths of my pain.","poem":1},{"noteId":436}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Please listen to my cry, and pay attention to what I'm asking.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lord, if you kept a list of sins, who could escape being condemned?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"But you are forgiving so that we might respect you.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I'm waiting for the Lord, longingly waiting, for I trust in his word.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I long for the Lord to come, more than watchmen longing for the dawn to come, more than watchmen longing for the dawn to come.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel, put your hope in the Lord, for the Lord loves us with a trustworthy love and his salvation knows no limits.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"He will save Israel from every sin.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":436,"caller":"+","text":"“Of my pain”: implied.","reference":{"chapter":130,"verse":1}}]},"thisChapterLink":"/api/eng_fbv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}