{"translation":{"id":"eng_fbv","name":"Free Bible Version","website":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engfbv","licenseNotes":null,"shortName":"FBV","englishName":"Free Bible Version","language":"eng","textDirection":"ltr","sha256":"bd9b8be2354d7bee243bb9611ae9e33ef84d766cff4a0fa455952bc26611c772","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_fbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_fbv","name":"PSALMS","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"03bd854949268f3e3ac3925dce03f66c933950c38ef7b3fa0c22b3757f8fbfd0","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_fbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_fbv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Confirm that I'm innocent, Lord, for I have acted with integrity, and I have trusted in the Lord without fail.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Examine me, Lord, test me; investigate my thoughts and intentions.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For I always remember your trustworthy love, and I follow your truth.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I don't join in with liars and I don't associate with hypocrites.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I refuse to get together with those who do evil, and I won't involve myself with the wicked.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I wash my hands to show my innocence. I come to worship","poem":1},{"noteId":76},{"text":"at your altar, Lord,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"singing my thanks, telling of all the wonderful things you have done.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lord, I love your house, the place where you live in your glory.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Please don't sweep me away along with sinners. Don't include me with those who commit murder,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"whose hands carry out their evil schemes and grab hold of bribes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"For I don't do that—I act with integrity. Save me and be gracious to me!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I stand for what's right,","poem":1},{"noteId":77},{"text":"and I will praise the Lord when we meet together to worship him.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":76,"caller":"+","text":"Literally, “I march around your altar”—part of the actions of worship.","reference":{"chapter":26,"verse":6}},{"noteId":77,"caller":"+","text":"“I stand for what's right”: literally, “My foot stands on level ground.”","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/eng_fbv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_fbv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_fbv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}