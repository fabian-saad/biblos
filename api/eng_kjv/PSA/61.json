{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician upon Neginah, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"Hear my cry, O God; attend unto my prayer.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"From the end of the earth will I cry unto thee, when my heart is overwhelmed: lead me to the rock that is higher than I.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For thou hast been a shelter for me, and a strong tower from the enemy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will abide in thy tabernacle for ever: I will trust in the covert of thy wings. Selah.","poem":1},{"noteId":352}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"For thou, O God, hast heard my vows: thou hast given me the heritage of those that fear thy name.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thou wilt prolong the king’s life: and his years as many generations.","poem":1},{"noteId":353},{"noteId":354}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"He shall abide before God for ever: O prepare mercy and truth, which may preserve him.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"So will I sing praise unto thy name for ever, that I may daily perform my vows.","poem":1}]}],"footnotes":[{"noteId":352,"caller":"+","text":"61.4 trust: or, make my refuge","reference":{"chapter":61,"verse":4}},{"noteId":353,"caller":"+","text":"61.6 Thou…: Heb. Thou shalt add days to the days of the king","reference":{"chapter":61,"verse":6}},{"noteId":354,"caller":"+","text":"61.6 as…: Heb. as generation and generation","reference":{"chapter":61,"verse":6}}]},"thisChapterLink":"/api/eng_kjv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}