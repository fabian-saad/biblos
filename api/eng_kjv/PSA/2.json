{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Why do the heathen rage, and the people imagine a vain thing?","poem":1},{"noteId":2},{"noteId":3}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The kings of the earth set themselves, and the rulers take counsel together, against the LORD, and against his anointed, saying,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let us break their bands asunder, and cast away their cords from us.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He that sitteth in the heavens shall laugh: the Lord shall have them in derision.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Then shall he speak unto them in his wrath, and vex them in his sore displeasure.","poem":1},{"noteId":4}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yet have I set my king upon my holy hill of Zion.","poem":1},{"noteId":5},{"noteId":6}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I will declare the decree: the LORD hath said unto me, Thou art my Son; this day have I begotten thee.","poem":1},{"noteId":7}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ask of me, and I shall give thee the heathen for thine inheritance, and the uttermost parts of the earth for thy possession.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Thou shalt break them with a rod of iron; thou shalt dash them in pieces like a potter’s vessel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Be wise now therefore, O ye kings: be instructed, ye judges of the earth.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Serve the LORD with fear, and rejoice with trembling.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kiss the Son, lest he be angry, and ye perish from the way, when his wrath is kindled but a little. Blessed are all they that put their trust in him.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"2.1 rage: or, tumultuously assemble","reference":{"chapter":2,"verse":1}},{"noteId":3,"caller":"+","text":"2.1 imagine: Heb. meditate","reference":{"chapter":2,"verse":1}},{"noteId":4,"caller":"+","text":"2.5 vex: or, trouble","reference":{"chapter":2,"verse":5}},{"noteId":5,"caller":"+","text":"2.6 set: Heb. anointed","reference":{"chapter":2,"verse":6}},{"noteId":6,"caller":"+","text":"2.6 upon…: Heb. upon Zion, the hill of my holiness","reference":{"chapter":2,"verse":6}},{"noteId":7,"caller":"+","text":"2.7 the decree: or, for a decree","reference":{"chapter":2,"verse":7}}]},"thisChapterLink":"/api/eng_kjv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}