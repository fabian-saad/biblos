{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the LORD. Sing unto the LORD a new song, and his praise in the congregation of saints.","poem":1},{"noteId":765}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let Israel rejoice in him that made him: let the children of Zion be joyful in their King.","poem":1},{"noteId":766}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them praise his name in the dance: let them sing praises unto him with the timbrel and harp.","poem":1},{"noteId":767}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"For the LORD taketh pleasure in his people: he will beautify the meek with salvation.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the saints be joyful in glory: let them sing aloud upon their beds.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Let the high praises of God be in their mouth, and a twoedged sword in their hand;","poem":1},{"noteId":768}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To execute vengeance upon the heathen, and punishments upon the people;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To bind their kings with chains, and their nobles with fetters of iron;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To execute upon them the judgment written: this honour have all his saints. Praise ye the LORD.","poem":1}]}],"footnotes":[{"noteId":765,"caller":"+","text":"149.1 Praise…: Heb. Hallelujah","reference":{"chapter":149,"verse":1}},{"noteId":766,"caller":"+","text":"149.2 in him…: Heb. in his Makers","reference":{"chapter":149,"verse":2}},{"noteId":767,"caller":"+","text":"149.3 in…: or, with the pipe","reference":{"chapter":149,"verse":3}},{"noteId":768,"caller":"+","text":"149.6 mouth: Heb. throat","reference":{"chapter":149,"verse":6}}]},"thisChapterLink":"/api/eng_kjv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}