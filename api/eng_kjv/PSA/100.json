{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["A Psalm of praise."]},{"type":"verse","number":1,"content":[{"text":"Make a joyful noise unto the LORD, all ye lands.","poem":1},{"noteId":572},{"noteId":573}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Serve the LORD with gladness: come before his presence with singing.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Know ye that the LORD he is God: it is he that hath made us, and not we ourselves; we are his people, and the sheep of his pasture.","poem":1},{"noteId":574}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Enter into his gates with thanksgiving, and into his courts with praise: be thankful unto him, and bless his name.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"For the LORD is good; his mercy is everlasting; and his truth endureth to all generations.","poem":1},{"noteId":575}]}],"footno