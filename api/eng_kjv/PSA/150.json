e ye the LORD.","poem":1}]}],"footnotes":[{"noteId":769,"caller":"+","text":"150.1 Praise ye…: Heb. Hallelujah","reference":{"chapter":150,"verse":1}},{"noteId":770,"caller":"+","text":"150.3 trumpet: or, cornet","reference":{"chapter":150,"verse":3}},{"noteId":771,"caller":"+","text":"150.4 dance: or, pipe","reference":{"chapter":150,"verse":4}}]},"thisChapterLink":"/api/eng_kjv/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}