{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat down, yea, we wept, when we remembered Zion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"We hanged our harps upon the willows in the midst thereof.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For there they that carried us away captive required of us a song; and they that wasted us required of us mirth, saying, Sing us one of the songs of Zion.","poem":1},{"noteId":711},{"noteId":712}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"How shall we sing the LORD’s song in a strange land?","poem":1},{"noteId":713}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget thee, O Jerusalem, let my right hand forget her cunning.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"If I do not remember thee, let my tongue cleave to the roof of my mouth; if I prefer not Jerusalem above my chief joy.","poem":1},{"noteId":714}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Remember, O LORD, the children of Edom in the day of Jerusalem; who said, Rase it, rase it, even to the foundation thereof.","poem":1},{"noteId":715}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O daughter of Babylon, who art to be destroyed; happy shall he be, that rewardeth thee as thou hast served us.","poem":1},{"noteId":716},{"noteId":717}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Happy shall he be, that taketh and dasheth thy little ones against the stones.","poem":1},{"noteId":718}]}],"footnotes":[{"noteId":711,"caller":"+","text":"137.3 a song: Heb. the words of a song","reference":{"chapter":137,"verse":3}},{"noteId":712,"caller":"+","text":"137.3 wasted…: Heb. laid us on heaps","reference":{"chapter":137,"verse":3}},{"noteId":713,"caller":"+","text":"137.4 strange…: Heb. land of a stranger?","reference":{"chapter":137,"verse":4}},{"noteId":714,"caller":"+","text":"137.6 my chief…: Heb. the head of my joy","reference":{"chapter":137,"verse":6}},{"noteId":715,"caller":"+","text":"137.7 Rase it: Heb. Make bare","reference":{"chapter":137,"verse":7}},{"noteId":716,"caller":"+","text":"137.8 destroyed: Heb. wasted","reference":{"chapter":137,"verse":8}},{"noteId":717,"caller":"+","text":"137.8 rewardeth…: Heb. recompenseth unto thee thy deed which thou didst to us","reference":{"chapter":137,"verse":8}},{"noteId":718,"caller":"+","text":"137.9 the stones: Heb. the rock","reference":{"chapter":137,"verse":9}}]},"thisChapterLink":"/api/eng_kjv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}