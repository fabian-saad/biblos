{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"How long wilt thou forget me, O LORD? for ever? how long wilt thou hide thy face from me?","poem":1},{"noteId":63}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long shall I take counsel in my soul, having sorrow in my heart daily? how long shall mine enemy be exalted over me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Consider and hear me, O LORD my God: lighten mine eyes, lest I sleep the sleep of death;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lest mine enemy say, I have prevailed against him; and those that trouble me rejoice when I am moved.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I have trusted in thy mercy; my heart shall rejoice in thy salvation.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will sing unto the LORD, because he hath dealt bountifully with me.","poem":1}]}],"footnotes":[{"noteId":63,"caller":"+","text":"13.1 chief…: or, overseer","reference":{"chapter":13,"verse":1}}]},"thisChapterLink":"/api/eng_kjv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}