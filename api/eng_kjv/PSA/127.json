hall speak with the enemies in the gate.","poem":1},{"noteId":692},{"noteId":693}]}],"footnotes":[{"noteId":690,"caller":"+","text":"127.1 for…: or, of Solomon","reference":{"chapter":127,"verse":1}},{"noteId":691,"caller":"+","text":"127.1 that…: Heb. that are builders of it in it","reference":{"chapter":127,"verse":1}},{"noteId":692,"caller":"+","text":"127.5 his…: Heb. filled his quiver with them","reference":{"chapter":127,"verse":5}},{"noteId":693,"caller":"+","text":"127.5 speak…: or, subdue, or, destroy","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/eng_kjv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}