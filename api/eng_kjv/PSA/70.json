{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David, to bring to remembrance."]},{"type":"verse","number":1,"content":[{"text":"Make haste, O God, to deliver me; make haste to help me, O LORD.","poem":1},{"noteId":416}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let them be ashamed and confounded that seek after my soul: let them be turned backward, and put to confusion, that desire my hurt.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let them be turned back for a reward of their shame that say, Aha, aha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let all those that seek thee rejoice and be glad in thee: and let such as love thy salvation say continually, Let God be magnified.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I am poor and needy: make haste unto me, O God: thou art my help and my deliverer; O LORD, make no tarrying.","poem":1}]}],"footnotes":[{"noteId":416,"caller":"+","text":"70.1 to help…: Heb. to my help","reference":{"chapter":70,"verse":1}}]},"thisChapterLink":"/api/eng_kjv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}