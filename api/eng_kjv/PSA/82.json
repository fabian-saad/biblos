{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["A Psalm of Asaph."]},{"type":"verse","number":1,"content":[{"text":"God standeth in the congregation of the mighty; he judgeth among the gods.","poem":1},{"noteId":498}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will ye judge unjustly, and accept the persons of the wicked? Selah.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Defend the poor and fatherless: do justice to the afflicted and needy.","poem":1},{"noteId":499}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Deliver the poor and needy: rid them out of the hand of the wicked.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They know not, neither will they understand; they walk on in darkness: all the foundations of the earth are out of course.","poem":1},{"noteId":500}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I have said, Ye are gods; and all of you are children of the most High.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But ye shall die like men, and fall like one of the princes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Arise, O God, judge the earth: for thou shalt inherit all nations.","poem":1}]}],"footnotes":[{"noteId":498,"caller":"+","text":"82.1 of Asaph: or, for Asaph","reference":{"chapter":82,"verse":1}},{"noteId":499,"caller":"+","text":"82.3 Defend: Heb. Judge","reference":{"chapter":82,"verse":3}},{"noteId":500,"caller":"+","text":"82.5 out…: Heb. moved","reference":{"chapter":82,"verse":5}}]},"thisChapterLink":"/api/eng_kjv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}