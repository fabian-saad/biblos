{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"In my distress I cried unto the LORD, and he heard me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Deliver my soul, O LORD, from lying lips, and from a deceitful tongue.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"What shall be given unto thee? or what shall be done unto thee, thou false tongue?","poem":1},{"noteId":679},{"noteId":680}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sharp arrows of the mighty, with coals of juniper.","poem":1},{"noteId":681}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Woe is me, that I sojourn in Mesech, that I dwell in the tents of Kedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"My soul hath long dwelt with him that hateth peace.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I am for peace: but when I speak, they are for war.","poem":1},{"noteId":682}]}],"footnotes":[{"noteId":679,"caller":"+","text":"120.3 What shall be given…: or, What shall the deceitful tongue give unto thee? or, what shall is profit thee?","reference":{"chapter":120,"verse":3}},{"noteId":680,"caller":"+","text":"120.3 done: Heb. added","reference":{"chapter":120,"verse":3}},{"noteId":681,"caller":"+","text":"120.4 Sharp…: or, It is as the sharp arrows of the mighty man, with coals of juniper","reference":{"chapter":120,"verse":4}},{"noteId":682,"caller":"+","text":"120.7 for peace: or, a man of peace","reference":{"chapter":120,"verse":7}}]},"thisChapterLink":"/api/eng_kjv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}