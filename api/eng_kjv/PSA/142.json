{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Maschil of David; A Prayer when he was in the cave."]},{"type":"verse","number":1,"content":[{"text":"I cried unto the LORD with my voice; with my voice unto the LORD did I make my supplication.","poem":1},{"noteId":734}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I poured out my complaint before him; I shewed before him my trouble.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"When my spirit was overwhelmed within me, then thou knewest my path. In the way wherein I walked have they privily laid a snare for me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I looked on my right hand, and beheld, but there was no man that would know me: refuge failed me; no man cared for my soul.","poem":1},{"noteId":735},{"noteId":736},{"noteId":737}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I cried unto thee, O LORD: I said, Thou art my refuge and my portion in the land of the living.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Attend unto my cry; for I am brought very low: deliver me from my persecutors; for they are stronger than I.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bring my soul out of prison, that I may praise thy name: the righteous shall compass me about; for thou shalt deal bountifully with me.","poem":1}]}],"footnotes":[{"noteId":734,"caller":"+","text":"142.1 Maschil…: or, A Psalm of David, giving instruction","reference":{"chapter":142,"verse":1}},{"noteId":735,"caller":"+","text":"142.4 I looked…: or, Look on the right hand, and see","reference":{"chapter":142,"verse":4}},{"noteId":736,"caller":"+","text":"142.4 failed…: Heb. perished from me","reference":{"chapter":142,"verse":4}},{"noteId":737,"caller":"+","text":"142.4 cared…: Heb. sought after","reference":{"chapter":142,"verse":4}}]},"thisChapterLink":"/api/eng_kjv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}