{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician, A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The fool hath said in his heart, There is no God. They are corrupt, they have done abominable works, there is none that doeth good.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The LORD looked down from heaven upon the children of men, to see if there were any that did understand, and seek God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"They are all gone aside, they are all together become filthy: there is none that doeth good, no, not one.","poem":1},{"noteId":64}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Have all the workers of iniquity no knowledge? who eat up my people as they eat bread, and call not upon the LORD.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"There were they in great fear: for God is in the generation of the righteous.","poem":1},{"noteId":65}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye have shamed the counsel of the poor, because the LORD is his refuge.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oh that the salvation of Israel were come out of Zion! when the LORD bringeth back the captivity of his people, Jacob shall rejoice, and Israel shall be glad.","poem":1},{"noteId":66}]}],"footnotes":[{"noteId":64,"caller":"+","text":"14.3 filthy: Heb. stinking","reference":{"chapter":14,"verse":3}},{"noteId":65,"caller":"+","text":"14.5 were…: Heb. they feared a fear","reference":{"chapter":14,"verse":5}},{"noteId":66,"caller":"+","text":"14.7 Oh…: Heb. Who will give","reference":{"chapter":14,"verse":7}}]},"thisChapterLink":"/api/eng_kjv/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}