{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["To the chief Musician on Neginoth, A Psalm or Song."]},{"type":"verse","number":1,"content":[{"text":"God be merciful unto us, and bless us; and cause his face to shine upon us; Selah.","poem":1},{"noteId":384},{"noteId":385}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"That thy way may be known upon earth, thy saving health among all nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let the people praise thee, O God; let all the people praise thee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O let the nations be glad and sing for joy: for thou shalt judge the people righteously, and govern the nations upon earth. Selah.","poem":1},{"noteId":386}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the people praise thee, O God; let all the people praise thee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Then shall the earth yield her increase; and God, even our own God, shall bless us.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God shall bless us; and all the ends of the earth shall fear him.","poem":1}]}],"footnotes":[{"noteId":384,"caller":"+","text":"67.1 chief…: or, overseer","reference":{"chapter":67,"verse":1}},{"noteId":385,"caller":"+","text":"67.1 upon: Heb. with","reference":{"chapter":67,"verse":1}},{"noteId":386,"caller":"+","text":"67.4 govern: Heb. lead","reference":{"chapter":67,"verse":4}}]},"thisChapterLink":"/api/eng_kjv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}