{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A Song of degrees."]},{"type":"verse","number":1,"content":[{"text":"When the LORD turned again the captivity of Zion, we were like them that dream.","poem":1},{"noteId":686}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Then was our mouth filled with laughter, and our tongue with singing: then said they among the heathen, The LORD hath done great things for them.","poem":1},{"noteId":687}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The LORD hath done great things for us; whereof we are glad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Turn again our captivity, O LORD, as the streams in the south.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They that sow in tears shall reap in joy.","poem":1},{"noteId":688}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"He that goeth forth and weepeth, bearing precious seed, shall doubtless come again with rejoicing, bringing his sheaves with him.","poem":1},{"noteId":689}]}],"footnotes":[{"noteId":686,"caller":"+","text":"126.1 turned…: Heb. returned the returning","reference":{"chapter":126,"verse":1}},{"noteId":687,"caller":"+","text":"126.2 hath…: Heb. hath magnified to do with them","reference":{"chapter":126,"verse":2}},{"noteId":688,"caller":"+","text":"126.5 joy: or, singing","reference":{"chapter":126,"verse":5}},{"noteId":689,"caller":"+","text":"126.6 precious…: or, seed basket","reference":{"chapter":126,"verse":6}}]},"thisChapterLink":"/api/eng_kjv/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}