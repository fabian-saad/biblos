{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Praise ye the LORD. I will praise the LORD with my whole heart, in the assembly of the upright, and in the congregation.","poem":1},{"noteId":631}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"The works of the LORD are great, sought out of all them that have pleasure therein.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"His work is honourable and glorious: and his righteousness endureth for ever.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"He hath made his wonderful works to be remembered: the LORD is gracious and full of compassion.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He hath given meat unto them that fear him: he will ever be mindful of his covenant.","poem":1},{"noteId":632}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"He hath shewed his people the power of his works, that he may give them the heritage of the heathen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The works of his hands are verity and judgment; all his commandments are sure.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"They stand fast for ever and ever, and are done in truth and uprightness.","poem":1},{"noteId":633}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"He sent redemption unto his people: he hath commanded his covenant for ever: holy and reverend is his name.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"The fear of the LORD is the beginning of wisdom: a good understanding have all they that do his commandments: his praise endureth for ever.","poem":1},{"noteId":634},{"noteId":635}]}],"footnotes":[{"noteId":631,"caller":"+","text":"111.1 Praise ye…: Heb. Hallelujah","reference":{"chapter":111,"verse":1}},{"noteId":632,"caller":"+","text":"111.5 meat: Heb. prey","reference":{"chapter":111,"verse":5}},{"noteId":633,"caller":"+","text":"111.8 stand…: Heb. are established","reference":{"chapter":111,"verse":8}},{"noteId":634,"caller":"+","text":"111.10 a good…: or, good success","reference":{"chapter":111,"verse":10}},{"noteId":635,"caller":"+","text":"111.10 his commandments: Heb. them","reference":{"chapter":111,"verse":10}}]},"thisChapterLink":"/api/eng_kjv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}