{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseNotes":null,"shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"90268887fe5c92c831e5efb59add2967583f912e780a9e4007a91dcc70ab4a30","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"57d49b3b4c9f2795a3f743b201a612311bf90170aec328cba4674ae61d0f0f4f","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David."]},{"type":"verse","number":1,"content":[{"text":"The LORD is my shepherd; I shall not want.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He maketh me to lie down in green pastures: he leadeth me beside the still waters.","poem":1},{"noteId":137},{"noteId":138}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He restoreth my soul: he leadeth me in the paths of righteousness for his name’s sake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over.","poem":1},{"noteId":139}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the LORD for ever.","poem":1},{"noteId":140}]}],"footnotes":[{"noteId":137,"caller":"+","text":"23.2 green…: Heb. pastures of tender grass","reference":{"chapter":23,"verse":2}},{"noteId":138,"caller":"+","text":"23.2 still…: Heb. waters of quietness","reference":{"chapter":23,"verse":2}},{"noteId":139,"caller":"+","text":"23.5 anointest: Heb. makest fat","reference":{"chapter":23,"verse":5}},{"noteId":140,"caller":"+","text":"23.6 for ever: Heb. to length of days","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/eng_kjv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}