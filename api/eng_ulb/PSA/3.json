{"translation":{"id":"eng_ulb","name":"Unlocked Literal Bible","website":"https://ebible.org/Scriptures/details.php?id=engULB","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engULB","licenseNotes":null,"shortName":"ULB","englishName":"Unlocked Literal Bible","language":"eng","textDirection":"ltr","sha256":"b49196591ea00f284ae257554bf70401eedbd0ee6fe1d5740695d4a400513876","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ulb","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"26c161d6f613a783a99c10722fb82170f9cf2d24db2f9c68aa37b8c0bb3755ac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ulb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A psalm of David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"Yahweh, how many are my enemies!","poem":1},{"lineBreak":true},{"text":"Many have risen against me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Many say about me,","poem":1},{"lineBreak":true},{"text":"“There is no help for him from God.” Selah","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"But you, Yahweh, are a shield around me,","poem":1},{"lineBreak":true},{"text":"my glory, and the one who lifts up my head.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I lift up my voice to Yahweh,","poem":1},{"lineBreak":true},{"text":"and he answers me from his holy hill. Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I lay down and slept;","poem":1},{"lineBreak":true},{"text":"I awoke, for Yahweh protected me.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will not be afraid of the multitudes of people","poem":1},{"lineBreak":true},{"text":"who have set themselves against me on every side.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rise up, Yahweh! Save me, my God!","poem":1},{"lineBreak":true},{"text":"For you will hit all my enemies on the jaw;","poem":1},{"lineBreak":true},{"text":"you will break the teeth of the wicked.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Salvation comes from Yahweh.","poem":1},{"lineBreak":true},{"text":"May your blessings be on your people. Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}