{"translation":{"id":"eng_ulb","name":"Unlocked Literal Bible","website":"https://ebible.org/Scriptures/details.php?id=engULB","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engULB","licenseNotes":null,"shortName":"ULB","englishName":"Unlocked Literal Bible","language":"eng","textDirection":"ltr","sha256":"b49196591ea00f284ae257554bf70401eedbd0ee6fe1d5740695d4a400513876","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ulb","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"26c161d6f613a783a99c10722fb82170f9cf2d24db2f9c68aa37b8c0bb3755ac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ulb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A song of ascents, of David."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said to me,","poem":1},{"lineBreak":true},{"text":"“Let us go to the house of Yahweh.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jerusalem, our feet are standing","poem":1},{"lineBreak":true},{"text":"within your gates!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalem, built","poem":1},{"lineBreak":true},{"text":"as a city carefully planned!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The tribes go up to Jerusalem—the tribes of Yahweh—","poem":1},{"lineBreak":true},{"text":"as a testimony for Israel,","poem":1},{"lineBreak":true},{"text":"to give thanks to the name of Yahweh.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"There thrones of judgment were set,","poem":1},{"lineBreak":true},{"text":"thrones of the house of David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pray for the peace of Jerusalem!","poem":1},{"lineBreak":true},{"text":"“May those who love you have peace.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May there be peace within the walls that defend you,","poem":1},{"lineBreak":true},{"text":"and may they have peace within your fortresses.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"For the sake of my brothers and my friends","poem":1},{"lineBreak":true},{"text":"I will say, “May there be peace within you.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"For the sake of the house of Yahweh our God,","poem":1},{"lineBreak":true},{"text":"I will seek good for you.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}