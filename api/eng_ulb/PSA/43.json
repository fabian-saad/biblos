{"translation":{"id":"eng_ulb","name":"Unlocked Literal Bible","website":"https://ebible.org/Scriptures/details.php?id=engULB","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engULB","licenseNotes":null,"shortName":"ULB","englishName":"Unlocked Literal Bible","language":"eng","textDirection":"ltr","sha256":"b49196591ea00f284ae257554bf70401eedbd0ee6fe1d5740695d4a400513876","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ulb","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"26c161d6f613a783a99c10722fb82170f9cf2d24db2f9c68aa37b8c0bb3755ac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ulb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Bring me justice, God, and plead my cause against an ungodly nation.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"For you are the God of my strength. Why have you rejected me?","poem":1},{"lineBreak":true},{"text":"Why do I go about in mourning because of the oppression of the enemy?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oh, send out your light and your truth, let them lead me.","poem":1},{"lineBreak":true},{"text":"Let them bring me to your holy hill","poem":1},{"lineBreak":true},{"text":"and to your dwelling.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Then I will go to the altar of God,","poem":1},{"lineBreak":true},{"text":"to God my exceeding joy.","poem":1},{"lineBreak":true},{"text":"I will praise you with the harp, God, my God.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Why are you bowed down, my soul?","poem":1},{"lineBreak":true},{"text":"Why are you upset within me?","poem":1},{"lineBreak":true},{"text":"Hope in God, for again I will praise him who is my salvation and my God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}