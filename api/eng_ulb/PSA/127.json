{"translation":{"id":"eng_ulb","name":"Unlocked Literal Bible","website":"https://ebible.org/Scriptures/details.php?id=engULB","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engULB","licenseNotes":null,"shortName":"ULB","englishName":"Unlocked Literal Bible","language":"eng","textDirection":"ltr","sha256":"b49196591ea00f284ae257554bf70401eedbd0ee6fe1d5740695d4a400513876","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ulb","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"26c161d6f613a783a99c10722fb82170f9cf2d24db2f9c68aa37b8c0bb3755ac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ulb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A song of ascents, of Solomon."]},{"type":"verse","number":1,"content":[{"text":"Unless Yahweh builds the house,","poem":1},{"lineBreak":true},{"text":"they work uselessly, those who build it.","poem":1},{"lineBreak":true},{"text":"Unless Yahweh guards the city,","poem":1},{"lineBreak":true},{"text":"the watchman stands guard uselessly.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is useless for you to rise up early,","poem":1},{"lineBreak":true},{"text":"to come home late,","poem":1},{"lineBreak":true},{"text":"or to eat the bread of hard work,","poem":1},{"lineBreak":true},{"text":"for Yahweh provides for his beloved as they sleep.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"See, children are a heritage from Yahweh,","poem":1},{"lineBreak":true},{"text":"and the fruit of the womb is a reward from him.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Like arrows in the hand of a warrior,","poem":1},{"lineBreak":true},{"text":"so are the children of one's youth.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"How blessed is the man that has his quiver full of them.","poem":1},{"lineBreak":true},{"text":"He will not be put to shame","poem":1},{"lineBreak":true},{"text":"when he confronts his enemies in the gate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}