{"translation":{"id":"eng_ulb","name":"Unlocked Literal Bible","website":"https://ebible.org/Scriptures/details.php?id=engULB","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engULB","licenseNotes":null,"shortName":"ULB","englishName":"Unlocked Literal Bible","language":"eng","textDirection":"ltr","sha256":"b49196591ea00f284ae257554bf70401eedbd0ee6fe1d5740695d4a400513876","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ulb","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"26c161d6f613a783a99c10722fb82170f9cf2d24db2f9c68aa37b8c0bb3755ac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ulb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"I will sing of covenant faithfulness and justice;","poem":1},{"lineBreak":true},{"text":"to you, Yahweh, I will sing praises.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I will walk in the way of integrity.","poem":1},{"lineBreak":true},{"text":"Oh, when will you come to me?","poem":1},{"lineBreak":true},{"text":"I will walk with integrity within my house.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I will not put wrongdoing before my eyes;","poem":1},{"lineBreak":true},{"text":"I hate worthless evil;","poem":1},{"lineBreak":true},{"text":"it will not cling to me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Perverse people will leave me;","poem":1},{"lineBreak":true},{"text":"I am not loyal to evil.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I will destroy whoever secretly slanders his neighbor.","poem":1},{"lineBreak":true},{"text":"I will not tolerate anyone who has a proud demeanor and an arrogant attitude.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will look to the faithful of the land to sit at my side.","poem":1},{"lineBreak":true},{"text":"Those who walk in the way of integrity may serve me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Deceitful people will not remain within my house;","poem":1},{"lineBreak":true},{"text":"liars will not be welcome before my eyes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Morning by morning I will destroy all the wicked from the land;","poem":1},{"lineBreak":true},{"text":"I will remove all evildoers from the city of Yahweh.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}