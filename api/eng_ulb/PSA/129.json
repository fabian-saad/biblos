nt":[{"lineBreak":true},{"text":"May they be like the grass on the housetops","poem":1},{"lineBreak":true},{"text":"that withers before it grows up,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"that cannot fill the reaper's hand","poem":1},{"lineBreak":true},{"text":"or the chest of the one who binds bundles of grain together.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"May those who pass by not say,","poem":1},{"lineBreak":true},{"text":"“May the blessing of Yahweh be on you;","poem":1},{"lineBreak":true},{"text":"we bless you in the name of Yahweh.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}