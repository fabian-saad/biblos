{"translation":{"id":"eng_ulb","name":"Unlocked Literal Bible","website":"https://ebible.org/Scriptures/details.php?id=engULB","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engULB","licenseNotes":null,"shortName":"ULB","englishName":"Unlocked Literal Bible","language":"eng","textDirection":"ltr","sha256":"b49196591ea00f284ae257554bf70401eedbd0ee6fe1d5740695d4a400513876","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31094,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_ulb","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"26c161d6f613a783a99c10722fb82170f9cf2d24db2f9c68aa37b8c0bb3755ac","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_ulb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["For the chief musician. A psalm of David."]},{"type":"verse","number":1,"content":[{"text":"How long, Yahweh, will you keep forgetting about me?","poem":1},{"lineBreak":true},{"text":"How long will you hide your face from me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long must I worry","poem":1},{"lineBreak":true},{"text":"and have grief in my heart all day?","poem":1},{"lineBreak":true},{"text":"How long will my enemy triumph over me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Look at me and answer me, Yahweh my God!","poem":1},{"lineBreak":true},{"text":"Give light to my eyes, or I will sleep in death.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Do not let my enemy say, “I have defeated him,”","poem":1},{"lineBreak":true},{"text":"so that my enemy may not say, “I have prevailed over my adversary”; otherwise, my enemies will rejoice when I am brought down.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I have trusted in your covenant faithfulness;","poem":1},{"lineBreak":true},{"text":"my heart rejoices in your salvation.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will sing to Yahweh","poem":1},{"lineBreak":true},{"text":"because he has treated me very generously.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_ulb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_ulb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_ulb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}