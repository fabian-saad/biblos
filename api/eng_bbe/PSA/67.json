{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["To the chief music-maker. With corded instruments. A Psalm. A Song."]},{"type":"verse","number":1,"content":[{"text":"May God give us mercy and blessing, and let the light of his face be shining on us; (Selah.)","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"So that men may see your way on the earth, and your salvation among all nations.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let the peoples give you praise, O God; let all the peoples give you praise.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O let the nations be glad, and make song of joy; for you will be the judge of the peoples in righteousness, guiding the nations of the earth. (Selah.)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Let the peoples give you praise, O God; let all the peoples give you praise.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"The earth has given her increase; and God, even our God, will give us his blessing.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God will give us his blessing; so let all the ends of the earth be in fear of him.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}