d. Let the Lord be praised.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}