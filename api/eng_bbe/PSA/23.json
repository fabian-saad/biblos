{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["A Psalm. Of David."]},{"type":"verse","number":1,"content":[{"text":"The Lord takes care of me as his sheep; I will not be without any good thing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He makes a resting-place for me in the green fields: he is my guide by the quiet waters.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He gives new life to my soul: he is my guide in the ways of righteousness because of his name.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yes, though I go through the valley of deep shade, I will have no fear of evil; for you are with me, your rod and your support are my comfort.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"You make ready a table for me in front of my haters: you put oil on my head; my cup is overflowing.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Truly, blessing and mercy will be with me all the days of my life; and I will have a place in the house of the Lord all my days.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}