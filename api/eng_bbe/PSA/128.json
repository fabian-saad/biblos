{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["A Song of the going up."]},{"type":"verse","number":1,"content":[{"text":"Happy is the worshipper of the Lord, who is walking in his ways.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"You will have the fruit of the work of your hands: happy will you be, and all will be well for you.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Your wife will be like a fertile vine in the inmost parts of your house: your children will be like olive plants round your table.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"See! this is the blessing of the worshipper of the Lord.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"May the Lord send you blessing out of Zion: may you see the good of Jerusalem all the days of your life.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"May you see your children's children. Peace be on Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}