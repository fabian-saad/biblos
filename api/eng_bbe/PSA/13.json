{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["To the chief music-maker. A Psalm. Of David."]},{"type":"verse","number":1,"content":[{"text":"Will you for ever put me out of your memory, O Lord? will your face for ever be turned away from me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long is my soul to be in doubt, with sorrow in my heart all the day? how long will he who is against me be given power over me?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let my voice come before you, and give me an answer, O Lord my God; let your light be shining on me, so that the sleep of death may not overtake me;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"And he who is against me may not say, I have overcome him; and those who are troubling me may not be glad when I am moved.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I have had faith in your mercy; my heart will be glad in your salvation.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I will make a song to the Lord, because he has given me my reward.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}