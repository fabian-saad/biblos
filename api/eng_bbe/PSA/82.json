{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["A Psalm. Of Asaph."]},{"type":"verse","number":1,"content":[{"text":"God is in the meeting-place of God; he is judging among the gods.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"How long will you go on judging falsely, having respect for the persons of evil-doers? (Selah.)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Give ear to the cause of the poor and the children without fathers; let those who are troubled and in need have their rights.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Be the saviour of the poor and those who have nothing: take them out of the hand of the evil-doers.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"They have no knowledge or sense; they go about in the dark: all the bases of the earth are moved.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I said, You are gods; all of you are the sons of the Most High:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"But you will come to death like men, falling like one of the rulers of the earth.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Up! O God, come as judge of the earth; for all the nations are your heritage.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}