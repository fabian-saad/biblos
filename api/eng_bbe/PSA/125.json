{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["A Song of the going up."]},{"type":"verse","number":1,"content":[{"text":"Those whose hope is in the Lord are like the mountain of Zion, which may not be moved, but keeps its place for ever.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"As the mountains are round about Jerusalem, so the Lord is round about his people, from this time and for ever.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"For the rod of sinners will not be resting on the heritage of the upright; so that the upright may not put out their hands to evil.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Do good, O Lord, to those who are good, and to those who are upright in heart.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But as for such as are turned out of the straight way, the Lord will take them away with the workers of evil. Let peace be on Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}