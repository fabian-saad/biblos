{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["A Song of the going up."]},{"type":"verse","number":1,"content":[{"text":"My eyes are lifted up to the hills: O where will my help come from?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Your help comes from the Lord, who made heaven and earth.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"May he not let your foot be moved: no need of sleep has he who keeps you.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"See, the eyes of Israel's keeper will not be shut in sleep.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"The Lord is your keeper; the Lord is your shade on your right hand.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"You will not be touched by the sun in the day, or by the moon at night.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"The Lord will keep you safe from all evil; he will take care of your soul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"The Lord will keep watch over your going out and your coming in, from this time and for ever.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}