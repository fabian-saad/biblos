{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel came out of Egypt, the children of Jacob from a people whose language was strange to them;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Judah became his holy place, and Israel his kingdom.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The sea saw it, and went in flight; Jordan was turned back.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"The mountains were jumping like goats, and the little hills like lambs.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"What was wrong with you, O sea, that you went in flight? O Jordan, that you were turned back?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"You mountains, why were you jumping like goats, and you little hills like lambs?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Be troubled, O earth, before the Lord, before the God of Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Who made the rock into a water-spring, and the hard stone into a fountain.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}