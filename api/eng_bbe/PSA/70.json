{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["To the chief music-maker. Of David. To keep in memory."]},{"type":"verse","number":1,"content":[{"text":"Let your salvation come quickly, O God; come quickly to my help, O Lord.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Let those who go after my soul have shame and trouble; let those who have evil designs against me be turned back and made foolish.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Let those who say Aha, aha! be turned back as a reward of their shame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let all those who are looking for you be glad and have joy in you; let the lovers of your salvation ever say, May God be great.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"But I am poor and in need; come to me quickly, O God; you are my help and my saviour; let there be no waiting, O Lord.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}