{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A Song of the going up."]},{"type":"verse","number":1,"content":[{"text":"When the Lord made a change in Zion's fate, we were like men in a dream.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Then our mouths were full of laughing, and our tongues gave a glad cry; they said among the nations, The Lord has done great things for them.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"The Lord has done great things for us; because of which we are glad.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Let our fate be changed, O Lord, like the streams in the South.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Those who put in seed with weeping will get in the grain with cries of joy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Though a man may go out weeping, taking his vessel of seed with him; he will come again in joy, with the corded stems of grain in his arms.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}