{"translation":{"id":"eng_bbe","name":"Bible in Basic English","website":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engBBE","licenseNotes":null,"shortName":"BBE","englishName":"Bible in Basic English","language":"eng","textDirection":"ltr","sha256":"29c2e7aba14b9061dc9c2d4bfeebcbfb3765f535a1854652626aee9e2f0fa965","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_bbe/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_bbe","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b457bba2b3b78b555e161af5247604e010fd923a9e69bb959fc8ab5fca486059","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_bbe/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_bbe/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A Song of the going up. Of Solomon."]},{"type":"verse","number":1,"content":[{"text":"If the Lord is not helping the builders, then the building of a house is to no purpose: if the Lord does not keep the town, the watchman keeps his watch for nothing.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"It is of no use for you to get up early, and to go late to your rest, with the bread of sorrow for your food; for the Lord gives to his loved ones in sleep.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"See, sons are a heritage from the Lord; the fruit of the body is his reward.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Like arrows in the hand of a man of war, are the children of the young.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Happy is the man who has a good store of them; he will not be put to shame, but his cause will be supported by them against his haters.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_bbe/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_bbe/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_bbe/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}