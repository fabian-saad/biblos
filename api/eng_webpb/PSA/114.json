{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt,","poem":1},{"text":"the house of Jacob from a people of foreign language,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judah became his sanctuary,","poem":1},{"text":"Israel his dominion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The sea saw it, and fled.","poem":1},{"text":"The Jordan was driven back.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The mountains skipped like rams,","poem":1},{"text":"the little hills like lambs.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"What was it, you sea, that you fled?","poem":1},{"text":"You Jordan, that you turned back?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You mountains, that you skipped like rams?","poem":1},{"text":"You little hills, like lambs?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, you earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"who turned the rock into a pool of water,","poem":1},{"text":"the flint into a spring of waters.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}