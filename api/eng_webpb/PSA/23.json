il.","poem":1},{"text":"My cup runs over.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Surely goodness and loving kindness shall follow me all the days of my life,","poem":1},{"text":"and I will dwell in the LORD’s house forever.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}