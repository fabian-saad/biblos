{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the LORD!","poem":1},{"noteId":62},{"text":"Praise, you servants of the LORD,","poem":2},{"noteId":63},{"lineBreak":true},{"text":"praise the LORD’s name.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Blessed be the LORD’s name,","poem":1},{"text":"from this time forward and forever more.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"From the rising of the sun to its going down,","poem":1},{"text":"the LORD’s name is to be praised.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is high above all nations,","poem":1},{"text":"his glory above the heavens.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Who is like the LORD, our God,","poem":1},{"text":"who has his seat on high,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"who stoops down to see in heaven and in the earth?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He raises up the poor out of the dust,","poem":1},{"text":"and lifts up the needy from the ash heap,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that he may set him with princes,","poem":1},{"text":"even with the princes of his people.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother of children.","poem":2},{"text":"Praise the LORD!","poem":1},{"noteId":64}]}],"footnotes":[{"noteId":62,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":1}},{"noteId":63,"caller":"+","text":"LORD or GOD in all caps is from the Hebrew יהוה‎ Yahweh except when otherwise noted as being from the short form יה Yah.","reference":{"chapter":113,"verse":1}},{"noteId":64,"caller":"+","text":"Hebrew: יה Yah","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/eng_webpb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}