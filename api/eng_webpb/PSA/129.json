{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"Many times they have afflicted me from my youth up.","poem":1},{"text":"Let Israel now say:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"many times they have afflicted me from my youth up,","poem":1},{"text":"yet they have not prevailed against me.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The ploughers ploughed on my back.","poem":1},{"text":"They made their furrows long.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD is righteous.","poem":1},{"text":"He has cut apart the cords of the wicked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Let them be disappointed and turned backward,","poem":1},{"text":"all those who hate Zion.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let them be as the grass on the housetops,","poem":1},{"text":"which withers before it grows up,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"with which the reaper doesn’t fill his hand,","poem":1},{"text":"nor he who binds sheaves, his bosom.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neither do those who go by say,","poem":1},{"text":"“The blessing of the LORD be on you.","poem":2},{"lineBreak":true},{"text":"We bless you in the LORD’s name.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}