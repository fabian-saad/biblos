{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By the sons of Korah. According to Alamoth.",{"noteId":19}]},{"type":"verse","number":1,"content":[{"text":"God is our refuge and strength,","poem":1},{"text":"a very present help in trouble.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Therefore we won’t be afraid, though the earth changes,","poem":1},{"text":"though the mountains are shaken into the heart of the seas;","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"though its waters roar and are troubled,","poem":2},{"lineBreak":true},{"text":"though the mountains tremble with their swelling. Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"There is a river, the streams of which make the city of God glad,","poem":1},{"text":"the holy place of the tents of the Most High.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God is within her. She shall not be moved.","poem":1},{"text":"God will help her at dawn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The nations raged. The kingdoms were moved.","poem":1},{"text":"He lifted his voice and the earth melted.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The LORD of Armies is with us.","poem":1},{"text":"The God of Jacob is our refuge. Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Come, see the LORD’s works,","poem":1},{"text":"what desolations he has made in the earth.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He makes wars cease to the end of the earth.","poem":1},{"text":"He breaks the bow, and shatters the spear.","poem":2},{"lineBreak":true},{"text":"He burns the chariots in the fire.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Be still, and know that I am God.","poem":1},{"text":"I will be exalted amongst the nations.","poem":2},{"lineBreak":true},{"text":"I will be exalted in the earth.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"The LORD of Armies is with us.","poem":1},{"text":"The God of Jacob is our refuge. Selah.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":19,"caller":"+","text":"Alamoth is a musical term.","reference":{"chapter":46,"verse":0}}]},"thisChapterLink":"/api/eng_webpb/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}