{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["A Psalm by the sons of Korah; a Song."]},{"type":"verse","number":1,"content":[{"text":"His foundation is in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"The LORD loves the gates of Zion more than all the dwellings of Jacob.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Glorious things are spoken about you, city of God. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will record Rahab","poem":1},{"noteId":33},{"text":"and Babylon amongst those who acknowledge me.","poem":1},{"text":"Behold, Philistia, Tyre, and also Ethiopia:","poem":2},{"lineBreak":true},{"text":"“This one was born there.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yes, of Zion it will be said, “This one and that one was born in her;”","poem":1},{"text":"the Most High himself will establish her.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The LORD will count, when he writes up the peoples,","poem":1},{"text":"“This one was born there.” Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Those who sing as well as those who dance say,","poem":1},{"text":"“All my springs are in you.”","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"Rahab is a reference to Egypt.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/eng_webpb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}