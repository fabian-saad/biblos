{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"Blessed is everyone who fears the LORD,","poem":1},{"text":"who walks in his ways.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For you will eat the labour of your hands.","poem":1},{"text":"You will be happy, and it will be well with you.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Your wife will be as a fruitful vine in the innermost parts of your house,","poem":1},{"text":"your children like olive shoots around your table.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Behold, this is how the man who fears the LORD is blessed.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"May the LORD bless you out of Zion,","poem":2},{"lineBreak":true},{"text":"and may you see the good of Jerusalem all the days of your life.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yes, may you see your children’s children.","poem":1},{"text":"Peace be upon Israel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}