{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. For a stringed instrument. By David."]},{"type":"verse","number":1,"content":[{"text":"Hear my cry, God.","poem":1},{"text":"Listen to my prayer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"From the end of the earth, I will call to you when my heart is overwhelmed.","poem":1},{"text":"Lead me to the rock that is higher than I.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For you have been a refuge for me,","poem":1},{"text":"a strong tower from the enemy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I will dwell in your tent forever.","poem":1},{"text":"I will take refuge in the shelter of your wings. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For you, God, have heard my vows.","poem":1},{"text":"You have given me the heritage of those who fear your name.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You will prolong the king’s life.","poem":1},{"text":"His years will be for generations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He shall be enthroned in God’s presence forever.","poem":1},{"text":"Appoint your loving kindness and truth, that they may preserve him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"So I will sing praise to your name forever,","poem":1},{"text":"that I may fulfil my vows daily.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}