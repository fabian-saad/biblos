{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By David. A reminder."]},{"type":"verse","number":1,"content":[{"text":"Hurry, God, to deliver me.","poem":1},{"text":"Come quickly to help me, LORD.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Let them be disappointed and confounded who seek my soul.","poem":1},{"text":"Let those who desire my ruin be turned back in disgrace.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Let them be turned because of their shame","poem":1},{"text":"who say, “Aha! Aha!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Let all those who seek you rejoice and be glad in you.","poem":1},{"text":"Let those who love your salvation continually say,","poem":2},{"lineBreak":true},{"text":"“Let God be exalted!”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"But I am poor and needy.","poem":1},{"text":"Come to me quickly, God.","poem":2},{"text":"You are my help and my deliverer.","poem":1},{"text":"LORD, don’t delay.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}