{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By Solomon."]},{"type":"verse","number":1,"content":[{"text":"Unless the LORD builds the house,","poem":1},{"text":"they who build it labour in vain.","poem":2},{"text":"Unless the LORD watches over the city,","poem":1},{"text":"the watchman guards it in vain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"It is vain for you to rise up early,","poem":1},{"text":"to stay up late,","poem":2},{"lineBreak":true},{"text":"eating the bread of toil,","poem":2},{"lineBreak":true},{"text":"for he gives sleep to his loved ones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Behold, children are a heritage of the LORD.","poem":1},{"text":"The fruit of the womb is his reward.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"As arrows in the hand of a mighty man,","poem":1},{"text":"so are the children of youth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is the man who has his quiver full of them.","poem":1},{"text":"They won’t be disappointed when they speak with their enemies in the gate.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}