{"translation":{"id":"eng_webpb","name":"World English Bible British Edition","website":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebpb","licenseNotes":null,"shortName":"WEBBE","englishName":"World English Bible British Edition","language":"eng","textDirection":"ltr","sha256":"4388247437871291d10e33f468e8530a979d87be1ffb4c789926c1e27e75278b","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_webpb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_webpb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"b6671007d2df1316b835ef2d1f47da94bbee90dd74e581715e3d110721295632","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_webpb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_webpb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By David."]},{"type":"verse","number":1,"content":[{"text":"If it had not been the LORD who was on our side,","poem":1},{"text":"let Israel now say,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"if it had not been the LORD who was on our side,","poem":1},{"text":"when men rose up against us,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"then they would have swallowed us up alive,","poem":1},{"text":"when their wrath was kindled against us,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"then the waters would have overwhelmed us,","poem":1},{"text":"the stream would have gone over our soul.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Then the proud waters would have gone over our soul.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Blessed be the LORD,","poem":1},{"text":"who has not given us as a prey to their teeth.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Our soul has escaped like a bird out of the fowler’s snare.","poem":1},{"text":"The snare is broken, and we have escaped.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Our help is in the LORD’s name,","poem":1},{"text":"who made heaven and earth.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_webpb/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_webpb/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_webpb/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}