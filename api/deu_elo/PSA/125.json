{"translation":{"id":"deu_elo","name":"Darby Unrevidierte Elberfelder","website":"https://ebible.org/Scriptures/details.php?id=deuelo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelo","licenseNotes":null,"shortName":"ELO","englishName":"German Unrevised Elberfelder Bible","language":"deu","textDirection":"ltr","sha256":"c2cdc48b475657f15833dba3b7eeb3683089798b4e4307579b82c97a4899c3a6","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elo/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elo","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"9a322705bcac16bda244127a220210e70629ff0dcad0ff65abb4127c3c176533","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elo/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elo/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":["Ein Stufenlied. Die auf Jehova vertrauen, sind gleich dem Berge Zion, der nicht wankt, der ewiglich bleibt."]},{"type":"verse","number":2,"content":["Jerusalem, Berge sind rings um sie her: so ist Jehova rings um sein Volk, von nun an bis in Ewigkeit."]},{"type":"verse","number":3,"content":["Denn die Rute der Gesetzlosigkeit wird auf dem Lose der Gerechten nicht ruhen, damit die Gerechten ihre Hände nicht ausstrecken nach Unrecht."]},{"type":"verse","number":4,"content":["Tue Gutes, Jehova, den Guten und denen, die aufrichtig sind in ihren Herzen!"]},{"type":"verse","number":5,"content":["Die aber auf ihre krummen Wege abbiegen, die wird Jehova dahinfahren lassen mit denen, welche Frevel tun. Wohlfahrt über Israel!"]}],"footnotes":[]},"thisChapterLink":"/api/deu_elo/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elo/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/a