as, der Himmel und Erde gemacht hat."]}],"footnotes":[]},"thisChapterLink":"/api/deu_elo/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elo/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elo/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}