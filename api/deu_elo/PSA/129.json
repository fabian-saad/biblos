{"translation":{"id":"deu_elo","name":"Darby Unrevidierte Elberfelder","website":"https://ebible.org/Scriptures/details.php?id=deuelo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=deuelo","licenseNotes":null,"shortName":"ELO","englishName":"German Unrevised Elberfelder Bible","language":"deu","textDirection":"ltr","sha256":"c2cdc48b475657f15833dba3b7eeb3683089798b4e4307579b82c97a4899c3a6","availableFormats":["json"],"listOfBooksApiLink":"/api/deu_elo/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Deutsch","languageEnglishName":"German"},"book":{"id":"PSA","translationId":"deu_elo","name":"Psalmen","commonName":"Psalmen","title":"Die Psalmen","order":19,"numberOfChapters":150,"sha256":"9a322705bcac16bda244127a220210e70629ff0dcad0ff65abb4127c3c176533","firstChapterNumber":1,"firstChapterApiLink":"/api/deu_elo/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/deu_elo/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":["Ein Stufenlied. Oftmals haben sie mich bedrängt von meiner Jugend an, sage doch Israel,"]},{"type":"verse","number":2,"content":["oftmals haben sie mich bedrängt von meiner Jugend an; dennoch haben sie mich nicht übermocht."]},{"type":"verse","number":3,"content":["Pflüger haben auf meinem Rücken gepflügt, haben lang gezogen ihre Furchen."]},{"type":"verse","number":4,"content":["Jehova ist gerecht; er hat durchschnitten das Seil der Gesetzlosen."]},{"type":"verse","number":5,"content":["Mögen beschämt werden und zurückweichen alle, die Zion hassen!"]},{"type":"verse","number":6,"content":["Mögen sie sein wie das Gras der Dächer, welches verdorrt, ehe man es ausrauft,"]},{"type":"verse","number":7,"content":["womit der Schnitter seine Hand nicht füllt, noch der Garbenbinder seinen Schoß;"]},{"type":"verse","number":8,"content":["und die Vorübergehenden sagen nicht: Jehovas Segen über euch! Wir segnen euch im Namen Jehovas."]}],"footnotes":[]},"thisChapterLink":"/api/deu_elo/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elo/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elo/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}