elo/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elo/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elo/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}