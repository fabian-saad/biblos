elo/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/deu_elo/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/deu_elo/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}