{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"The LORD reigns! Let the peoples tremble.","poem":1},{"text":"He sits enthroned among the cherubim.","poem":2},{"lineBreak":true},{"text":"Let the earth be moved.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD is great in Zion.","poem":1},{"text":"He is high above all the peoples.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Let them praise your great and awesome name.","poem":1},{"text":"He is Holy!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The King’s strength also loves justice.","poem":1},{"text":"You establish equity.","poem":2},{"lineBreak":true},{"text":"You execute justice and righteousness in Jacob.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Exalt the LORD our God.","poem":1},{"text":"Worship at his footstool.","poem":2},{"lineBreak":true},{"text":"He is Holy!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moses and Aaron were among his priests,","poem":1},{"text":"Samuel was among those who call on his name.","poem":2},{"lineBreak":true},{"text":"They called on the LORD, and he answered them.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He spoke to them in the pillar of cloud.","poem":1},{"text":"They kept his testimonies,","poem":2},{"lineBreak":true},{"text":"the statute that he gave them.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"You answered them, LORD our God.","poem":1},{"text":"You are a God who forgave them,","poem":2},{"lineBreak":true},{"text":"although you took vengeance for their doings.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Exalt the LORD, our God.","poem":1},{"text":"Worship at his holy hill,","poem":2},{"lineBreak":true},{"text":"for the LORD, our God, is holy!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}