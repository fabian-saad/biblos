{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["A Psalm."]},{"type":"verse","number":1,"content":[{"text":"Sing to the LORD a new song,","poem":1},{"text":"for he has done marvelous things!","poem":2},{"lineBreak":true},{"text":"His right hand and his holy arm have worked salvation for him.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD has made known his salvation.","poem":1},{"text":"He has openly shown his righteousness in the sight of the nations.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He has remembered his loving kindness and his faithfulness toward the house of Israel.","poem":1},{"text":"All the ends of the earth have seen the salvation of our God.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Make a joyful noise to the LORD, all the earth!","poem":1},{"text":"Burst out and sing for joy, yes, sing praises!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sing praises to the LORD with the harp,","poem":1},{"text":"with the harp and the voice of melody.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With shofars","poem":1},{"noteId":35},{"text":"and sound of the ram’s horn,","poem":1},{"text":"make a joyful noise before the King, the LORD.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Let the sea roar with its fullness;","poem":1},{"text":"the world, and those who dwell therein.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Let the rivers clap their hands.","poem":1},{"text":"Let the mountains sing for joy together.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Let them sing before the LORD,","poem":1},{"text":"for he comes to judge the earth.","poem":2},{"text":"He will judge the world with righteousness,","poem":1},{"text":"and the peoples with equity.","poem":2}]}],"footnotes":[{"noteId":35,"caller":"+","text":"or, trumpets","reference":{"chapter":98,"verse":6}}]},"thisChapterLink":"/api/eng_wmb/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}