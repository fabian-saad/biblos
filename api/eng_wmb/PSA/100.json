ness to all generations.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}