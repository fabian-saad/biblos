{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By David."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said to me,","poem":1},{"text":"“Let’s go to the LORD’s house!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Our feet are standing within your gates, Jerusalem!","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Jerusalem is built as a city that is compact together,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"where the tribes go up, even the LORD’s tribes,","poem":1},{"text":"according to an ordinance for Israel,","poem":2},{"lineBreak":true},{"text":"to give thanks to the LORD’s name.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For there are set thrones for judgment,","poem":1},{"text":"the thrones of David’s house.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pray for the peace of Jerusalem.","poem":1},{"text":"Those who love you will prosper.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peace be within your walls,","poem":1},{"text":"and prosperity within your palaces.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For my brothers’ and companions’ sakes,","poem":1},{"text":"I will now say, “Peace be within you.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For the sake of the house of the LORD our God,","poem":1},{"text":"I will seek your good.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}