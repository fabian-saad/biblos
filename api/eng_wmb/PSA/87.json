{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["A Psalm by the sons of Korah; a Song."]},{"type":"verse","number":1,"content":[{"text":"His foundation is in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"The LORD loves the gates of Zion more than all the dwellings of Jacob.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Glorious things are spoken about you, city of God. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will record Rahab","poem":1},{"noteId":28},{"text":"and Babylon among those who acknowledge me.","poem":1},{"text":"Behold, Philistia, Tyre, and also Ethiopia:","poem":2},{"lineBreak":true},{"text":"“This one was born there.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yes, of Zion it will be said, “This one and that one was born in her;”","poem":1},{"text":"the Most High himself will establish her.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The LORD will count, when he writes up the peoples,","poem":1},{"text":"“This one was born there.” Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Those who sing as well as those who dance say,","poem":1},{"text":"“All my springs are in you.”","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Rahab is a reference to Egypt.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/eng_wmb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}