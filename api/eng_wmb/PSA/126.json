{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"When the LORD brought back those who returned to Zion,","poem":1},{"text":"we were like those who dream.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Then our mouth was filled with laughter,","poem":1},{"text":"and our tongue with singing.","poem":2},{"text":"Then they said among the nations,","poem":1},{"text":"“The LORD has done great things for them.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The LORD has done great things for us,","poem":1},{"text":"and we are glad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Restore our fortunes again, LORD,","poem":1},{"text":"like the streams in the Negev.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Those who sow in tears will reap in joy.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"He who goes out weeping, carrying seed for sowing,","poem":2},{"lineBreak":true},{"text":"will certainly come again with joy, carrying his sheaves.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}