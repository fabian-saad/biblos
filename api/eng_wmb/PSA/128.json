n.","poem":1},{"text":"Peace be upon Israel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}