{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Praise the LORD!","poem":1},{"text":"Praise the LORD, my soul.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"While I live, I will praise the LORD.","poem":1},{"text":"I will sing praises to my God as long as I exist.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Don’t put your trust in princes,","poem":1},{"text":"in a son of man in whom there is no help.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"His spirit departs, and he returns to the earth.","poem":1},{"text":"In that very day, his thoughts perish.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is he who has the God of Jacob for his help,","poem":1},{"text":"whose hope is in the LORD, his God,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"who made heaven and earth,","poem":1},{"text":"the sea, and all that is in them;","poem":2},{"lineBreak":true},{"text":"who keeps truth forever;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"who executes justice for the oppressed;","poem":1},{"text":"who gives food to the hungry.","poem":2},{"text":"The LORD frees the prisoners.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"The LORD opens the eyes of the blind.","poem":2},{"lineBreak":true},{"text":"The LORD raises up those who are bowed down.","poem":2},{"lineBreak":true},{"text":"The LORD loves the righteous.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The LORD preserves the foreigners.","poem":1},{"text":"He upholds the fatherless and widow,","poem":2},{"lineBreak":true},{"text":"but he turns the way of the wicked upside down.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The LORD will reign forever;","poem":1},{"text":"your God, O Zion, to all generations.","poem":2},{"text":"Praise the LORD!","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}