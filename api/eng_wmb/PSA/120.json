{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"In my distress, I cried to the LORD.","poem":1},{"text":"He answered me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Deliver my soul, LORD, from lying lips,","poem":1},{"text":"from a deceitful tongue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"What will be given to you, and what will be done more to you,","poem":1},{"text":"you deceitful tongue?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sharp arrows of the mighty,","poem":1},{"text":"with coals of juniper.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woe is me, that I live in Meshech,","poem":1},{"text":"that I dwell among the tents of Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul has had her dwelling too long","poem":1},{"text":"with him who hates peace.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I am for peace,","poem":1},{"text":"but when I speak, they are for war.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}