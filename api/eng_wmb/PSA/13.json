r loving kindness.","poem":1},{"text":"My heart rejoices in your salvation.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will sing to the LORD,","poem":1},{"text":"because he has been good to me.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}