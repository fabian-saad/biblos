{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt,","poem":1},{"text":"the house of Jacob from a people of foreign language,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judah became his sanctuary,","poem":1},{"text":"Israel his dominion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The sea saw it, and fled.","poem":1},{"text":"The Jordan was driven back.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The mountains skipped like rams,","poem":1},{"text":"the little hills like lambs.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"What was it, you sea, that you fled?","poem":1},{"text":"You Jordan, that you turned back?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You mountains, that you skipped like rams?","poem":1},{"text":"You little hills, like lambs?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, you earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"who turned the rock into a pool of water,","poem":1},{"text":"the flint into a spring of waters.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}