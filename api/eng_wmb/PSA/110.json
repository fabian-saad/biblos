{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"The LORD says to my Lord, “Sit at my right hand,","poem":1},{"text":"until I make your enemies your footstool for your feet.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD will send out the rod of your strength out of Zion.","poem":1},{"text":"Rule among your enemies.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Your people offer themselves willingly in the day of your power, in holy array.","poem":1},{"text":"Out of the womb of the morning, you have the dew of your youth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD has sworn, and will not change his mind:","poem":1},{"text":"“You are a priest forever in the order of Melchizedek.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The Lord is at your right hand.","poem":1},{"text":"He will crush kings in the day of his wrath.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He will judge among the nations.","poem":1},{"text":"He will heap up dead bodies.","poem":2},{"lineBreak":true},{"text":"He will crush the ruler of the whole earth.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He will drink of the brook on the way;","poem":1},{"text":"therefore he will lift up his head.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}