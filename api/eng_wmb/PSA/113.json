t of the dust,","poem":1},{"text":"and lifts up the needy from the ash heap,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that he may set him with princes,","poem":1},{"text":"even with the princes of his people.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother of children.","poem":2},{"text":"Praise the LORD!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}