{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Blessed is the man who doesn’t walk in the counsel of the wicked,","poem":1},{"text":"nor stand on the path of sinners,","poem":2},{"lineBreak":true},{"text":"nor sit in the seat of scoffers;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"but his delight is in the LORD’s","poem":1},{"noteId":0},{"text":"law.","poem":1},{"text":"On his Torah he meditates day and night.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He will be like a tree planted by the streams of water,","poem":1},{"text":"that produces its fruit in its season,","poem":2},{"lineBreak":true},{"text":"whose leaf also does not wither.","poem":2},{"lineBreak":true},{"text":"Whatever he does shall prosper.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The wicked are not so,","poem":1},{"text":"but are like the chaff which the wind drives away.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Therefore the wicked shall not stand in the judgment,","poem":1},{"text":"nor sinners in the congregation of the righteous.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"For the LORD knows the way of the righteous,","poem":1},{"text":"but the way of the wicked shall perish.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"When rendered in ALL CAPITAL LETTERS, “LORD” or “GOD” is the translation of God’s Proper Name.","reference":{"chapter":1,"verse":2}}]},"thisChapterLink":"/api/eng_wmb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}