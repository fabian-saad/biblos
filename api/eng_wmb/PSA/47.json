{"translation":{"id":"eng_wmb","name":"World Messianic Bible","website":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwmb","licenseNotes":null,"shortName":"WMB","englishName":"World Messianic Bible","language":"eng","textDirection":"ltr","sha256":"d071680ca23805dc9f476809bef66399297b4c95e26bf1f186020564492b5b77","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_wmb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_wmb","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"2d20163d45682f19be7a926e53ff19274e486c5fb2e02c71f82960034bbaa2e8","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_wmb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_wmb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. A Psalm by the sons of Korah."]},{"type":"verse","number":1,"content":[{"text":"Oh clap your hands, all you nations.","poem":1},{"text":"Shout to God with the voice of triumph!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For the LORD Most High is awesome.","poem":1},{"text":"He is a great King over all the earth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He subdues nations under us,","poem":1},{"text":"and peoples under our feet.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He chooses our inheritance for us,","poem":1},{"text":"the glory of Jacob whom he loved. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God has gone up with a shout,","poem":1},{"text":"the LORD with the sound of a shofar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sing praises to God! Sing praises!","poem":1},{"text":"Sing praises to our King! Sing praises!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For God is the King of all the earth.","poem":1},{"text":"Sing praises with understanding.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"God reigns over the nations.","poem":1},{"text":"God sits on his holy throne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The princes of the peoples are gathered together,","poem":1},{"lineBreak":true},{"text":"the people of the God of Abraham.","poem":1},{"text":"For the shields of the earth belong to God.","poem":2},{"lineBreak":true},{"text":"He is greatly exalted!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_wmb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_wmb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_wmb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}